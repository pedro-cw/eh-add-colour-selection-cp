<script>
(function () {
  var cutAmount = 90;

  function cropLooxButton() {
    var wrapper = document.querySelector('#looxReviews');
    var iframe = document.querySelector('#looxReviewsFrame');

    if (!wrapper || !iframe) return;

    var iframeHeight =
      parseInt(iframe.getAttribute('height'), 10) ||
      parseInt(iframe.style.height, 10) ||
      parseInt(wrapper.style.height, 10);

    if (!iframeHeight || iframeHeight <= cutAmount) return;

    wrapper.style.setProperty('overflow', 'hidden', 'important');
    wrapper.style.setProperty('height', iframeHeight - cutAmount + 'px', 'important');

    iframe.style.setProperty('height', iframeHeight + 'px', 'important');
    iframe.style.setProperty('width', '100%', 'important');
  }

  cropLooxButton();

  document.addEventListener('DOMContentLoaded', cropLooxButton);
  window.addEventListener('load', cropLooxButton);

  setInterval(cropLooxButton, 500);

  var observer = new MutationObserver(cropLooxButton);

  observer.observe(document.documentElement, {
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: ['style', 'height']
  });
})();
</script>
  </body>
