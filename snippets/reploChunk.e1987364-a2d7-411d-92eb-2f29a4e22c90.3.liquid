f-da8fdd7f1a6f?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/41d85b8d-ebfb-407c-b675-8dc1520eb9f1/5941f3de-db4c-453d-834f-da8fdd7f1a6f" class="r-6g9eia" loading="lazy"/></picture><div data-rid="64bd34fd-d7d0-457e-a167-aa203f0c73cb" class="r-1t975oi"><div data-rid="aeabf735-0b59-4e2d-aab3-ee650e3bb6a9" class="r-evw7sr alchemy-rte"><span style="width:100%"><p>4</p></span></div></div></div><div data-rid="c97fdec0-2987-4c80-9bf8-5780e3e34123" class="r-sok787"><div data-rid="30e48888-665a-4e2c-9cc2-f6a419c785f2" class="r-1xsae3j alchemy-rte"><span style="width:100%"><p>Sculpt & lift</p></span></div><div data-rid="32559703-6eb3-4a2d-9d45-9947489715fa" class="r-zvylwx alchemy-rte"><span style="width:100%"><p>Glide the tool upwards and outwards along the face, jawline, and neck, finishing with gentle downward strokes on the neck to support lymphatic flow and relaxation.</p></span></div></div></div></div></div><div data-rid="09453402-cd70-40bf-8dff-518fcc4bd8ce" class="r-1r5efp"><button data-rid="a596d041-0022-4d46-9ad9-2c46e9e6794a" tabindex="0" role="link" class="text r-iv69wj alchemy-rte"><div data-rid="8db0e079-16b4-434c-8948-949de7dbb40e" class="r-k6cw62 alchemy-rte"><span style="width:100%"><p>shop now</p></span></div></button><div data-rid="6e54780d-f641-48a3-8dcb-3280d6c48404" class="r-1da9imd"><picture data-rid="bcb6f536-34ca-42da-9aa5-3e9848357bcf" class="r-zed8m3"><source srcSet="https://assets.replocdn.com/projects/1d59688c-4fca-4894-8cd3-23dbe64f87b3/36da7481-ff7f-4333-bd40-603332223185?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/1d59688c-4fca-4894-8cd3-23dbe64f87b3/36da7481-ff7f-4333-bd40-603332223185?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/1d59688c-4fca-4894-8cd3-23dbe64f87b3/36da7481-ff7f-4333-bd40-603332223185?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/1d59688c-4fca-4894-8cd3-23dbe64f87b3/36da7481-ff7f-4333-bd40-603332223185" class="r-3oik82" loading="eager"/></picture><div data-rid="7a6a65d8-d90e-4c87-987e-1cb2a14e0516" class="r-t3xsrw alchemy-rte"><span style="width:100%"><p>Rated <strong>4.9/5</strong> by <strong>1000+</strong> Happy Customers</p></span></div></div></div></div></div><div data-rid="4ea5bde2-b3fb-4ad2-aac9-d3e9a73a1ebb" class="r-1soelmo"><div data-rid="84aea82f-d6af-4118-ba4a-a0765b0bad2b" class="r-9hwv2a"><div data-rid="b3808bfc-36f1-4901-819d-dc694c37b06c" class="r-csfinz"><div data-rid="2a99b42a-2a8c-41db-87d9-cc8d3bb1c3d6" class="r-3c6spk alchemy-rte"><span style="width:100%"><h2>Frequently Asked Questions</h2></span></div><div data-rid="ecf97f70-81a7-46e8-925e-5aed0f9186bd" class="r-1muak5n" data-orientation="vertical"><div data-rid="399e5e41-ed43-4bfa-8ea4-d303620b9093" class="r-2lfz48" data-replo-collapsible="true" data-state="open" data-orientation="vertical"><div data-rid="5ad7b579-73ec-490f-a590-013c83e0e647" aria-expanded="true" aria-controls="replo-:R6r32:" tabindex="0" role="button" class="r-1c6slsa r-3zdtfb"><div data-rid="2145adcb-c42a-43ac-ba5d-068663b496df" class="r-sjhk05 alchemy-rte"><span style="width:100%"><p>What makes the East Healing Gua Sha different?</p></span></div><div data-rid="e582cfd5-8398-417c-98d3-0794dd6688d4" class="r-ehsc8" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-7j2a7i" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.646 4.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1-.708.708L8 5.707l-5.646 5.647a.5.5 0 0 1-.708-.708z"></path></svg></div></div><div class="replo-animated" id="replo-:R6r32:"><div data-rid="853d4f72-2c94-4e7b-9dce-f48a209f3b3b" class="r-1qlhoeg"><div data-rid="ada072a3-eb75-4b4c-9671-b6b94ba4d731" class="r-1d1nnh6 alchemy-rte"><span style="width:100%"><p>Our Gua Sha is hand-carved from authentic Bian Stone — one of China’s oldest healing materials, rich in over 40 trace minerals. Designed with Ms. Yuan, a gua sha expert from Shanghai, it follows true Traditional Chinese Medicine techniques for deeper, longer-lasting results.</p></span></div></div></div></div><div data-rid="a01ba82c-7ab5-4a6f-a7b6-59936b5bc03d" class="r-hu9mee" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="2b9260a2-16f6-43c6-bb49-fb520d7d9732" aria-expanded="false" aria-controls="replo-:Rar32:" tabindex="0" role="button" class="r-x874nw"><div data-rid="511d5632-0bc7-41f7-930b-a0b58777f3dc" class="r-wbsqo5 alchemy-rte"><span style="width:100%"><p>What are the benefits of using a Bian Stone Gua Sha?</p></span></div><div data-rid="aa29254b-ee88-4713-8f8e-1322e58ce38f" class="r-um0cup" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-17k4ok1" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rar32:"><div data-rid="83d66466-9ce1-4bc0-81f5-3c6b241e3c00" class="r-ogiawa"><div data-rid="00991e1c-0c3d-42d0-bcfa-b7c4cb89be5a" class="r-1rhygjn alchemy-rte"><span style="width:100%"><p>It helps to boost circulation, move Qi, and release facial tension, while supporting lymphatic drainage and reducing puffiness. Regular use promotes lifted, brighter, and naturally balanced skin.</p></span></div></div></div></div><div data-rid="dda41fa3-85a1-4bf2-a673-fc2a471a6cd0" class="r-grog4e" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="e028cb25-b965-4bdb-bc4d-20c6a5dec852" aria-expanded="false" aria-controls="replo-:Rer32:" tabindex="0" role="button" class="r-1qv6trj"><div data-rid="64ab026c-2800-402e-9d83-35d6bb4212d0" class="r-scorst alchemy-rte"><span style="width:100%"><p>Can I heat my Gua Sha tool?</p></span></div><div data-rid="ed36d770-c3dc-4d77-ae4e-163085aa5a5f" class="r-er4jp6" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1p9ojo2" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rer32:"><div data-rid="ec7dd6f3-5c69-42a1-9f5d-14f672341001" class="r-1k9vr4k"><div data-rid="3e316ac5-26b4-4de5-bab2-1661e7fd6322" class="r-fvd5o2 alchemy-rte"><span style="width:100%"><p>Yes — Bian Stone conducts and retains heat beautifully. Soaking it briefly in warm (not boiling) water opens pores, increases blood flow, and enhances the glow and relaxation benefits of your ritual.</p></span></div></div></div></div><div data-rid="08d45cc7-cac4-42a0-b5dd-31f5176b30b6" class="r-arirqv" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="690a604b-0c7b-429a-b208-4cc8b63a6391" aria-expanded="false" aria-controls="replo-:Rir32:" tabindex="0" role="button" class="r-1rga0zy"><div data-rid="a4cb329d-377b-4376-8ec8-cc9cd057c3dd" class="r-z25wjs alchemy-rte"><span style="width:100%"><p>How often should I use it?</p></span></div><div data-rid="ace260fd-23b3-48d3-969a-416474abb1ab" class="r-1356750" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-bq33nk" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rir32:"><div data-rid="51005d9b-5c0c-43e9-8b41-e2494ba2e675" class="r-1hqyik8"><div data-rid="64fb9d24-e4b0-4880-ad96-9b4c16cc5fa8" class="r-13dzvi1 alchemy-rte"><span style="width:100%"><p>We recommend using your Gua Sha at least twice a week, or daily for best results. A 5-minute ritual is enough to stimulate circulation and restore balance to the skin.</p></span></div></div></div></div><div data-rid="c6defe43-bddf-4600-a986-83a57e6e4a8b" class="r-1tv4ulg" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="723a01d3-ae3c-4b5c-a26e-a1511dea811b" aria-expanded="false" aria-controls="replo-:Rmr32:" tabindex="0" role="button" class="r-1r1qjkn"><div data-rid="d24d0ee5-86c8-414a-a72f-32ca35cdf7c4" class="r-1wkbq0t alchemy-rte"><span style="width:100%"><p>How do I use it correctly?</p></span></div><div data-rid="4c44e61c-d6a6-4992-a08f-fa9c4dcc005d" class="r-11n3lbf" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-15kijap" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rmr32:"><div data-rid="1d331da2-b6eb-4327-827a-818ef28935e0" class="r-1pw0npx"><div data-rid="e4df1bd8-68fb-41c4-a326-dc835ae96446" class="r-s6id27 alchemy-rte"><span style="width:100%"><p>Start with a cleansed face and facial oil.</p><br><ol><li><p><strong>Warm the tool</strong> in water.  </p></li><li><p><strong>Activate acupressure points</strong> with the tip for 3 seconds each.  </p></li><li><p><strong>Glide upwards and outwards</strong> — chin to ear, cheek to temple, brow to hairline.  </p></li><li><p><strong>Sweep down the neck</strong> to support lymphatic flow.</p></li></ol></span></div></div></div></div><div data-rid="f17c31f1-f5f0-411f-9230-cbf7de3b6f73" class="r-1fgtign" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="c1932a59-f8a4-4630-958a-555363e56009" aria-expanded="false" aria-controls="replo-:Rqr32:" tabindex="0" role="button" class="r-41tt4c"><div data-rid="0e459aa5-641b-42d6-8d13-e5f5f17841c6" class="r-et2v5v alchemy-rte"><span style="width:100%"><p>How is this tool crafted?</p></span></div><div data-rid="f7eb5f41-5832-45a2-8636-9be5f0c90635" class="r-1f373pz" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1np4u8b" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rqr32:"><div data-rid="d2991b76-1376-47d0-8cef-766f4b8127a7" class="r-4m3kl0"><div data-rid="a71ef221-ec40-4c7f-a04f-7941d20a2c4f" class="r-apclr7 alchemy-rte"><span style="width:100%"><p>Each piece is artisan-carved from sustainably sourced Bian Stone. The natural white “veins” seen on each tool are a hallmark of its authentic origin — no two pieces are ever the same.</p></span></div></div></div></div><div data-rid="53306e37-638c-4823-a33f-ddd7d248cc70" class="r-4dy85v" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="c554cc71-6ed1-4e56-97de-679a99796008" aria-expanded="false" aria-controls="replo-:Rur32:" tabindex="0" role="button" class="r-555hg2"><div data-rid="e7d3e8cc-81ef-4051-9530-9e275f59549a" class="r-vm4xb3 alchemy-rte"><span style="width:100%"><p>Can I use it after injectables or skin treatments?</p></span></div><div data-rid="44e6d914-cf77-402c-a8af-4e3873862d7b" class="r-83o6ks" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-3h4p1m" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rur32:"><div data-rid="597b8872-e8bd-473c-bb4d-9808ec658511" class="r-dp31y1"><div data-rid="6295bcbd-9d09-4852-92d6-1e843013b0a7" class="r-hxnktj alchemy-rte"><span style="width:100%"><p>We recommend waiting at least 4 weeks after Botox, fillers, or other injectables before using Gua Sha on treated areas. Always avoid use on broken or inflamed skin.</p></span></div></div></div></div><div data-rid="31a5799b-55f0-45e5-97ca-c7d7f72e5c6e" class="r-1aj3105" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="35c9eefc-4943-404a-9ef3-d8904d5cb505" aria-expanded="false" aria-controls="replo-:R12r32:" tabindex="0" role="button" class="r-148c45o"><div data-rid="c5e92f95-ceda-4f19-9d56-165dbef3217c" class="r-tt93rx alchemy-rte"><span style="width:100%"><p> Should I keep my Gua Sha in the fridge?</p></span></div><div data-rid="927786c9-2644-4357-9170-97fcfdcf12a6" class="r-1pgim3f" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-17r34tw" height="1em" width="1em" xmlns=