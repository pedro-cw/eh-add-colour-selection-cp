<script>
const test = {
  waitForElement: function (selector, timer = 30000, frequency = 100) {
    return new Promise((resolve, reject) => {
      let element = document.querySelector(selector);
      if (timer <= 0) return reject(`Não achou: ${selector}`);
      if (element) return resolve(element);
      setTimeout(() => {
        this.waitForElement(selector, timer - frequency, frequency).then(resolve).catch(reject);
      }, frequency);
    });
  }
};

document.addEventListener('DOMContentLoaded', function () {
  test.waitForElement('#review-stars').then((btn) => {
    btn.addEventListener('click', function (e) {
      e.preventDefault();

      const target = document.querySelector("#review-sec");
      if (!target) return;

      var win_size = window.innerWidth;
      
      // --- ESSA É A SUA LÓGICA DE CÁLCULO ---
      function calculateScrollDestination() {
        var windowHeight = window.innerHeight / 2;
        var timelineDistance = target.offsetTop; 
        
        // No seu script: line = windowDistance - timelineDistance + windowHeight
        // Para inverter e achar o scrollDistance (windowDistance):
        // scrollDistance = timelineDistance - windowHeight
        
        if (win_size <= 767) {
          // No mobile você usa windowHeight / 2.7
          return timelineDistance - (windowHeight / 2.7);
        } else {
          // No desktop você usa windowHeight puro
          return timelineDistance - 100;
        }
      }

      // Executa o scroll usando a sua matemática de posicionamento
      const destination = calculateScrollDestination();

      window.scrollTo({
        top: destination,
        behavior: 'instant' // Mantendo instant conforme seu teste anterior
      });

      // Se o Loox carregar e empurrar o offsetTop, re-calculamos 
      // para garantir que a lógica da timeline continue batendo
      setTimeout(() => {
        window.scrollTo({
          top: calculateScrollDestination(),
          behavior: 'instant'
        });
      }, 150);
    });
  });
});
