<script>
 document.addEventListener('DOMContentLoaded', function () {
  var items = document.querySelectorAll("div[data-progressblock]");
  var lineToDraw = document.querySelector("div[data-draw-line]");
  var progressBox = document.querySelector("div[data-process-progress-box]");
  var win_size = window.innerWidth;
  let lastScrollTop = 0;

  if (lineToDraw && progressBox) {
    window.addEventListener("scroll", function () {
      var windowDistance = window.pageYOffset;
      var direction = windowDistance > lastScrollTop ? "down" : "up";
      lastScrollTop = windowDistance <= 0 ? 0 : windowDistance; // Prevent negative scroll

      var windowHeight = window.innerHeight / 2;
      var timelineDistance = progressBox.offsetTop;

      // ✨ NEW: Reset height to 0 when scroll is above timeline
      if (windowDistance < timelineDistance - windowHeight) {
        lineToDraw.style.height = "0px";

        // Also remove all in-view classes if needed
        items.forEach(function (item) {
          item.classList.remove("in-view");
        });

        return; // Exit early since no further logic needed
      }

      var line = windowDistance - timelineDistance + windowHeight;
      var mob_line = windowDistance - timelineDistance - windowHeight / 2.7;

      if (win_size <= 767) {
        lineToDraw.style.height = mob_line + "px";
      } else {
        lineToDraw.style.height = line + "px";
      }

      items.forEach(function (item) {
        var circlePosition = item.offsetTop + (win_size <= 767 ? 30 : 15);

        if (
          (win_size <= 767 && mob_line >= circlePosition) ||
          (win_size > 767 && line >= circlePosition)
        ) {
          if (!item.classList.contains("in-view")) {
            item.classList.add("in-view");
          }
        } else {
          if (direction === "up") {
            item.classList.remove("in-view");
          }
        }
      });
    });
  }
});
