        + '<div class="cw-progress-bar"><div class="cw-progress-fill cw-progress-fill--bundle" data-cw-fill-bundle style="width:0%"></div></div>'
        + '<p class="cw-progress-text" data-cw-bundle-text></p>'
        + '</div>'
        + '</div></div>';

      var node = document.createElement('div');
      node.innerHTML = html;
      var newBars = node.firstElementChild;

      var form = qs('#CartDrawer form');
      var content = form && qs('.cart-drawer__content', form);
      if (form && content) {
        form.insertBefore(newBars, content);
        refreshCartData();
      }
    }

    new MutationObserver(function (mutations) {
      var hadRemovals = mutations.some(function (m) { return m.removedNodes.length > 0; });
      if (hadRemovals) ensureProgressBars();

      var relevant = mutations.some(function (m) {
        return m.addedNodes.length > 0 && (
          (m.target.closest && m.target.closest('[data-cart-item-list]')) ||
          (m.target.matches  && m.target.matches('[data-cart-item-list]'))
        );
      });
      if (relevant) queueEnhance();
    }).observe(drawer, { childList: true, subtree: true });
  })();

  fetch('/cart.js', { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      updateProgressBars(cart);
      updateSubtotal(cart);
      updateCartEmpty(cart);
    });

  queueEnhance();
})();
</script>

