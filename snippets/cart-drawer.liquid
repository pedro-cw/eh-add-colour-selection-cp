{% if settings.show_cart_drawer and request.page_type != 'cart' %}

{% assign free_shipping_threshold = 6 %}
{% assign bundle_threshold = 6 %}
{% assign cart_items = cart.item_count %}

{% assign free_remaining = free_shipping_threshold | minus: cart_items %}
{% if free_remaining < 0 %}{% assign free_remaining = 0 %}{% endif %}
{% assign free_progress = cart_items | times: 100 | divided_by: free_shipping_threshold %}
{% if free_progress > 100 %}{% assign free_progress = 100 %}{% endif %}

{% assign bundle_progress = cart_items | times: 100 | divided_by: bundle_threshold %}
{% if bundle_progress > 100 %}{% assign bundle_progress = 100 %}{% endif %}

<div class="drawer-cover"></div>
<div
  id="CartDrawer"
  class="drawer critical-hide"
  tabindex="-1"
  data-section-id="cart-drawer"
  data-section-type="cart-drawer"
  data-cart-token="{{ cart.id }}"
  data-drawer-push
  aria-hidden="true"
>
  <form
    action="{{ routes.cart_url }}"
    method="post"
    novalidate
    class="cart-drawer{% if cart.items.size == 0 %} cart-drawer--empty{% endif %}"
  >
    <div class="cart-drawer__header">
      <div class="cart-drawer__header-container">
        <button type="button" class="cart-drawer__close-button btn btn--clear btn--square">
          {% include 'icon-close' %}
          <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
        </button>
        <p class="cart-drawer__header-title">shopping cart</p>
      </div>
    </div>

    <div id="cw-cart-progress-bars">
      <div class="cw-cart-progress">
        <div class="cw-progress-title">
          <h1>You're one step away from completing your order</h1>
        </div>

        <div class="cw-progress-block">
          <div class="cw-progress-header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.25002 18.75C8.25002 19.1478 8.09198 19.5293 7.81068 19.8107C7.52937 20.092 7.14784 20.25 6.75002 20.25C6.35219 20.25 5.97066 20.092 5.68936 19.8107C5.40805 19.5293 5.25002 19.1478 5.25002 18.75M8.25002 18.75C8.25002 18.3522 8.09198 17.9706 7.81068 17.6893C7.52937 17.408 7.14784 17.25 6.75002 17.25C6.35219 17.25 5.97066 17.408 5.68936 17.6893C5.40805 17.9706 5.25002 18.3522 5.25002 18.75M8.25002 18.75H14.25M5.25002 18.75H3.37502C3.07665 18.75 2.7905 18.6315 2.57952 18.4205C2.36855 18.2095 2.25002 17.9234 2.25002 17.625V14.25M14.25 18.75H16.5M14.25 18.75V14.25M2.25002 14.25V6.61499C2.24843 6.34116 2.34848 6.07648 2.53081 5.87217C2.71313 5.66786 2.96477 5.53845 3.23702 5.50899C6.57006 5.16302 9.92997 5.16302 13.263 5.50899C13.828 5.56699 14.25 6.04699 14.25 6.61499V7.57299M2.25002 14.25H14.25M19.5 18.75C19.5 19.1478 19.342 19.5293 19.0607 19.8107C18.7794 20.092 18.3978 20.25 18 20.25C17.6022 20.25 17.2207 20.092 16.9394 19.8107C16.6581 19.5293 16.5 19.1478 16.5 18.75M19.5 18.75C19.5 18.3522 19.342 17.9706 19.0607 17.6893C18.7794 17.408 18.3978 17.25 18 17.25C17.6022 17.25 17.2207 17.408 16.9394 17.6893C16.6581 17.9706 16.5 18.3522 16.5 18.75M19.5 18.75H20.625C21.246 18.75 21.754 18.246 21.715 17.626C21.5141 14.3236 20.4019 11.1416 18.502 8.43299C18.3211 8.17927 18.0848 7.97001 17.8111 7.82102C17.5373 7.67203 17.2333 7.58722 16.922 7.57299H14.25M14.25 7.57299V14.25" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>FREE SHIPPING</span>
          </div>
          <div class="cw-progress-bar">
            <div class="cw-progress-fill cw-progress-fill--shipping" data-cw-fill-shipping style="width: {{ free_progress }}%;"></div>
          </div>
          <p class="cw-progress-text" data-cw-shipping-text>
            {%- if free_remaining > 0 -%}
              Add {{ free_remaining }} more item{% if free_remaining > 1 %}s{% endif %} to unlock FREE UK Delivery.
            {%- else -%}
              You've unlocked FREE UK Delivery.
            {%- endif %}
          </p>
        </div>

        <div class="cw-progress-block">
          <div class="cw-progress-header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.98999 14.993L14.99 8.99304M20.99 11.994C20.99 13.262 20.36 14.384 19.397 15.063C19.5007 15.6558 19.46 16.2648 19.2784 16.8386C19.0969 17.4123 18.7798 17.9338 18.354 18.359C17.9288 18.7849 17.4073 19.1021 16.8335 19.2836C16.2598 19.4652 15.6508 19.5058 15.058 19.402C14.7122 19.8945 14.2528 20.2964 13.7188 20.5737C13.1847 20.851 12.5917 20.9955 11.99 20.995C10.722 20.995 9.59999 20.365 8.92199 19.402C8.32922 19.5058 7.72018 19.4652 7.14644 19.2836C6.5727 19.1021 6.05116 18.7849 5.62599 18.359C5.20003 17.9337 4.88284 17.412 4.70129 16.8381C4.51973 16.2642 4.47915 15.655 4.58299 15.062C4.09057 14.7162 3.68872 14.2568 3.41143 13.7228C3.13414 13.1888 2.98958 12.5958 2.98999 11.994C2.98999 10.726 3.61999 9.60404 4.58299 8.92604C4.47915 8.33312 4.51973 7.7239 4.70129 7.14999C4.88284 6.57608 5.20003 6.05437 5.62599 5.62904C6.05126 5.20334 6.57284 4.88639 7.14657 4.705C7.72031 4.52362 8.3293 4.48316 8.92199 4.58704C9.26766 4.09438 9.72698 3.69228 10.261 3.41481C10.7951 3.13734 11.3882 2.99267 11.99 2.99304C13.258 2.99304 14.38 3.62304 15.058 4.58604C15.6508 4.48229 16.2598 4.52291 16.8335 4.70446C17.4073 4.88602 17.9288 5.20317 18.354 5.62904C18.78 6.05437 19.0971 6.57608 19.2787 7.14999C19.4603 7.7239 19.5008 8.33312 19.397 8.92604C19.8894 9.27189 20.2913 9.73126 20.5686 10.2653C20.8458 10.7993 20.9904 11.3923 20.99 11.994ZM9.73999 9.74304H9.74799V9.75004H9.73999V9.74304ZM10.115 9.74304C10.115 9.8425 10.0755 9.93788 10.0052 10.0082C9.93483 10.0785 9.83945 10.118 9.73999 10.118C9.64053 10.118 9.54515 10.0785 9.47483 10.0082C9.4045 9.93788 9.36499 9.8425 9.36499 9.74304C9.36499 9.64359 9.4045 9.5482 9.47483 9.47788C9.54515 9.40755 9.64053 9.36804 9.73999 9.36804C9.83945 9.36804 9.93483 9.40755 10.0052 9.47788C10.0755 9.5482 10.115 9.64359 10.115 9.74304ZM14.24 14.243H14.248V14.251H14.24V14.243ZM14.615 14.243C14.615 14.3425 14.5755 14.4379 14.5052 14.5082C14.4348 14.5785 14.3394 14.618 14.24 14.618C14.1405 14.618 14.0452 14.5785 13.9748 14.5082C13.9045 14.4379 13.865 14.3425 13.865 14.243C13.865 14.1436 13.9045 14.0482 13.9748 13.9779C14.0452 13.9076 14.1405 13.868 14.24 13.868C14.3394 13.868 14.4348 13.9076 14.5052 13.9779C14.5755 14.0482 14.615 14.1436 14.615 14.243Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>BUNDLE SAVINGS</span>
          </div>
          <div class="cw-progress-bar">
            <div class="cw-progress-fill cw-progress-fill--bundle" data-cw-fill-bundle style="width: {{ bundle_progress }}%;"></div>
          </div>
          <p class="cw-progress-text" data-cw-bundle-text>
            {%- if cart_items >= 6 -%}
              You've unlocked 20% bundle savings.
            {%- elsif cart_items >= 4 -%}
              {% assign items_to_20 = 6 | minus: cart_items %}
              Add {{ items_to_20 }} more item{% if items_to_20 > 1 %}s{% endif %} to unlock 20% bundle savings.
            {%- elsif cart_items >= 3 -%}
              {% assign items_to_15 = 4 | minus: cart_items %}
              Add {{ items_to_15 }} more item{% if items_to_15 > 1 %}s{% endif %} to unlock 15% bundle savings.
            {%- else -%}
              {% assign items_to_10 = 3 | minus: cart_items %}
              Add {{ items_to_10 }} more item{% if items_to_10 > 1 %}s{% endif %} to unlock 10% bundle savings.
            {%- endif %}
          </p>
        </div>
      </div>
    </div>
    <!-- ── /Progress Bars ── -->

    <div class="cart-drawer__content">
      <div class="cart-drawer__content-container">

        <div class="cart-drawer__empty-text">
          <p class="text-center">{{ 'cart.general.empty' | t }}</p>

          {% if settings.show_empty_cart_menu %}
            <div class="empty-cart-menu-wrapper">

              <div class="empty-cart-menu-header">
                {% if settings.empty_cart_image != blank %}
                  <img
                    src="{{ settings.empty_cart_image | img_url: '120x120', crop: 'center' }}"
                    alt="{{ settings.empty_cart_title }}"
                    class="empty-cart-avatar" />
                {% endif %}
                <span class="empty-cart-menu-title">{{ settings.empty_cart_title }}</span>
              </div>

              <div class="empty-cart-menu-list">
                {% if settings.empty_cart_linklist != blank %}
                  {% for link in linklists[settings.empty_cart_linklist].links %}
                    <a href="{{ link.url }}" class="empty-cart-item">{{ link.title }}</a>
                  {% endfor %}
                {% else %}
                  <p style="text-align: center; font-size: 12px; margin-top: 10px; color: #6B5856;">Select a menu in the theme settings.</p>
                {% endif %}
              </div>

            </div>
          {% endif %}
        </div>
        <div class="cart-drawer__no-cookies">
          <p class="text-center">{{ 'cart.general.cookies_required' | t }}</p>
        </div>

        <div class="cart-drawer__item-list" data-cart-item-list>
          {%- assign cartItems = 'template ' | split: ' ' -%}
          {% if cart.items.size > 0 %}{%- assign cartItems = cart.items -%}{% endif %}

          {% for item in cartItems %}
            <div
              class="cart-drawer__item{% if item == 'template' %} ajax-cart__template{% endif %}"
              data-cart-item
              data-cart-item-id="{{ item.key }}"
              data-cart-item-line-number="{{ forloop.index }}"
              aria-live="polite"
            >
              {% assign itemImage = true %}
              {% if item.image == blank and item.product.featured_image == blank %}{% assign itemImage = false %}{% endif %}
              <a
                href="{{ item.url }}"
                class="cart-drawer__item-image"
                style="background-image: {% if itemImage %}url('{{ item | img_url: 'medium' }}'){% else %}none{% endif %};"
                data-cart-item-background-image
                data-cart-item-href
              ></a>

              <div class="cart-drawer__item-content">
                <a href="{{ item.url }}" class="h4 cart-drawer__item-title" data-cart-item-href data-cart-item-title>
                  {{- item.product.title -}}
                </a>
                <p class="cart-drawer__item-subtitle" data-cart-item-variant-title>
                  {% unless item.product.has_only_default_variant %}{{ item.variant.title }}{% endunless %}
                </p>

                <ul class="cart-drawer__item-properties" data-cart-item-details-list>
                  <li class="cart-drawer__item-property{% if item.selling_plan_allocation == nil %} visually-hidden{% endif %}" data-cart-item-selling-plan-name>
                    {{ item.selling_plan_allocation.selling_plan.name }}
                  </li>
                  {%- assign itemProperties = 'template ' | split: ' ' -%}
                  {%- assign property_size = item.properties | size -%}
                  {% if property_size > 0 %}{%- assign itemProperties = item.properties -%}{% endif %}
                  {% for p in itemProperties %}
                    {% assign first_character_in_key = p.first | truncate: 1, '' %}
                    {% unless p.last == blank or first_character_in_key == '_' %}
                      <li class="cart-drawer__item-property{% if p == 'template' %} ajax-cart__template{% endif %}{% if p.last == blank %} visually-hidden{% endif %}" data-cart-item-property>
                        {{ p.first }}:
                        {% if p.last contains '/uploads/' -%}
                          <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                        {%- else -%}
                          {{- p.last -}}
                        {%- endif %}
                      </li>
                    {% endunless %}
                  {% endfor %}
                </ul>

                <p
                  class="cart-drawer__item-price-container"
                  data-cart-item-price-container
                  data-wpd-cart-drawer-product-handle="{{ item.product.handle }}"
                  data-wpd-cart-drawer-variant-id="{{ item.variant.id }}"
                  data-wpd-cart-drawer-variant-price="{{ item.variant.price }}"
                  data-wpd-cart-drawer-variant-compare-at-price="{{ item.variant.compare_at_price }}"
                  data-wpd-cart-drawer-product-collection-ids="{% assign wpdProductCollectionIds = item.product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                  data-wpd-cart-drawer-product-id="{{ item.product.id }}"
                  data-wpd-cart-drawer-line-price
                  data-wpd-cart-drawer-item="{{ item.key }}"
                  data-wpd-cart-drawer-quantity="{{ item.quantity }}"
                >
                  {%- if item.original_price != item.final_price -%}
                    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                    <del class="cart-item__original-price">{{ item.original_price | money }}</del>
                    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
                    <span class="order-discount cart-item__price"
                      data-wpd-cart-drawer-product-handle="{{ item.product.handle }}"
                      data-wpd-cart-drawer-variant-id="{{ item.variant.id }}"
                      data-wpd-cart-drawer-variant-price="{{ item.variant.price }}"
                      data-wpd-cart-drawer-variant-compare-at-price="{{ item.variant.compare_at_price }}"
                      data-wpd-cart-drawer-product-collection-ids="{% assign wpdProductCollectionIds = item.product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                      data-wpd-cart-drawer-product-id="{{ item.product.id }}"
                      data-wpd-cart-drawer-line-price
                      data-wpd-cart-drawer-item="{{ item.key }}"
                      data-wpd-cart-drawer-quantity="{{ item.quantity }}"
                    >{{- item.final_price | money -}}</span>
                  {%- else -%}
                    <span class="cart-item__original-price cart-item__price"
                      data-wpd-cart-drawer-product-handle="{{ item.product.handle }}"
                      data-wpd-cart-drawer-variant-id="{{ item.variant.id }}"
                      data-wpd-cart-drawer-variant-price="{{ item.variant.price }}"
                      data-wpd-cart-drawer-variant-compare-at-price="{{ item.variant.compare_at_price }}"
                      data-wpd-cart-drawer-product-collection-ids="{% assign wpdProductCollectionIds = item.product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                      data-wpd-cart-drawer-product-id="{{ item.product.id }}"
                      data-wpd-cart-drawer-line-price
                      data-wpd-cart-drawer-item="{{ item.key }}"
                      data-wpd-cart-drawer-quantity="{{ item.quantity }}"
                    >{{- item.original_price | money -}}</span>
                  {%- endif -%}
                </p>

                <ul class="order-discount order-discount--list order-discount--title order-discount--cart" aria-label="{{ 'customer.order.discount' | t }}" data-cart-item-discount-list>
                  {%- if item.line_level_discount_allocations != blank -%}
                    {%- for discount_allocation in item.line_level_discount_allocations -%}
                      <li class="order-discount__item" data-cart-item-discount>
                        {%- render 'icon-saletag' -%}
                        <span data-cart-item-discount-title>{{ discount_allocation.discount_application.title }}</span>
                        (-<span data-cart-item-discount-amount>{{ discount_allocation.amount | money }}</span>)
                      </li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>

                <button class="cart-drawer__item-delete btn-link" type="button" data-cart-item-delete>
                  {% render 'icon-trash' %}
                </button>

                <label for="quantity_{{ item.key }}" class="label--hidden" data-cart-item-label-quantity>
                  {{- 'cart.general.item_quantity' | t -}}
                </label>
                <input
                  id="quantity_{{ item.key }}"
                  class="cart-drawer__item-quantity"
                  value="{{ item.quantity }}"
                  type="number"
                  pattern="\d*"
                  min="1"
                  aria-label="{{ 'cart.general.item_quantity' | t }}"
                  data-cart-item-input-quantity
                >
              </div>
              <p class="cart-item__message text-center" aria-hidden="true" data-item-message></p>
            </div>
          {% endfor %}

          <div id="mr-div-embedded-cp-any-drawer"></div>

          {% if settings.show_cart_note %}
            <div class="cart-drawer__item cart-drawer__note-container" data-cart-note-container>
              <label for="CartSpecialInstructions">{{ 'cart.general.note' | t }}</label>
              <textarea name="note" class="cart-drawer__note" data-cart-note>{{ cart.note }}</textarea>
            </div>
          {% endif %}
        </div>

      </div>
    </div>

    <div class="cart-drawer__footer">
      <div class="cart-drawer__footer-container">
        <div class="cart-drawer__subtotal-row" aria-live="polite">
          <div class="cart-drawer__subtotal-label"><span class="h4">SUBTOTAL:</span></div>
          <div class="cart-drawer__subtotal-price" data-wpd-cart-total>
            <span class="cart-drawer__subtotal-number" data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>
        </div>

        <button type="submit" class="btn btn--loader cart-drawer__checkout cart-drawer__checkout--full" name="checkout" data-cart-submit {% if cart.items.size == 0 %}disabled{% endif %}>
          Proceed to Checkout
          <span class="btn--loader-balls"></span>
        </button>

        <div class="cart-drawer__trust">
          <div class="cart-drawer__trust-item">
            {% render 'icon-heart' %}
            <span>TRUSTED BY<br>100,000+</span>
          </div>
          <div class="cart-drawer__trust-item">
            {% render 'icon-truck-cart' %}
            <span>FAST UK<br>DELIVERY</span>
          </div>
          <div class="cart-drawer__trust-item">
            {% render 'icon-badge-check' %}
            <span>CLINICALLY<br>PROVEN</span>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<style>
  @import url("https://fonts.cdnfonts.com/css/botanic");

  .cart-drawer { background-color: #F7F8F4 !important; }

  #cw-cart-progress-bars {
    width: 100%;
    padding: 20px 10px 16px;
    box-sizing: border-box;
    background: #F7F8F4;
    flex-shrink: 0;
  }

  #CartDrawer form.cart-drawer--empty #cw-cart-progress-bars { display: none !important; }

  #cw-cart-progress-bars .cw-cart-progress { display: flex; flex-direction: column; gap: 18px; width: 100%; }
  #cw-cart-progress-bars .cw-progress-block { display: flex; flex-direction: column; gap: 8px; width: 100%; margin-left: 10px; }
  #cw-cart-progress-bars .cw-progress-header { display: flex; align-items: center; gap: 6px; }
  #cw-cart-progress-bars .cw-progress-header span { color: #2B2623; font-family: Montserrat, sans-serif; font-size: 16px; font-weight: 600; line-height: 17.6px; text-transform: uppercase; }
  #cw-cart-progress-bars .cw-progress-bar { width: 90%; height: 14px; background: rgba(72, 72, 72, 0.10); border-radius: 200px; overflow: hidden; }
  #cw-cart-progress-bars .cw-progress-fill { height: 100%; border-radius: 32px; transition: width 0.3s ease; }
  #cw-cart-progress-bars .cw-progress-fill--shipping { background: #695450; }
  #cw-cart-progress-bars .cw-progress-fill--bundle { background: #AA8C6B; }
  #cw-cart-progress-bars .cw-progress-text { margin: 0; color: #977E57; font-family: Montserrat, sans-serif; font-size: 14px; font-weight: 400; line-height: 15.4px; }

  .cw-progress-title h1 { font-family: Montserrat; font-weight: 400; font-size: 14px !important; line-height: 110%; color: #977E57; margin: 0; }
  .cw-progress-title h1::first-letter { text-transform: uppercase !important; }
  .cw-progress-title { margin-bottom: -10px; }

  #CartDrawer .cart-drawer {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #CartDrawer .cart-drawer__content {
    flex: 1 1 auto;
    overflow-y: auto !important;
    min-height: 0;
    -webkit-overflow-scrolling: touch;
  }

  #CartDrawer .cart-drawer__header-title,
  .cart-drawer__header-title {
    font-family: Botanica !important;
    font-weight: 400 !important;
    font-size: 32px !important;
    line-height: 110% !important;
    letter-spacing: 0.02em !important;
    text-align: center !important;
    margin: 0 !important;
    white-space: nowrap;
  }

  .cart-drawer__subtotal-label span { font-size: 32px !important; }

  input[type=number].cart-drawer__item-quantity { position: absolute; top: 100px !important; right: 190px !important; display: none; }

  .cart-drawer__item-price-container { position: absolute !important; right: 5px !important; bottom: 10px !important; }

  span.cart-item__original-price.cart-item__price,
  .order-discount.cart-item__price {
    font-family: Montserrat !important; font-weight: 500 !important; font-size: 20px !important;
    color: #977E57 !important; line-height: 110% !important; letter-spacing: 0.02em !important; text-transform: uppercase !important;
  }

  del.cart-item__original-price {
    color: #A7A7A7 !important; font-family: Montserrat !important; font-weight: 500 !important;
    font-size: 20px !important; line-height: 110% !important; letter-spacing: 0.02em !important; text-transform: uppercase !important;
  }

  .cart-drawer__item.cart-drawer__note-container { display: none !important; }

  .cart-drawer__item { width: 100%; height: 170px; position: relative; right: 0; border-radius: 10px; background: #FFFFFF; margin-top: 10px; }

  a.cart-drawer__item-image { margin: 10px; width: 100px; height: 100px; transform: translateY(15px); }

  .cart-drawer__item-delete { margin-right: 10px; top: 25px; }
  .btn-link { border-bottom: none !important; }

  .cart-drawer__item-title { margin-top: 0; font-family: Montserrat; font-weight: 510; color: #977E57; line-height: 100%; letter-spacing: 0; text-transform: uppercase; position: relative; left: 40px; top: 15px; }

  .custom-qty { display: inline-flex; align-items: center; border: 0.73px solid #69545033; overflow: hidden; width: 78px; height: 32px; position: absolute; top: 130px; transform: translateX(40px); }
  .custom-qty button { width: 28px; height: 32px; background: #fff; border: none; cursor: pointer; font-size: 16px; line-height: 1; }
  .custom-qty span { width: 32px; text-align: center; font-size: 14px; }
  .custom-qty .custom-qty__input { width: 32px; height: 32px; border: 0; outline: 0; padding: 0; margin: 0; text-align: center; font-size: 14px; background: transparent; appearance: textfield; -moz-appearance: textfield; }
  .custom-qty .custom-qty__input::-webkit-outer-spin-button,
  .custom-qty .custom-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .custom-qty.is-loading { opacity: 0.75; pointer-events: none; }

  .cart-drawer__item-subtitle { position: relative; top: 15px; left: 40px; }

  #CartDrawer .cart-drawer__footer { background: transparent; }
  .cart-drawer__footer { padding: 0 15px !important; }

  #CartDrawer .cart-drawer__subtotal-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; font-family: Montserrat; font-weight: 500; font-size: 31px; color: #977E57; line-height: 110%; letter-spacing: 0.02em; text-transform: uppercase; }
  #CartDrawer .cart-drawer__subtotal-number { font-family: Montserrat; font-weight: 500; font-size: 24px; line-height: 110%; letter-spacing: 0.02em; text-transform: uppercase; color: #977E57 !important; }
  #CartDrawer .cart-drawer__checkout--full { width: 100%; border-radius: 0 !important; background: #6B5856 !important; color: #fff !important; font-family: Montserrat !important; font-weight: 600 !important; font-size: 16px !important; text-transform: none !important; margin-bottom: 0; }

  #CartDrawer .cart-drawer__trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 18px; align-items: start; }
  #CartDrawer .cart-drawer__trust-item { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 12px 6px 0; position: relative; }
  #CartDrawer .cart-drawer__trust-item:not(:first-child)::before { content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 1px; background: rgba(151, 126, 87, 0.22); }
  #CartDrawer .cart-drawer__trust-item svg { width: 26px; height: 26px; display: block; }
  #CartDrawer .cart-drawer__trust-item span { margin-top: 8px; font-family: Montserrat !important; font-weight: 500 !important; font-size: 12px !important; letter-spacing: 0.08em !important; text-transform: uppercase; line-height: 1.15; color: #977E57 !important; }

  div#mr-div-embedded-cp-any-drawer:has(> div > div:not(:empty)) ~ div[id*="mr-div-embedded-cp-any-drawer"] { display: none !important; }
  div#mr-div-embedded-cp-any-drawer { padding-top: 15px; }
  div#mr-div-embedded-cp-cvb-drawer { display: none; }

  @media (max-width: 768px) {
    .custom-qty { position: absolute !important; top: 100px !important; transform: translateX(70px) !important; left: 40px !important; }
    a.cart-drawer__item-image { width: 80px; height: 80px; transform: translateY(20px); }
    .cart-drawer__item-title { font-size: 16px; line-height: 1.2; }
    .cart-drawer__item-delete { margin-right: 20px; }
    .cart-drawer__item-price-container { right: 15px !important; bottom: 5px !important; font-size: 16px !important; }
    .cart-drawer__item { height: 140px; }
    .cart-drawer__header-title { font-size: 24px !important; }
    .cart-drawer__subtotal-label span,
    #CartDrawer .cart-drawer__subtotal-number { font-size: 20px !important; }
    #CartDrawer .cart-drawer__checkout--full { white-space: nowrap !important; }
  }

  div#CartDrawer { right: -375px; width: 375px; }
  .drawer--active div#CartDrawer[data-drawer-push] { -ms-transform: translateX(-375px); -webkit-transform: translateX(-375px); transform: translate(-375px); }
</style>

<script>
(function () {
  if (window.__CW_CART_V2__) return;
  window.__CW_CART_V2__ = true;

  var FREE_THRESHOLD   = 6;
  var BUNDLE_THRESHOLD = 6;

  function qs(sel, root)  { return (root || document).querySelector(sel); }
  function qsa(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function formatMoney(cents) { return '\u00a3' + (cents / 100).toFixed(2); }

  function openCartDrawer() {
    document.dispatchEvent(new Event('cart:refresh'));
    document.dispatchEvent(new Event('cart:updated'));
    document.dispatchEvent(new Event('monk:cart:open'));
    var el = qs('#CartDrawer');
    if (!el) return;
    el.classList.add('active', 'is-open');
    el.setAttribute('open', 'true');
    document.documentElement.classList.add('overflow-hidden');
    document.body.classList.add('overflow-hidden');
  }

  function updateProgressBars(cart) {
    var items = cart.item_count;
    var freeRemaining = Math.max(FREE_THRESHOLD - items, 0);
    var freeProgress  = Math.min(items * 100 / FREE_THRESHOLD, 100);

    var fillS = qs('[data-cw-fill-shipping]');
    if (fillS) fillS.style.width = freeProgress + '%';

    var textS = qs('[data-cw-shipping-text]');
    if (textS) textS.textContent = freeRemaining > 0
      ? 'Add ' + freeRemaining + ' more item' + (freeRemaining > 1 ? 's' : '') + ' to unlock FREE UK Delivery.'
      : "You've unlocked FREE UK Delivery.";

    var bundleProgress = Math.min(items * 100 / BUNDLE_THRESHOLD, 100);
    var fillB = qs('[data-cw-fill-bundle]');
    if (fillB) fillB.style.width = bundleProgress + '%';

    var textB = qs('[data-cw-bundle-text]');
    if (textB) {
      if (items >= 6)      textB.textContent = "You've unlocked 20% bundle savings.";
      else if (items >= 4) textB.textContent = 'Add ' + (6-items) + ' more item' + (6-items > 1 ? 's':'') + ' to unlock 20% bundle savings.';
      else if (items >= 3) textB.textContent = 'Add ' + (4-items) + ' more item' + (4-items > 1 ? 's':'') + ' to unlock 15% bundle savings.';
      else                 textB.textContent = 'Add ' + (3-items) + ' more item' + (3-items > 1 ? 's':'') + ' to unlock 10% bundle savings.';
    }
  }

  function updateSubtotal(cart) {
    var el = qs('[data-cart-subtotal]');
    if (el) el.textContent = formatMoney(cart.total_price);
  }

  function updateLinePrices(cart) {
    cart.items.forEach(function (item, i) {
      var itemEl = qs('.cart-drawer__item[data-cart-item-line-number="' + (i+1) + '"]');
      if (!itemEl) return;
      var priceEl = qs('.cart-item__price', itemEl);
      if (priceEl) priceEl.textContent = formatMoney(item.final_price);
    });
  }

  function updateCartEmpty(cart) {
    var form = qs('#CartDrawer form');
    if (form) form.classList.toggle('cart-drawer--empty', cart.item_count === 0);
    var btn = qs('[data-cart-submit]');
    if (btn) btn.disabled = cart.item_count === 0;
  }

  function refreshCartData() {
    return fetch('/cart.js', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        updateProgressBars(cart);
        updateSubtotal(cart);
        updateLinePrices(cart);
        updateCartEmpty(cart);
        return cart;
      });
  }

  function buildItemHTML(item, index) {
    var imgUrl = item.featured_image && item.featured_image.url
      ? item.featured_image.url.replace(/(\.[a-z]+)(\?|$)/, '_medium$1$2')
      : (item.image || '');
    var imgStyle = imgUrl ? 'background-image: url(' + imgUrl + ');' : '';

    var variantTitle = (!item.product_has_only_default_variant && item.variant_title)
      ? '<p class="cart-drawer__item-subtitle" data-cart-item-variant-title>' + item.variant_title + '</p>'
      : '<p class="cart-drawer__item-subtitle" data-cart-item-variant-title></p>';

    var priceHTML = item.original_price !== item.final_price
      ? '<del class="cart-item__original-price">' + formatMoney(item.original_price) + '</del><span class="order-discount cart-item__price">' + formatMoney(item.final_price) + '</span>'
      : '<span class="cart-item__original-price cart-item__price">' + formatMoney(item.original_price) + '</span>';

    var discountsHTML = '';
    if (item.line_level_discount_allocations && item.line_level_discount_allocations.length) {
      item.line_level_discount_allocations.forEach(function (d) {
        discountsHTML += '<li class="order-discount__item" data-cart-item-discount>'
          + '<span data-cart-item-discount-title>' + d.discount_application.title + '</span>'
          + ' (-<span data-cart-item-discount-amount>' + formatMoney(d.amount) + '</span>)</li>';
      });
    }

    return '<div class="cart-drawer__item" data-cart-item data-cart-item-id="' + item.key + '" data-cart-item-line-number="' + index + '" aria-live="polite">'
      + '<a href="' + item.url + '" class="cart-drawer__item-image" style="' + imgStyle + '" data-cart-item-background-image data-cart-item-href></a>'
      + '<div class="cart-drawer__item-content">'
      + '<a href="' + item.url + '" class="h4 cart-drawer__item-title" data-cart-item-href data-cart-item-title>' + item.product_title + '</a>'
      + variantTitle
      + '<p class="cart-drawer__item-price-container" data-cart-item-price-container>' + priceHTML + '</p>'
      + '<ul class="order-discount order-discount--list order-discount--title order-discount--cart" aria-label="Discount" data-cart-item-discount-list>' + discountsHTML + '</ul>'
      + '<button class="cart-drawer__item-delete btn-link" type="button" data-cart-item-delete>'
      + '<svg width="16" height="18" viewBox="0 0 16 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 18C2.45 18 1.97933 17.8043 1.588 17.413C1.19667 17.0217 1.00067 16.5507 1 16V3H0V1H5V0H11V1H16V3H15V16C15 16.55 14.8043 17.021 14.413 17.413C14.0217 17.805 13.5507 18.0007 13 18H3ZM13 3H3V16H13V3ZM5 14H7V5H5V14ZM9 14H11V5H9V14Z" fill="#695450"></path></svg>'
      + '</button>'
      + '<label for="quantity_' + item.key + '" class="label--hidden" data-cart-item-label-quantity>Item Quantity</label>'
      + '<input id="quantity_' + item.key + '" class="cart-drawer__item-quantity" value="' + item.quantity + '" type="number" pattern="\\d*" min="1" aria-label="Item Quantity" data-cart-item-input-quantity>'
      + '</div>'
      + '<p class="cart-item__message text-center" aria-hidden="true" data-item-message></p>'
      + '</div>';
  }

  function rebuildItemList() {
    return fetch('/cart.js', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var mountList = qs('[data-cart-item-list]');
        if (mountList) {
          var html = '';
          cart.items.forEach(function (item, i) { html += buildItemHTML(item, i + 1); });
          html += '<div id="mr-div-embedded-cp-any-drawer"></div>';
          mountList.innerHTML = html;
        }
        updateProgressBars(cart);
        updateSubtotal(cart);
        updateCartEmpty(cart);
        queueEnhance();
        return cart;
      });
  }

  function changeLineQuantity(line, quantity) {
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ line: Number(line), quantity: Number(quantity) })
    }).then(function (r) { if (!r.ok) throw new Error('change failed'); return r.json(); });
  }

  function addToCart(variantId) {
    return fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ id: Number(variantId), quantity: 1 })
    }).then(function (r) { if (!r.ok) throw new Error('add failed'); return r.json(); });
  }

  function lockItem(line, on) {
    var item = qs('.cart-drawer__item[data-cart-item-line-number="' + line + '"]');
    if (!item) return;
    item.dataset.qtyReqLock = on ? '1' : '0';
    var wrap = qs('.custom-qty[data-line="' + line + '"]', item);
    if (!wrap) return;
    if (on) wrap.classList.add('is-loading'); else wrap.classList.remove('is-loading');
    qsa('button', wrap).forEach(function (b) { b.disabled = !!on; });
    var inp = qs('.custom-qty__input', wrap);
    if (inp) inp.disabled = !!on;
  }

  function setLineQtyUI(line, qty) {
    var item = qs('.cart-drawer__item[data-cart-item-line-number="' + line + '"]');
    if (!item) return;
    var native = qs('input[type="number"].cart-drawer__item-quantity', item);
    if (native) { native.value = String(qty); native.setAttribute('value', String(qty)); }
    var inp = qs('.custom-qty__input', item);
    if (inp && inp !== document.activeElement) inp.value = String(qty);
  }

  function commitQty(wrap, rawQty) {
    var line = wrap.getAttribute('data-line');
    if (!line) return;
    var item = wrap.closest('.cart-drawer__item[data-cart-item]');
    if (item && item.dataset.qtyReqLock === '1') return;
    var next = parseInt(String(rawQty || '').replace(/[^\d]/g, ''), 10);
    if (!next || next < 1) next = 1;
    lockItem(line, true);
    setLineQtyUI(line, next);
    changeLineQuantity(line, next)
      .then(function (cart) {
        var lineIdx = parseInt(line, 10) - 1;
        if (cart.items[lineIdx] === undefined) return rebuildItemList();
        updateProgressBars(cart);
        updateSubtotal(cart);
        updateLinePrices(cart);
        updateCartEmpty(cart);
      })
      .catch(function () { refreshCartData(); })
      .finally(function () { setTimeout(function () { lockItem(line, false); }, 150); });
  }

  function ensureQtyUI(root) {
    qsa('.cart-drawer__item[data-cart-item]', root || document).forEach(function (item) {
      var native = qs('input[type="number"].cart-drawer__item-quantity', item);
      if (!native) return;
      var line = item.getAttribute('data-cart-item-line-number');
      if (!line) return;
      var existing = qs('.custom-qty[data-line="' + line + '"]', item);
      var currentVal = parseInt(native.value, 10) || 1;
      if (existing) {
        var ei = qs('.custom-qty__input', existing);
        if (ei && ei !== document.activeElement) ei.value = String(currentVal);
        return;
      }
      var wrapper = document.createElement('div');
      wrapper.className = 'custom-qty';
      wrapper.setAttribute('data-line', String(line));
      var minus = document.createElement('button');
      minus.type = 'button'; minus.setAttribute('data-qty-action', 'minus'); minus.textContent = '\u2212';
      var inp = document.createElement('input');
      inp.type = 'number'; inp.min = '1'; inp.inputMode = 'numeric'; inp.autocomplete = 'off';
      inp.className = 'custom-qty__input'; inp.value = String(currentVal);
      var plus = document.createElement('button');
      plus.type = 'button'; plus.setAttribute('data-qty-action', 'plus'); plus.textContent = '+';
      wrapper.appendChild(minus); wrapper.appendChild(inp); wrapper.appendChild(plus);
      var content = item.querySelector('.cart-drawer__item-content');
      if (content) content.appendChild(wrapper);
      var t = null;
      inp.addEventListener('input', function () { if (t) clearTimeout(t); t = setTimeout(function () { commitQty(wrapper, inp.value); }, 550); });
      inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); if (t) clearTimeout(t); commitQty(wrapper, inp.value); } });
      inp.addEventListener('blur', function () { if (t) clearTimeout(t); commitQty(wrapper, inp.value); });
    });
  }

  var enhanceQueued = false;
  function queueEnhance() {
    if (enhanceQueued) return;
    enhanceQueued = true;
    requestAnimationFrame(function () { enhanceQueued = false; ensureQtyUI(document); });
  }

  function extractVariantId(btn) {
    if (!btn) return null;
    if (btn.dataset && btn.dataset.variantId) return btn.dataset.variantId;
    var attr = btn.getAttribute && btn.getAttribute('data-variant-id');
    if (attr) return attr;
    var form = btn.closest && btn.closest('form');
    if (form) { var id = form.querySelector && form.querySelector('[name="id"]'); if (id && id.value) return id.value; }
    var wrap = btn.closest && btn.closest('[data-variant-id]');
    if (wrap) return wrap.getAttribute('data-variant-id');
    return null;
  }

  document.addEventListener('click', function (e) {
    var qtyBtn = e.target.closest && e.target.closest('.custom-qty button[data-qty-action]');
    if (qtyBtn) {
      e.preventDefault(); e.stopPropagation();
      var wrap = qtyBtn.closest('.custom-qty');
      var line = wrap && wrap.getAttribute('data-line');
      if (!line) return;
      var item = qtyBtn.closest('.cart-drawer__item[data-cart-item]');
      if (!item || item.dataset.qtyReqLock === '1') return;
      var inp2 = qs('.custom-qty__input', wrap);
      var current = parseInt(inp2 ? inp2.value : '1', 10) || 1;
      commitQty(wrap, qtyBtn.getAttribute('data-qty-action') === 'plus' ? current + 1 : Math.max(current - 1, 1));
      return;
    }

    var deleteBtn = e.target.closest && e.target.closest('[data-cart-item-delete]');
    if (deleteBtn) {
      e.preventDefault();
      e.stopImmediatePropagation();
      var deleteItem = deleteBtn.closest('.cart-drawer__item[data-cart-item]');
      var deleteLine = deleteItem && deleteItem.getAttribute('data-cart-item-line-number');
      if (!deleteLine) return;
      changeLineQuantity(deleteLine, 0)
        .then(function (cart) {
          updateProgressBars(cart);
          updateSubtotal(cart);
          updateCartEmpty(cart);
          return rebuildItemList();
        })
        .catch(function () { refreshCartData(); });
      return;
    }

    var container = e.target.closest && e.target.closest('#mr-div-embedded-cp-any-drawer');
    if (!container) return;
    var btn = e.target.closest && e.target.closest("button, input[type='submit'], [data-add-to-cart], .add-to-cart, .btn");
    if (!btn) return;
    var variantId = extractVariantId(btn);
    if (!variantId) return;
    e.preventDefault(); e.stopImmediatePropagation();
    addToCart(variantId)
      .then(function () { return rebuildItemList(); })
      .then(function () { openCartDrawer(); })
      .catch(function () { rebuildItemList().then(openCartDrawer); });
  }, true);

  (function () {
    if (window.__CW_FETCH_PATCH__) return;
    window.__CW_FETCH_PATCH__ = true;
    var _fetch = window.fetch;
    window.fetch = function () {
      var url = typeof arguments[0] === 'string' ? arguments[0] : (arguments[0] && arguments[0].url) || '';
      var isAdd = /\/cart\/(add|change|update|clear)\.js/.test(url);
      return _fetch.apply(this, arguments).then(function (response) {
        if (isAdd) {
          setTimeout(function () { refreshCartData(); }, 300);
        }
        return response;
      });
    };
  })();

 (function () {
    var drawer = qs('#CartDrawer');
    if (!drawer) return;

    function ensureProgressBars() {
      var bars = qs('#cw-cart-progress-bars');
      if (bars) return;

      var html = '<div id="cw-cart-progress-bars">'
        + '<div class="cw-cart-progress">'
        + '<div class="cw-progress-title"><h1>You\'re one step away from completing your order</h1></div>'
        + '<div class="cw-progress-block">'
        + '<div class="cw-progress-header"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.25002 18.75C8.25002 19.1478 8.09198 19.5293 7.81068 19.8107C7.52937 20.092 7.14784 20.25 6.75002 20.25C6.35219 20.25 5.97066 20.092 5.68936 19.8107C5.40805 19.5293 5.25002 19.1478 5.25002 18.75M8.25002 18.75C8.25002 18.3522 8.09198 17.9706 7.81068 17.6893C7.52937 17.408 7.14784 17.25 6.75002 17.25C6.35219 17.25 5.97066 17.408 5.68936 17.6893C5.40805 17.9706 5.25002 18.3522 5.25002 18.75M8.25002 18.75H14.25M5.25002 18.75H3.37502C3.07665 18.75 2.7905 18.6315 2.57952 18.4205C2.36855 18.2095 2.25002 17.9234 2.25002 17.625V14.25M14.25 18.75H16.5M14.25 18.75V14.25M2.25002 14.25V6.61499C2.24843 6.34116 2.34848 6.07648 2.53081 5.87217C2.71313 5.66786 2.96477 5.53845 3.23702 5.50899C6.57006 5.16302 9.92997 5.16302 13.263 5.50899C13.828 5.56699 14.25 6.04699 14.25 6.61499V7.57299M2.25002 14.25H14.25M19.5 18.75C19.5 19.1478 19.342 19.5293 19.0607 19.8107C18.7794 20.092 18.3978 20.25 18 20.25C17.6022 20.25 17.2207 20.092 16.9394 19.8107C16.6581 19.5293 16.5 19.1478 16.5 18.75M19.5 18.75C19.5 18.3522 19.342 17.9706 19.0607 17.6893C18.7794 17.408 18.3978 17.25 18 17.25C17.6022 17.25 17.2207 17.408 16.9394 17.6893C16.6581 17.9706 16.5 18.3522 16.5 18.75M19.5 18.75H20.625C21.246 18.75 21.754 18.246 21.715 17.626C21.5141 14.3236 20.4019 11.1416 18.502 8.43299C18.3211 8.17927 18.0848 7.97001 17.8111 7.82102C17.5373 7.67203 17.2333 7.58722 16.922 7.57299H14.25M14.25 7.57299V14.25" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        + '<span>FREE SHIPPING</span></div>'
        + '<div class="cw-progress-bar"><div class="cw-progress-fill cw-progress-fill--shipping" data-cw-fill-shipping style="width:0%"></div></div>'
        + '<p class="cw-progress-text" data-cw-shipping-text></p>'
        + '</div>'
        + '<div class="cw-progress-block">'
        + '<div class="cw-progress-header"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.98999 14.993L14.99 8.99304M20.99 11.994C20.99 13.262 20.36 14.384 19.397 15.063C19.5007 15.6558 19.46 16.2648 19.2784 16.8386C19.0969 17.4123 18.7798 17.9338 18.354 18.359C17.9288 18.7849 17.4073 19.1021 16.8335 19.2836C16.2598 19.4652 15.6508 19.5058 15.058 19.402C14.7122 19.8945 14.2528 20.2964 13.7188 20.5737C13.1847 20.851 12.5917 20.9955 11.99 20.995C10.722 20.995 9.59999 20.365 8.92199 19.402C8.32922 19.5058 7.72018 19.4652 7.14644 19.2836C6.5727 19.1021 6.05116 18.7849 5.62599 18.359C5.20003 17.9337 4.88284 17.412 4.70129 16.8381C4.51973 16.2642 4.47915 15.655 4.58299 15.062C4.09057 14.7162 3.68872 14.2568 3.41143 13.7228C3.13414 13.1888 2.98958 12.5958 2.98999 11.994C2.98999 10.726 3.61999 9.60404 4.58299 8.92604C4.47915 8.33312 4.51973 7.7239 4.70129 7.14999C4.88284 6.57608 5.20003 6.05437 5.62599 5.62904C6.05126 5.20334 6.57284 4.88639 7.14657 4.705C7.72031 4.52362 8.3293 4.48316 8.92199 4.58704C9.26766 4.09438 9.72698 3.69228 10.261 3.41481C10.7951 3.13734 11.3882 2.99267 11.99 2.99304C13.258 2.99304 14.38 3.62304 15.058 4.58604C15.6508 4.48229 16.2598 4.52291 16.8335 4.70446C17.4073 4.88602 17.9288 5.20317 18.354 5.62904C18.78 6.05437 19.0971 6.57608 19.2787 7.14999C19.4603 7.7239 19.5008 8.33312 19.397 8.92604C19.8894 9.27189 20.2913 9.73126 20.5686 10.2653C20.8458 10.7993 20.9904 11.3923 20.99 11.994ZM9.73999 9.74304H9.74799V9.75004H9.73999V9.74304ZM10.115 9.74304C10.115 9.8425 10.0755 9.93788 10.0052 10.0082C9.93483 10.0785 9.83945 10.118 9.73999 10.118C9.64053 10.118 9.54515 10.0785 9.47483 10.0082C9.4045 9.93788 9.36499 9.8425 9.36499 9.74304C9.36499 9.64359 9.4045 9.5482 9.47483 9.47788C9.54515 9.40755 9.64053 9.36804 9.73999 9.36804C9.83945 9.36804 9.93483 9.40755 10.0052 9.47788C10.0755 9.5482 10.115 9.64359 10.115 9.74304ZM14.24 14.243H14.248V14.251H14.24V14.243ZM14.615 14.243C14.615 14.3425 14.5755 14.4379 14.5052 14.5082C14.4348 14.5785 14.3394 14.618 14.24 14.618C14.1405 14.618 14.0452 14.5785 13.9748 14.5082C13.9045 14.4379 13.865 14.3425 13.865 14.243C13.865 14.1436 13.9045 14.0482 13.9748 13.9779C14.0452 13.9076 14.1405 13.868 14.24 13.868C14.3394 13.868 14.4348 13.9076 14.5052 13.9779C14.5755 14.0482 14.615 14.1436 14.615 14.243Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
