00%);height:auto;max-height:100%" class="r-10iot13" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Ras32:"><div data-rid="f9360667-6486-4cfa-ae8c-ae49f32364b8" class="r-kgzm5p"><div data-rid="d9b8f067-1ad3-4c48-b5e5-2aa9495656bc" class="r-1ngcbuy alchemy-rte"><span style="width:100%"><p>Yes. Ear seeds are a gentle, non-invasive way to support your body’s natural balance. They can be worn daily for 3–5 days at a time without causing harm or irritation.</p></span></div></div></div></div><div data-rid="d35f4970-19b3-4d11-a6b2-b2e2b6804ac8" class="r-90je92" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="576ad48d-0376-4ba0-9121-cef219ab4d2a" aria-expanded="false" aria-controls="replo-:Res32:" tabindex="0" role="button" class="r-my0lmh"><div data-rid="67752501-d740-4ec3-900d-53a9d147d8fd" class="r-18g5ayf alchemy-rte"><span style="width:100%"><p>Will the seeds hurt?</p></span></div><div data-rid="df97878e-5e89-4e0d-9fea-afcf667601f9" class="r-uu4ebp" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1jr1kzi" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Res32:"><div data-rid="eca0d419-b65e-4f8e-97d9-ceb8185ac3a8" class="r-1tzpcdw"><div data-rid="73191b5a-12dc-4739-8452-edb535f98f59" class="r-jsmykh alchemy-rte"><span style="width:100%"><p>No. The seeds apply gentle pressure without needles or pain. Some people may feel mild tenderness when pressing them, which is normal and part of the calming effect.</p></span></div></div></div></div><div data-rid="d5447da2-fada-4859-8b06-1300f414f023" class="r-mwvlcl" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="18976da4-c40a-439e-957b-f7b3e8dc8336" aria-expanded="false" aria-controls="replo-:Ris32:" tabindex="0" role="button" class="r-1g24kj2"><div data-rid="602336c8-08b7-40d7-8ccd-f16725a0b5e5" class="r-1w01hz0 alchemy-rte"><span style="width:100%"><p>Can everyone use ear seeds?</p></span></div><div data-rid="4813b679-716a-459e-8b52-546e396f8f20" class="r-wyp1nu" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1v0cgd" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Ris32:"><div data-rid="032034c5-0e94-4443-9890-72f122244bcd" class="r-1tfqrc9"><div data-rid="a761de6d-7478-4c8e-bbac-84922147211d" class="r-fnaa0l alchemy-rte"><span style="width:100%"><p>Ear seeds are not suitable during pregnancy or for those with an allergy to gold, nickel, silver, metal or adhesive.  For those with a nickel allergy, please use our nickel free, 100% titanium ear seeds. We also do not recommend children under 8 using our ear seeds, and we recommend that they are supervised. Please keep out of reach from small children.</p></span></div></div></div></div><div data-rid="fe8800db-6e82-4d8d-844f-5902be03417e" class="r-1eobv8y" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="1bb283da-f646-4c23-98b0-0dda7f67a281" aria-expanded="false" aria-controls="replo-:Rms32:" tabindex="0"