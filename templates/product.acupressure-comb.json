    "cc_faq_wPHYzx": {
      "type": "cc-faq",
      "blocks": {
        "faq_bBK86k": {
          "type": "faq",
          "settings": {
            "question": "What is an acupressure comb, and how does it work?",
            "content": "<p>The acupressure comb is a handheld tool designed to apply pressure to specific points on your palm, activating energy pathways that can help relieve stress, tension, and pain. By gripping the comb, you stimulate these points, promoting relaxation and balance in the body.</p><p>The comb also works based on the Gate Control Theory of Pain, where your brain can only focus on a limited number of sensations at once. Squeezing the acupressure comb into your palm helps divert your brain’s attention from pain to the pressure in your hand, offering relief from discomfort.</p>"
          }
        },
        "faq_Jz9hVT": {
          "type": "faq",
          "settings": {
            "question": "What can the acupressure comb be used for?",
            "content": "<p>The comb can be used for labour, anxiety, panic attacks, stress or during painful procedures including dental work, tattoos or injections.</p>"
          }
        },
        "faq_XzNY3t": {
          "type": "faq",
          "settings": {
            "question": "How do I use the acupressure comb during labour or anxiety?",
            "content": "<p>Simply grip the comb tightly in your hand, pressing it into your palm. The comb’s edges stimulate key acupressure points, providing a natural distraction from discomfort or pain, such as during labor, anxiety attacks, or other stressful situations.</p><p>During labour, you can use this technique as soon as you start to feel contractions and right up to you having your baby.</p>"
          }
        },
        "faq_ktNcYe": {
          "type": "faq",
          "settings": {
            "question": "How do I know where to place the comb on my hand?",
            "content": "<p>The comb should stimulate the Laogong pressure point on the center of your palm. When you make a fist, the point is located where the tip of your middle finger meets your palm. The comb should be held horizontally with the teeth facing down into your palm.</p>"
          }
        },
        "faq_QUNtEA": {
          "type": "faq",
          "settings": {
            "question": "What is the comb made of?",
            "content": "<p>The acupressure comb is made of durable, skin-friendly pear wood. It is strong, waterproof and splinter free.</p>"
          }
        }
      },
