    "cc_faq_wPHYzdsdasddx": {
      "type": "cc-faq",
      "blocks": {
        "faq_FH8UT7": {
          "type": "faq",
          "settings": {
            "question": "What are acupressure magnet patches made of?",
            "content": "<p>Acupressure magnet patches consist of a small, 1000 gauss ferrite magnet adhered to the skin with latex-free, medical grade adhesive patches.</p>"
          }
        },
        "faq_WGNh8e": {
          "type": "faq",
          "settings": {
            "question": "How do I use acupressure magnet patches?",
            "content": "<p>To use the patches:</p><ul><li>Clean and dry the area of skin where you'll apply the patch.</li><li>Identify the acupressure point you want to target in our instruction guide.</li><li>Peel the backing and stick the patch directly onto the acupressure point.</li><li>Leave it on for up to 3 days. </li></ul>"
          }
        },
        "faq_yfJE9Q": {
          "type": "faq",
          "settings": {
            "question": "Can I wear acupressure magnet patches all day?",
            "content": "<p>You can typically wear them for up to 3 days. Note that heavy sweating or showering may affect the adhesive. Replace the plaster should it come away from the skin before 3 days. </p>"
          }
        },
        "faq_VVbqyd": {
          "type": "faq",
          "settings": {
            "question": "What conditions can they help with?",
            "content": "<p>Acupressure magnet patches are often used to:<br/><br/>Ease tension (head, back, neck, shoulders and knees)<br/>Encourage a sense of calm and relaxation<br/>Support restful sleep</p>"
          }
        },
        "faq_KbX3TF": {
          "type": "faq",
          "settings": {
            "question": "How long does it take to feel the effects?",
            "content": "<p>This varies by individual. Some people experience relief within minutes, while others may need consistent use over a few days or weeks to notice significant benefits.</p>"
          }
        },
        "faq_dd69Ti": {
          "type": "faq",
          "settings": {
            "question": "Can I reuse acupressure magnet patches?",
            "content": "<p>The adhesive plasters are one-use only, but our product contains 20 replacement plasters so you can reuse the magnets. You can reuse the magnet 3 times before disposing of it. </p>"
          }
        },
        "faq_tFp4wj": {
          "type": "faq",
          "settings": {
            "question": "Can I use acupressure magnet patches during pregnancy?",
            "content": "<p>We do not recommend using our magnet patches if you are pregnant, as there are some points which may induce early labour. </p>"
          }
        },
        "faq_6YGiMd": {
          "type": "faq",
          "settings": {
            "question": "How many magnet patches can I wear at once?",
            "content": "<p>We recommend using patches on all points on the chosen body map. Do not mix and match points from different maps. </p>"
          }
        },
        "faq_BQerHq": {
          "type": "faq",
          "settings": {
            "question": "What is the difference between acupressure magnet patches and ear seeds?",
            "content": "<p>Both stimulate acupressure points, but acupressure magnet patches use magnets and are applied to various parts of the body, while ear seeds are small seeds or beads placed on acupressure points on the ear.</p>"
          }
        },
        "faq_ma88R6": {
          "type": "faq",
          "settings": {
            "question": "Can anyone use magnet patches?",
            "content": "<p>Magnet patches should not be used if pregnant or allergic to metal or adhesive. They are not for people with heart problems, a pacemaker or any medical device or condition affected by magnets. </p>"
          }
        },
        "faq_Jz63kU": {
          "type": "faq",
          "settings": {
            "question": "Can children use magnet patches?",
            "content": "<p>Please keep the magnet patches away from children, as ingesting them can cause severe health issues. </p>"
          }
        }
