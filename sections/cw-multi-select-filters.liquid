<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{% liquid
  assign st = section.settings
  assign cols = section.blocks
%}

{% if cols.size > 0 %}
  {% render 'cw-product-card-styles' %}

  <div class="ms__collections-list cw-filtered-collections" data-cw-filter-section="{{ section.id }}" data-default-state="{{ st.default_state }}">
    <div class="page-width">
      <div class="ms__collections-inner-container">
        {% if st.collection-title != blank %}
          <h2 class="collection-title-ms-block cw-collection-title">{{ st.collection-title }}</h2>
        {% endif %}

        {% assign cw_collection_subtitle = st.collection-subtitle | default: 'Needle free acupressure, facial gua sha and purposeful wellness tools crafted to support stress, sleep, hormones and vitality.' %}
        {% if cw_collection_subtitle != blank %}
          <div class="collection-subtitle-ms-block">{{ cw_collection_subtitle }}</div>
        {% endif %}

        <div class="cw-filter-shell" data-cw-filter-shell>
          <button type="button" class="cw-filter-toggle" data-cw-filter-toggle aria-expanded="false" aria-controls="cw-filter-panel-{{ section.id }}">
            <span>{{ st.filter_label | default: 'Filter by concern' }}</span>
            <svg class="cw-filter-chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M4.375 7.188L10 12.812L15.625 7.188" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div id="cw-filter-panel-{{ section.id }}" class="cw-filter-panel" data-cw-filter-panel hidden>
            <div class="cw-filter-options" role="list">
              {% for ct in cols %}
                {% liquid
                  assign title = ct.settings.filter-title
                  assign filter_handle = title | handleize
                %}
                {% if title != blank %}
                  <button type="button" class="cw-filter-option" data-cw-filter-option data-filter-handle="{{ filter_handle }}" aria-pressed="false">
                    <span class="cw-filter-radio" aria-hidden="true"><span></span></span>
                    <span class="cw-filter-option-label">{{ title }}</span>
                  </button>
                {% endif %}
              {% endfor %}
            </div>

            <button type="button" class="cw-filter-clear" data-cw-filter-clear>
              <span>{{ st.clear_label | default: 'Clear Filters' }}</span>
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M5 5L15 15M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="ms__collections-products-container" data-cw-products-wrapper>
          <div class="cc__collection-grid-items" data-cw-products-grid>
            {% assign rendered_products = '' %}

            {% for ctprod in cols %}
              {% assign colitem = ctprod.settings.pdp_list %}

              {% for product in colitem %}
                {% assign product_token = '|' | append: product.id | append: '|' %}

                {% unless rendered_products contains product_token %}
                  {% assign rendered_products = rendered_products | append: product_token %}

                  {% capture product_filter_handles %}
                    {% for filter_block in cols %}
                      {% liquid
                        assign filter_title = filter_block.settings.filter-title
                        assign filter_handle = filter_title | handleize
                        assign filter_products = filter_block.settings.pdp_list
                      %}
                      {% for filter_product in filter_products %}
                        {% if filter_product.id == product.id %}
                          {{ filter_handle }} 
                          {% break %}
                        {% endif %}
                      {% endfor %}
                    {% endfor %}
                  {% endcapture %}

                  {%- capture wlm_check -%}{%- render 'wlm-product' with product, wlm_is_render: 'yes' -%}{%- endcapture -%}
                  {%- if wlm_check == blank -%}{% continue %}{%- endif -%}

                  {% liquid
                    assign current_variant = product.selected_or_first_available_variant
                    assign product_badges = product.metafields.custom.badges.value
                  %}
                  {% liquid
                      assign product_image_override = blank
                      assign first_product_image = product.images.first
                      assign first_listing_image_url = blank

                      if first_product_image != blank
                        assign first_listing_image_url = first_product_image | image_url: width: 652, height: 652
                      elsif product.featured_image != blank
                        assign first_listing_image_url = product.featured_image | image_url: width: 652, height: 652
                      endif

                      for override_index in (1..9)
                        assign override_product_key = 'product_image_override_' | append: override_index | append: '_product'
                        assign override_image_key = 'product_image_override_' | append: override_index | append: '_image'
                        assign override_product = ctprod.settings[override_product_key]
                        assign override_image = ctprod.settings[override_image_key]

                        if override_product != blank and override_image != blank and override_product.id == product.id
                          assign product_image_override = override_image
                          break
                        endif
                      endfor

                      if product_image_override != blank
                        assign main_image = product_image_override | image_url: width: 652, height: 652
                        assign extra_product_image_limit = 3
                      else
                        assign main_image = first_listing_image_url
                        assign extra_product_image_limit = 4
                      endif
                      assign hover_image = main_image

                      assign cw_card_description = ''
                      if product.metafields.custom.collection_description.value != blank
                        assign cw_card_description = product.metafields.custom.collection_description.value
                      endif

                      if cw_card_description contains '"type"=>"root"' or cw_card_description contains '"children"=>' or cw_card_description contains '{"type"' or cw_card_description contains '=>'
                        assign cw_card_description = ''
                      endif

                      if cw_card_description == blank
                        case product.handle
                          when '24k-gold-plated-ear-seed-kit'
                            assign cw_card_description = 'For anxiety, insomnia, headaches and more.'
                          when 'acupressure-mat-pillow'
                            assign cw_card_description = 'For muscle pain, sleep, and stress.'
                          when 'acupressure-headband'
                            assign cw_card_description = 'For headaches, focus, and stress.'
                          when 'gold-acupressure-magnet-patches'
                            assign cw_card_description = 'For pain, tension, and recovery.'
                          when 'acupressure-foot-mat'
                            assign cw_card_description = 'For foot pain, circulation, and relaxation.'
                          when 'acupressure-comb'
                            assign cw_card_description = 'For scalp tension, headaches, and relaxation.'
                          when 'gold-acupressure-ring'
                            assign cw_card_description = 'For stress relief, focus, and relaxation.'
                          when 'womens-health-gold-ear-seed-kit-bundle'
                            assign cw_card_description = 'For hormones, cycles, and daily balance.'
                          when 'bian-stone-facial-gua-sha'
                            assign cw_card_description = 'For facial tension, glow, and relaxation.'
                          when 'bian-stone-scalp-gua-sha-comb'
                            assign cw_card_description = 'For scalp tension, headaches, and relaxation.'
                        endcase
                      endif

                      if cw_card_description == blank
                        assign cw_card_description = product.description | strip_html | replace: 'BENEFITS:', '' | replace: 'Benefits:', '' | replace: 'benefits:', '' | strip | truncate: 58
                      endif

                      assign current_variant = product.selected_or_first_available_variant
                      assign wpdProductCollectionIds = product.collections | map: 'id'
                    %}

                    {%- capture wpd_attrs -%}
                      data-wpd-product-handle="{{ product.handle }}"
                      data-wpd-variant-id="{{ current_variant.id }}"
                      data-wpd-variant-price="{{ current_variant.price }}"
                      data-wpd-variant-compare-at-price="{{ current_variant.compare_at_price }}"
                      data-wpd-product-collection-ids="{{ wpdProductCollectionIds | join: ',' }}"
                      data-wpd-product-id="{{ product.id }}"
                    {%- endcapture -%}

                    {%- capture gallery_images_raw -%}
                      {{ main_image }}
                      {% if product_image_override != blank and first_listing_image_url != blank and first_listing_image_url != main_image %}
                        {{ first_listing_image_url }}
                      {% endif %}
                      {% for image in product.images offset: 1 limit: extra_product_image_limit %}
                        {% assign current_img_url = image | image_url: width: 652, height: 652 %}
                        {% if current_img_url != main_image and current_img_url != hover_image %}
                          {{ current_img_url }}
                        {% endif %}
                      {% endfor %}
                    {%- endcapture -%}
                    {%- assign gallery_images = gallery_images_raw | newline_to_br | split: '<br />' -%}

                    {% render 'cw-product-card',
                      product: product,
                      description: cw_card_description,
                      gallery_images: gallery_images,
                      badges: product_badges,
                      style_label_text: st.style_label_text,
                      filter_handles: product_filter_handles,
                      wpd_attrs: wpd_attrs
                    %}

                {% endunless %}
              {% endfor %}
            {% endfor %}
          </div>

          <div class="cw-filter-empty" data-cw-filter-empty hidden>
            {{ st.empty_text | default: 'No products found for these filters.' }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} .collection-subtitle-ms-block {
      width: 801px;
      max-width: 100%;
      margin: 0 0 38px;
      color: #937F5C;
      font-family: Montserrat, sans-serif;
      font-size: 23px;
      font-style: normal;
      font-weight: 400;
      text-transform: capitalize;
      line-height: 25.3px;
      letter-spacing: 0.46px;
      text-align: start !important;
      word-wrap: break-word;
    }

    #shopify-section-{{ section.id }} .cw-filter-shell {
      width: 950px;
      max-width: 100%;
      margin: 0 auto 32px;
      color: #695450;
      font-family: Montserrat, sans-serif;
    }

    #shopify-section-{{ section.id }} .cw-filter-toggle {
      width: 100%;
      min-height: 40px;
      padding: 12px 16px;
      background: #F7F3F0;
      border: 1px solid #695450;
      border-radius: 2px;
      color: #695450;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 1px;
      text-transform: capitalize;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cw-filter-toggle[aria-expanded="true"] {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    #shopify-section-{{ section.id }} .cw-filter-chevron {
      flex: 0 0 auto;
      transition: transform 0.2s ease;
    }

    #shopify-section-{{ section.id }} .cw-filter-toggle[aria-expanded="true"] .cw-filter-chevron {
      transform: rotate(180deg);
    }

    #shopify-section-{{ section.id }} .cw-filter-panel {
      width: 100%;
      background: #F7F3F0;
      border: 1px solid #695450;
      border-top: 0;
      border-bottom-left-radius: 2px;
      border-bottom-right-radius: 2px;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cw-filter-option {
      width: 100%;
      min-height: 40px;
      padding: 12px 8px 12px 16px;
      background: #F7F3F0;
      border: 0;
      border-bottom: 1px solid rgba(105, 84, 80, 0.30);
      color: #695450;
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 1px;
      text-transform: capitalize;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cw-filter-option:last-child {
      border-bottom: 1px solid #695450;
    }

    #shopify-section-{{ section.id }} .cw-filter-radio {
      width: 16px;
      height: 16px;
      border: 1px solid #695450;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 16px;
    }

    #shopify-section-{{ section.id }} .cw-filter-radio span {
      width: 10px;
      height: 10px;
      background: #695450;
      border-radius: 999px;
      opacity: 0;
      transform: scale(0.6);
      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    #shopify-section-{{ section.id }} .cw-filter-option.is-active .cw-filter-radio span {
      opacity: 1;
      transform: scale(1);
    }

    #shopify-section-{{ section.id }} .cw-filter-clear {
      width: 100%;
      min-height: 40px;
      padding: 12px 16px;
      background: #695450;
      border: 0;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 1px;
      text-transform: capitalize;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cw-filter-empty {
      width: 100%;
      padding: 24px 16px;
      color: #695450;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      letter-spacing: 0.5px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .cc__collection-grid-items {
      display: grid;
      grid-template-columns: repeat(3, 358px);
      gap: 64px 38px;
      justify-content: center;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .cc__inner-product-details {
      width: 358px;
      position: relative;
      background: #fff;
      overflow: hidden;
      outline: 1px solid #977E57;
      outline-offset: -1px;
      display: block;
    }

    #shopify-section-{{ section.id }} .cc__inner-product-details[hidden] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .cc__inner-product-details-content {
      position: static;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .cc__product-featured-image {
      width: 325px;
      height: 325px;
      position: absolute;
      left: 16px;
      top: 15px;
      margin: 0;
      overflow: visible;
      background: #fff;
    }

    #shopify-section-{{ section.id }} .cw-card-image-link {
      position: absolute;
      inset: 0;
      display: block;
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .cw-card-slider-track {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cc__product-featured-image img,
    #shopify-section-{{ section.id }} .cc__product-featured-image .cw-card-slide {
      display: none;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: contain;
      padding: 0;
      background: #fff;
    }

    #shopify-section-{{ section.id }} .cc__product-featured-image .cw-card-slide.is-active {
      display: block;
    }

    #shopify-section-{{ section.id }} .cw-card-arrow {
      width: 34px;
      height: 34px;
      position: absolute;
      top: 163px;
      z-index: 20;
      padding: 0;
      pointer-events: auto;
      border: 0;
      border-radius: 46px;
      background: #fff;
      color: #695450;
      box-shadow: 2px 2px 2.77px -1.825px rgba(0, 0, 0, 0.16);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .cw-card-arrow--prev {
      left: 0;
    }

    #shopify-section-{{ section.id }} .cw-card-arrow--next {
      right: 0;
    }

    #shopify-section-{{ section.id }} .cw-card-slider-dots {
      position: absolute;
      left: 50%;
      top: 317px;
      z-index: 7;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      transform: translateX(-50%);
    }

    #shopify-section-{{ section.id }} .cw-card-dot {
      width: 6px;
      height: 6px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: #888;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .cw-card-dot.is-active {
      width: 8px;
      height: 8px;
      background: #977E57;
    }

    #shopify-section-{{ section.id }} .cw-card-rating {
      position: absolute;
      left: 16px;
      top: 357px;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #000;
      font-family: Montserrat, sans-serif;
      font-size: 12px;
      font-weight: 600;
      line-height: 19.2px;
      letter-spacing: 1px;
      text-transform: capitalize;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .cw-card-stars {
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0;
      color: #977E57;
      font-size: 15px;
      line-height: 1;
      letter-spacing: -2px;
    }

    #shopify-section-{{ section.id }} .cw-card-rating-text {
      display: inline-flex;
      align-items: center;
    }
    .cw-collection-title{
    font-size: 50px !important;
    }

    #shopify-section-{{ section.id }} .collection-title-ms-block {
      color: {{ section.settings.tcolor }};
      font-size: 25px;
      font-weight: 400;
      line-height: 110%; /* 27.5px */
      letter-spacing: 0.5px;
      text-align: start;
    }

    #shopify-section-{{ section.id }} .cc__product-details h3 {
      position: absolute;
      left: 16px;
      top: 381px;
      z-index: 3;
      width: 326px;
      margin: 0;
      margin-bottom: 14px;
      color: {{ section.settings.tcolor }};
      word-wrap: break-word;
    }

    #shopify-section-{{ section.id }} .cc__fc_product-price {
      position: absolute;
      right: 16px;
      top: 435px;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      min-width: 70px;
      text-align: right;
    }

    #shopify-section-{{ section.id }} .cc__fc_product-price p {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .cc__product-price,
    #shopify-section-{{ section.id }} .cc__product-sale-price {
      color: #695450;
      font-family: Montserrat, sans-serif;
      font-size: 17px;
      font-weight: 700;
      line-height: 18.7px;
      letter-spacing: 0.34px;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .cc__product-orig-price {
      margin-right: 6px;
      color: #695450;
      font-family: Montserrat, sans-serif;
      font-size: 13px;
      font-weight: 600;
      line-height: 1;
      opacity: 0.75;
      text-decoration: line-through;
    }

    #shopify-section-{{ section.id }} .cw-card-actions {
      position: absolute;
      left: 16px;
      top: 461px;
      z-index: 12;
      display: grid;
      grid-template-columns: 153px 153px;
      gap: 18px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .cw-card-add-wrap,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .product__form-container,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .product__form-wrapper,
    #shopify-section-{{ section.id }} .cw-card-add-wrap form {
      width: 153px;
      height: 41px;
      margin: 0;
    }

    #shopify-section-{{ section.id }} .cw-card-add-btn,
    #shopify-section-{{ section.id }} .cw-card-view-btn,
    #shopify-section-{{ section.id }} .cw-card-add-wrap button,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .btn,
    #shopify-section-{{ section.id }} .cw-card-add-wrap input[type="submit"] {
      width: 153px !important;
      height: 41px !important;
      min-height: 41px !important;
      margin: 0 !important;
      padding: 0 10px !important;
      border-radius: 0 !important;
      outline-offset: -1px;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 10px;
      font-family: Montserrat, sans-serif !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      line-height: 15.4px !important;
      letter-spacing: 0.7px !important;
      text-align: center !important;
      text-transform: none !important;
      text-decoration: none !important;
      cursor: pointer;
      box-shadow: none !important;
      appearance: none;
    }

    #shopify-section-{{ section.id }} .cw-card-add-btn,
    #shopify-section-{{ section.id }} .cw-card-add-wrap button,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .btn,
    #shopify-section-{{ section.id }} .cw-card-add-wrap input[type="submit"] {
      background: #695450 !important;
      border: 1px solid #695450 !important;
      color: #fff !important;
    }

    #shopify-section-{{ section.id }} .cw-card-view-btn {
      background: #fff !important;
      border: 1px solid #695450 !important;
      color: #695450 !important;
    }

    #shopify-section-{{ section.id }} .cw-card-add-btn[disabled] {
      opacity: 0.6;
      cursor: not-allowed;
    }

    #shopify-section-{{ section.id }} .cw-card-add-btn.is-loading {
      pointer-events: none;
      opacity: 0.75;
    }

    #shopify-section-{{ section.id }} .cw-card-add-wrap .product__notification,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .product__notification:empty,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .product__form-qty,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .product__quantity,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .quantity,
    #shopify-section-{{ section.id }} .cw-card-add-wrap .shopify-payment-button {
      display: none !important;
      margin: 0 !important;
    }

    #shopify-section-{{ section.id }} .cw-card-description {
      position: absolute;
      left: 16px;
      right: 16px;
      top: 516px;
      z-index: 3;
      color: #695450;
      font-family: Montserrat, sans-serif;
      font-size: 12px;
      font-weight: 400;
      line-height: 13.2px;
      letter-spacing: 0.24px;
      text-align: center;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    #shopify-section-{{ section.id }} .product__notification:empty {
      margin: 0;
    }

    #shopify-section-{{ section.id }} .ms__inner-badges-list {
      display: flex;
      align-items: center;
      gap: 5px;
      position: absolute;
      top: 5px;
      left: 5px;
      z-index: 9;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .ms__inner-badges {
      padding: 4px 10px;
      border-radius: 40px;
      text-transform: uppercase;
      border: 2px solid #977e57;
      color: inherit;
      background-color: #fff;
      font-size: 12px;
    }

