<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{% liquid
  assign st = section.settings
  assign cols = section.blocks
%}

{% if cols.size > 0 %}
  <div class="ms__collections-list cw-filtered-collections" data-cw-filter-section="{{ section.id }}" data-default-state="{{ st.default_state }}">
    <div class="page-width">
      <div class="ms__collections-inner-container">
        {% if st.collection-title != blank %}
          <h2 class="collection-title-ms-block cw-collection-title">{{ st.collection-title }}</h2>
        {% endif %}

        {% assign cw_collection_subtitle = st.collection-subtitle | default: 'Needle free acupressure, facial gua sha and purposeful wellness tools crafted to support stress, sleep, hormones and vitality.' %}
        {% if cw_collection_subtitle != blank %}
          <div class="collection-subtitle-ms-block">{{ cw_collection_subtitle }}</div>
        {% endif %}

        <div class="cw-filter-shell" data-cw-filter-shell>
          <button type="button" class="cw-filter-toggle" data-cw-filter-toggle aria-expanded="false" aria-controls="cw-filter-panel-{{ section.id }}">
            <span>{{ st.filter_label | default: 'Filter by concern' }}</span>
            <svg class="cw-filter-chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M4.375 7.188L10 12.812L15.625 7.188" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div id="cw-filter-panel-{{ section.id }}" class="cw-filter-panel" data-cw-filter-panel hidden>
            <div class="cw-filter-options" role="list">
              {% for ct in cols %}
                {% liquid
                  assign title = ct.settings.filter-title
                  assign filter_handle = title | handleize
                %}
                {% if title != blank %}
                  <button type="button" class="cw-filter-option" data-cw-filter-option data-filter-handle="{{ filter_handle }}" aria-pressed="false">
                    <span class="cw-filter-radio" aria-hidden="true"><span></span></span>
                    <span class="cw-filter-option-label">{{ title }}</span>
                  </button>
                {% endif %}
              {% endfor %}
            </div>

            <button type="button" class="cw-filter-clear" data-cw-filter-clear>
              <span>{{ st.clear_label | default: 'Clear Filters' }}</span>
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M5 5L15 15M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="ms__collections-products-container" data-cw-products-wrapper>
          <div class="cc__collection-grid-items" data-cw-products-grid>
            {% assign rendered_products = '' %}

            {% for ctprod in cols %}
              {% assign colitem = ctprod.settings.pdp_list %}

              {% for product in colitem %}
                {% assign product_token = '|' | append: product.id | append: '|' %}

                {% unless rendered_products contains product_token %}
                  {% assign rendered_products = rendered_products | append: product_token %}

                  {% capture product_filter_handles %}
                    {% for filter_block in cols %}
                      {% liquid
                        assign filter_title = filter_block.settings.filter-title
                        assign filter_handle = filter_title | handleize
                        assign filter_products = filter_block.settings.pdp_list
                      %}
                      {% for filter_product in filter_products %}
                        {% if filter_product.id == product.id %}
                          {{ filter_handle }} 
                          {% break %}
                        {% endif %}
                      {% endfor %}
                    {% endfor %}
                  {% endcapture %}

                  {%- capture wlm_check -%}{%- render 'wlm-product' with product, wlm_is_render: 'yes' -%}{%- endcapture -%}
                  {%- if wlm_check == blank -%}{% continue %}{%- endif -%}

                  {% liquid
                    assign current_variant = product.selected_or_first_available_variant
                    assign product_badges = product.metafields.custom.badges.value
                  %}

                  <div class="cc__inner-product-details cw-collection-list-single-tab-content-column" data-cw-product-card data-filter-handles="{{ product_filter_handles | strip }}">
                    <a
                      href="{{ product.url }}"
                      class="cw-card-overlay-link"
                      aria-label="{{ product.title | escape }}"
                    ></a>
                    {% liquid
                      assign product_image_override = blank
                      assign first_product_image = product.images.first
                      assign first_listing_image_url = blank

                      if first_product_image != blank
                        assign first_listing_image_url = first_product_image | image_url: width: 652, height: 652
                      elsif product.featured_image != blank
                        assign first_listing_image_url = product.featured_image | image_url: width: 652, height: 652
                      endif

                      for override_index in (1..9)
                        assign override_product_key = 'product_image_override_' | append: override_index | append: '_product'
                        assign override_image_key = 'product_image_override_' | append: override_index | append: '_image'
                        assign override_product = ctprod.settings[override_product_key]
                        assign override_image = ctprod.settings[override_image_key]

                        if override_product != blank and override_image != blank and override_product.id == product.id
                          assign product_image_override = override_image
                          break
                        endif
                      endfor

                      if product_image_override != blank
                        assign main_image = product_image_override | image_url: width: 652, height: 652
                        assign extra_product_image_limit = 3
                      else
                        assign main_image = first_listing_image_url
                        assign extra_product_image_limit = 4
                      endif
                      assign hover_image = main_image

                      assign cw_card_description = ''
                      if product.metafields.custom.collection_description.value != blank
                        assign cw_card_description = product.metafields.custom.collection_description.value
                      endif

                      if cw_card_description contains '"type"=>"root"' or cw_card_description contains '"children"=>' or cw_card_description contains '{"type"' or cw_card_description contains '=>'
                        assign cw_card_description = ''
                      endif

                      if cw_card_description == blank
                        case product.handle
                          when '24k-gold-plated-ear-seed-kit'
                            assign cw_card_description = 'For anxiety, insomnia, headaches and more.'
                          when 'acupressure-mat-pillow'
                            assign cw_card_description = 'For muscle pain, sleep, and stress.'
                          when 'acupressure-headband'
                            assign cw_card_description = 'For headaches, focus, and stress.'
                          when 'gold-acupressure-magnet-patches'
                            assign cw_card_description = 'For pain, tension, and recovery.'
                          when 'acupressure-foot-mat'
                            assign cw_card_description = 'For foot pain, circulation, and relaxation.'
                          when 'acupressure-comb'
                            assign cw_card_description = 'For scalp tension, headaches, and relaxation.'
                          when 'gold-acupressure-ring'
                            assign cw_card_description = 'For stress relief, focus, and relaxation.'
                          when 'womens-health-gold-ear-seed-kit-bundle'
                            assign cw_card_description = 'For hormones, cycles, and daily balance.'
                          when 'bian-stone-facial-gua-sha'
                            assign cw_card_description = 'For facial tension, glow, and relaxation.'
                          when 'bian-stone-scalp-gua-sha-comb'
                            assign cw_card_description = 'For scalp tension, headaches, and relaxation.'
                        endcase
                      endif

                      if cw_card_description == blank
                        assign cw_card_description = product.description | strip_html | replace: 'BENEFITS:', '' | replace: 'Benefits:', '' | replace: 'benefits:', '' | strip | truncate: 58
                      endif

                      assign current_variant = product.selected_or_first_available_variant
                      assign wpdProductCollectionIds = product.collections | map: 'id'
                    %}

                    {%- capture wpd_attrs -%}
                      data-wpd-product-handle="{{ product.handle }}"
                      data-wpd-variant-id="{{ current_variant.id }}"
                      data-wpd-variant-price="{{ current_variant.price }}"
                      data-wpd-variant-compare-at-price="{{ current_variant.compare_at_price }}"
                      data-wpd-product-collection-ids="{{ wpdProductCollectionIds | join: ',' }}"
                      data-wpd-product-id="{{ product.id }}"
                    {%- endcapture -%}

                    <a class="cw-product-card__image-wrapper swiper product-slider-{{ product.id }}" href="{{ product.url }}">
                      {% if product_badges != blank %}
                        <div class="ms__inner-badges-list">
                          {% for item in product_badges %}
                            <div class="ms__inner-badges">{{ item }}</div>
                          {% endfor %}
                        </div>
                      {% endif %}

                      <div class="swiper-wrapper">
                        <div class="swiper-slide cw-easthealing-collection-product-slide">
                          <div class="product-card__image-wrapper">
                            <img
                              src="{{ main_image }}"
                              width="{{ product.featured_media.width }}"
                              height="{{ product.featured_media.height }}"
                              alt="{{ product.title | escape }}"
                              class="main-img"
                              loading="lazy"
                            >
                          </div>
                        </div>

                        {% if product_image_override != blank and first_listing_image_url != blank and first_listing_image_url != main_image %}
                          <div class="swiper-slide cw-easthealing-collection-product-slide">
                            <img
                              src="{{ first_listing_image_url }}"
                              alt="{{ product.title | escape }}"
                              loading="lazy"
                            >
                          </div>
                        {% endif %}

                        {% for image in product.images offset: 1 limit: extra_product_image_limit %}
                          {% assign current_img_url = image | image_url: width: 652, height: 652 %}
                          {% if current_img_url != main_image and current_img_url != hover_image %}
                            <div class="swiper-slide cw-easthealing-collection-product-slide">
                              <img
                                src="{{ image | img_url: '652x652', crop: 'center' }}"
                                alt="{{ product.title | escape }}"
                                loading="lazy"
                              >
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>

                      <div class="swiper-pagination cw-easthealing-pagination"></div>
                      <div class="swiper-button-next cw-easthealing-swiper-button-next"><img src="https://cdn.shopify.com/s/files/1/0588/4742/8796/files/cw-easthealing-next-arrow.png?v=1772010489" alt="next"></div>
                      <div class="swiper-button-prev cw-easthealing-swiper-button-prev"><img src="https://cdn.shopify.com/s/files/1/0588/4742/8796/files/cw-easthealing-prev-arrow.png?v=1772010488" alt="prev"></div>
                    </a>

                    <div class="cw-easthealing-collection-productcard-rating-container">
                      {%- liquid
                        assign rating_decimal = 0
                        if product.metafields.reviews.rating.value != blank
                          assign rating_value = product.metafields.reviews.rating.value
                          assign rating_decimal = rating_value.rating | round: 1
                          assign review_count = product.metafields.reviews.rating_count
                        else
                          assign rating_decimal = 4.9
                          assign review_count = 'thousands'
                        endif
                      -%}

                      <div class="r-cw-easthealing-collection-productcard-rating-box">
                        <div class="rating-stars">
                          <img src="https://cdn.shopify.com/s/files/1/0588/4742/8796/files/rating_star_img.png?v=1772017048" alt="star" class="rating-star-img">
                        </div>

                        <div class="cw-easthealing-collection-productcard-rating-txt">
                          <span>
                            <p>Rated {{ rating_decimal }}/5 </p>
                          </span>
                        </div>
                      </div>
                    </div>

                    <div class="cw-collection-list-single-product-title">
                      <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title | downcase }}</a>
                    </div>

                    {%- liquid
                      # Show a dynamic variant/color selector for any product that has more than one variant.
                      # We render one swatch per variant, paint it when we can detect a known color name,
                      # and fall back to a labeled pill otherwise.
                      assign product_variants = product.variants
                      assign has_multiple_variants = false
                      if product_variants.size > 1
                        assign has_multiple_variants = true
                      endif
                    -%}

                    {% if has_multiple_variants %}
                      {%- comment -%} Style indicator label above the swatches. The variant name updates via JS. {%- endcomment -%}
                      <div class="cw-card-style-label" data-cw-style-label>
                        {{ st.style_label_text | default: 'choose your style' }} - <span data-cw-style-name>{{ current_variant.title }}</span>
                      </div>
                    {% endif %}

                    <div class="cw-card-price-row" style="{% unless has_multiple_variants %} justify-content: end !important; {% endunless %}">
                      {% if has_multiple_variants %}
                        <div class="cw-card-colors" role="listbox" aria-label="Select variant" data-cw-card-colors>
                          {% for variant in product_variants %}
                            {%- liquid
                              # Try to detect a known color from the variant title to paint the swatch.
                              assign variant_title_downcase = variant.title | downcase
                              assign swatch_color = ''
                              assign has_swatch_color = false

                              if variant_title_downcase contains 'gold'
                                assign swatch_color = '#D5C9BE'
                                assign has_swatch_color = true
                              elsif variant_title_downcase contains 'silver'
                                assign swatch_color = '#D3D2D9'
                                assign has_swatch_color = true
                              elsif variant_title_downcase contains 'nickel'
                                assign swatch_color = '#4B3E46'
                                assign has_swatch_color = true
                              elsif variant_title_downcase contains 'gold crystal'
                                assign swatch_color = '#866858'
                                assign has_swatch_color = true
                              elsif variant_title_downcase contains 'silver crystal'
                                assign swatch_color = '#C5C9D1'
                                assign has_swatch_color = true
                              elsif variant_title_downcase contains 'pearl'
                                assign swatch_color = '#C4BFC5'
                                assign has_swatch_color = true
                              endif

                              # Mark the currently selected variant as active by default.
                              assign is_current_variant = false
                              if variant.id == current_variant.id
                                assign is_current_variant = true
                              endif
                            -%}

                            <button
                              class="cw-card-color{% if is_current_variant %} is-active{% endif %}{% unless has_swatch_color %} cw-card-color--label{% endunless %}{% unless variant.available %} cw-card-color--sold-out{% endunless %}"
                              type="button"
                              role="option"
                              aria-selected="{% if is_current_variant %}true{% else %}false{% endif %}"
                              data-cw-color-option
                              data-variant-id="{{ variant.id }}"
                              data-variant-title="{{ variant.title | escape }}"
                              data-variant-available="{{ variant.available }}"
                              data-variant-price="{{ variant.price }}"
                              data-variant-compare-at-price="{{ variant.compare_at_price }}"
                              {% if has_swatch_color %}style="--cw-card-color: {{ swatch_color }};"{% endif %}
                              title="{{ variant.title | escape }}"
                            >
                              {% if has_swatch_color %}
                                <span class="visually-hidden">{{ variant.title }}</span>
                              {% else %}
                                <span class="cw-card-color-text">{{ variant.title }}</span>
                              {% endif %}
                            </button>
                          {% endfor %}
                        </div>
                      {% endif %}

                      <div class="cw-collection-list-single-product-price">
                        {% if product.handle == 'stress-relief-kit' or product.handle == 'pain-relief-kit' %}
                          <p class="price-item--compare" data-cw-compare-price>{{ current_variant.compare_at_price | money }}</p>
                          <p {{ wpd_attrs }} data-cw-current-price>{{ current_variant.price | money }}</p>
                        {% else %}
                          <p {{ wpd_attrs }} data-cw-current-price>{{ current_variant.price | money }}</p>
                        {% endif %}
                      </div>
                    </div>

                    <div class="cw-collection-list-single-product-buttons">
                      {% if current_variant.available %}
                        <a href="#" class="btn-primary" data-cw-card-add-to-cart data-variant-id="{{ current_variant.id }}" data-quantity="1">Add to cart</a>
                      {% else %}
                        <a href="#" class="btn-primary cw-card-out-of-stock" data-cw-card-add-to-cart data-variant-id="{{ current_variant.id }}" data-quantity="1" aria-disabled="true" tabindex="-1">Out of stock</a>
                      {% endif %}
                      <a href="{{ product.url }}" class="btn-secondary">View</a>
                    </div>

                    <div class="cw-collection-list-single-product-description">
                      {% if cw_card_description != blank %}
                        <p>{{ cw_card_description }}</p>
                      {% endif %}
                    </div>
                  </div>

                {% endunless %}
              {% endfor %}
            {% endfor %}
          </div>

          <div class="cw-filter-empty" data-cw-filter-empty hidden>
            {{ st.empty_text | default: 'No products found for these filters.' }}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} .collection-subtitle-ms-block {
      width: 801px;
      max-width: 100%;
      margin: 0 0 38px;
      color: #937F5C;
      font-family: Montserrat, sans-serif;
      font-size: 23px;
      font-style: normal;
      font-weight: 400;
      text-transform: capitalize;
      line-height: 25.3px;
      letter-spacing: 0.46px;
      text-align: start !important;
      word-wrap: break-word;
    }

    #shopify-section-{{ section.id }} .cw-filter-shell {
      width: 950px;
      max-width: 100%;
      margin: 0 auto 32px;
      color: #695450;
      font-family: Montserrat, sans-serif;
    }

    #shopify-section-{{ section.id }} .cw-filter-toggle {
      width: 100%;
      min-height: 40px;
      padding: 12px 16px;
      background: #F7F3F0;
      border: 1px solid #695450;
      border-radius: 2px;
      color: #695450;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 1px;
      text-transform: capitalize;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cw-filter-toggle[aria-expanded="true"] {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }

    #shopify-section-{{ section.id }} .cw-filter-chevron {
      flex: 0 0 auto;
      transition: transform 0.2s ease;
    }

    #shopify-section-{{ section.id }} .cw-filter-toggle[aria-expanded="true"] .cw-filter-chevron {
      transform: rotate(180deg);
    }

    #shopify-section-{{ section.id }} .cw-filter-panel {
      width: 100%;
      background: #F7F3F0;
      border: 1px solid #695450;
      border-top: 0;
      border-bottom-left-radius: 2px;
      border-bottom-right-radius: 2px;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cw-filter-option {
      width: 100%;
      min-height: 40px;
      padding: 12px 8px 12px 16px;
      background: #F7F3F0;
      border: 0;
      border-bottom: 1px solid rgba(105, 84, 80, 0.30);
      color: #695450;
      display: inline-flex;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 1px;
      text-transform: capitalize;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cw-filter-option:last-child {
      border-bottom: 1px solid #695450;
    }

    #shopify-section-{{ section.id }} .cw-filter-radio {
      width: 16px;
      height: 16px;
      border: 1px solid #695450;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 16px;
    }

    #shopify-section-{{ section.id }} .cw-filter-radio span {
      width: 10px;
      height: 10px;
      background: #695450;
      border-radius: 999px;
      opacity: 0;
      transform: scale(0.6);
      transition: opacity 0.15s ease, transform 0.15s ease;
    }

    #shopify-section-{{ section.id }} .cw-filter-option.is-active .cw-filter-radio span {
      opacity: 1;
      transform: scale(1);
    }

    #shopify-section-{{ section.id }} .cw-filter-clear {
      width: 100%;
      min-height: 40px;
      padding: 12px 16px;
      background: #695450;
      border: 0;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      cursor: pointer;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 1px;
      text-transform: capitalize;
      text-align: left;
    }

    #shopify-section-{{ section.id }} .cw-filter-empty {
      width: 100%;
      padding: 24px 16px;
      color: #695450;
      font-family: Montserrat, sans-serif;
      font-size: 14px;
      letter-spacing: 0.5px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .cc__collection-grid-items {
      display: grid;
      grid-template-columns: repeat(3, 358px);
      gap: 64px 38px;
      justify-content: center;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .cc__inner-product-details {
      width: 358px;
      position: relative;
      background: #fff;
      overflow: hidden;
      outline: 1px solid #977E57;
      outline-offset: -1px;
      display: block;
    }

    #shopify-section-{{ section.id }} .cc__inner-product-details[hidden] {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .cc__inner-product-details-content {
      position: static;
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .cc__product-featured-image {
      width: 325px;
      height: 325px;
      position: absolute;
      left: 16px;
      top: 15px;
      margin: 0;
      overflow: visible;
      background: #fff;
    }

    #shopify-section-{{ section.id }} .cw-card-image-link {
      position: absolute;
      inset: 0;
      display: block;
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .cw-card-slider-track {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cc__product-featured-image img,
    #shopify-section-{{ section.id }} .cc__product-featured-image .cw-card-slide {
      display: none;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      object-fit: contain;
      padding: 0;
      background: #fff;
    }

    #shopify-section-{{ section.id }} .cc__product-featured-image .cw-card-slide.is-active {
      display: block;
    }

    #shopify-section-{{ section.id }} .cw-card-arrow {
      width: 34px;
      height: 34px;
      position: absolute;
      top: 163px;
      z-index: 20;
      padding: 0;
      pointer-events: auto;
      border: 0;
      border-radius: 46px;
      background: #fff;
      color: #695450;
      box-shadow: 2px 2px 2.77px -1.825px rgba(0, 0, 0, 0.16);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .cw-card-arrow--prev {
      left: 0;
    }

    #shopify-section-{{ section.id }} .cw-card-arrow--next {
      right: 0;
    }

    #shopify-section-{{ section.id }} .cw-card-slider-dots {
      position: absolute;
      left: 50%;
      top: 317px;
      z-index: 7;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      transform: translateX(-50%);
    }

    #shopify-section-{{ section.id }} .cw-card-dot {
      width: 6px;
      height: 6px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: #888;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .cw-card-dot.is-active {
      width: 8px;
      height: 8px;
