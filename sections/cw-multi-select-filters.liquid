  <script>
    (function () {
      const root = document.querySelector('[data-cw-filter-section="{{ section.id }}"]');
      if (!root) return;

      const toggle = root.querySelector('[data-cw-filter-toggle]');
      const panel = root.querySelector('[data-cw-filter-panel]');
      const options = Array.from(root.querySelectorAll('[data-cw-filter-option]'));
      const clear = root.querySelector('[data-cw-filter-clear]');
      const cards = Array.from(root.querySelectorAll('[data-cw-product-card]'));
      const empty = root.querySelector('[data-cw-filter-empty]');
      const defaultState = root.dataset.defaultState || 'first';

      function getSelectedHandles() {
        return options
          .filter((option) => option.classList.contains('is-active'))
          .map((option) => option.dataset.filterHandle)
          .filter(Boolean);
      }

      function setPanelState(isOpen) {
        if (!toggle || !panel) return;
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        panel.hidden = !isOpen;
      }

      function setOptionState(option, isActive) {
        option.classList.toggle('is-active', isActive);
        option.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }

      function updateProducts(updateUrl) {
        const selectedHandles = getSelectedHandles();
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardFilters = (card.dataset.filterHandles || '').split(' ').filter(Boolean);
          const shouldShow = selectedHandles.length === 0 || selectedHandles.some((handle) => cardFilters.includes(handle));

          card.hidden = !shouldShow;
          if (shouldShow) visibleCount += 1;
        });

        if (empty) {
          empty.hidden = visibleCount > 0;
        }

        if (updateUrl) {
          const url = new URL(window.location.href);
          if (selectedHandles.length > 0) {
            url.searchParams.set('filter', selectedHandles.join(','));
          } else {
            url.searchParams.delete('filter');
          }
          window.history.pushState({ cwFilters: selectedHandles }, '', url.toString());
        }
      }

      function applyHandles(handles, updateUrl) {
        options.forEach((option) => {
          setOptionState(option, handles.includes(option.dataset.filterHandle));
        });
        updateProducts(updateUrl);
      }

      function getInitialHandles() {
        const url = new URL(window.location.href);
        const filterParam = url.searchParams.get('filter');

        if (filterParam) {
          return filterParam.split(',').map((item) => item.trim()).filter(Boolean);
        }

        const legacyIndex = window.location.href.indexOf('&');
        if (legacyIndex !== -1) {
          const legacyHandle = window.location.href.substring(legacyIndex + 1).split(/[?#]/)[0];
          if (legacyHandle) return [legacyHandle];
        }

        if (defaultState === 'first' && options[0]) {
          return [options[0].dataset.filterHandle];
        }

        return [];
      }

      if (toggle && panel) {
        toggle.addEventListener('click', function () {
          setPanelState(toggle.getAttribute('aria-expanded') !== 'true');
        });
      }

      options.forEach((option) => {
        option.addEventListener('click', function () {
          setOptionState(option, !option.classList.contains('is-active'));
          updateProducts(true);
        });
      });

      if (clear) {
        clear.addEventListener('click', function () {
          applyHandles([], true);
        });
      }

      window.addEventListener('popstate', function () {
        applyHandles(getInitialHandles(), false);
      });

      applyHandles(getInitialHandles(), false);
    })();
  </script>

  <script>
    (function () {
      const root = document.querySelector('[data-cw-filter-section="{{ section.id }}"]');
      if (!root) return;

      // Handle variant/color swatch selection with event delegation so it keeps
      // working after filtering hides/shows cards.
      root.addEventListener('click', function (event) {
        const colorOption = event.target.closest('[data-cw-color-option]');
        if (!colorOption || !root.contains(colorOption)) return;

        // Stop the full-card overlay link from navigating away.
        event.preventDefault();
        event.stopPropagation();

        const card = colorOption.closest('[data-cw-product-card]');
        if (!card) return;

        const swatches = Array.from(card.querySelectorAll('[data-cw-color-option]'));
        const addToCartButton = card.querySelector('[data-cw-card-add-to-cart]');
        const styleNameEl = card.querySelector('[data-cw-style-name]');

        // Update the active state on every swatch of this card.
        swatches.forEach(function (item) {
          item.classList.remove('is-active');
          item.setAttribute('aria-selected', 'false');
        });
        colorOption.classList.add('is-active');
        colorOption.setAttribute('aria-selected', 'true');

        // Swap the variant id used by the add-to-cart button.
        const variantId = colorOption.dataset.variantId;
        if (addToCartButton && variantId) {
          addToCartButton.setAttribute('data-variant-id', variantId);
        }

        // Update the style indicator label with the selected variant title.
        const variantTitle = colorOption.dataset.variantTitle;
        if (styleNameEl && variantTitle) {
          styleNameEl.textContent = variantTitle;
        }

        // Reflect variant availability on the add-to-cart button.
        if (addToCartButton) {
          const isAvailable = colorOption.dataset.variantAvailable === 'true';
          if (isAvailable) {
            addToCartButton.classList.remove('cw-card-out-of-stock');
            addToCartButton.removeAttribute('aria-disabled');
            addToCartButton.removeAttribute('tabindex');
            if (addToCartButton.dataset.cwLabel) {
              addToCartButton.textContent = addToCartButton.dataset.cwLabel;
            }
          } else {
            if (!addToCartButton.dataset.cwLabel) {
              addToCartButton.dataset.cwLabel = addToCartButton.textContent;
            }
            addToCartButton.classList.add('cw-card-out-of-stock');
            addToCartButton.setAttribute('aria-disabled', 'true');
            addToCartButton.setAttribute('tabindex', '-1');
            addToCartButton.textContent = 'Out of stock';
          }
        }
      });
    })();
  </script>

  <script>
  (function () {
    const root = document.querySelector('[data-cw-filter-section="{{ section.id }}"]');
    if (!root) return;

    const buttons = Array.from(root.querySelectorAll('[data-cw-card-add-to-cart]'));

    // Force the drawer out of its "empty" visual state (needed right after the
    // first item is added, before the theme finishes re-rendering).
    function forceVisibleCart() {
      const cartForm = document.querySelector('.cart-drawer.cart-drawer--empty');
      const content = document.querySelector('.cart-drawer__content');

      if (cartForm) {
        cartForm.classList.remove('cart-drawer--empty');
      }
      if (content) {
        content.style.display = 'block';
        content.style.height = 'auto';
      }
    }

    // Open the cart drawer using this theme's native API, with a safe fallback
    // to clicking the header cart toggle.
    async function openThemeCartDrawer() {
      if (window.theme && window.theme.sections) {
        try {
          const instances = await window.theme.sections.getInstances('cart-drawer');
          const cartDrawer = instances[0];

          if (cartDrawer) {
            const cartData = await fetch('/cart.js').then((r) => r.json());

            if (cartData.item_count > 0) {
              forceVisibleCart();
              await cartDrawer.refresh();
              forceVisibleCart();
            }

            cartDrawer._openCartDrawer({
              preventDefault: function () {}
            });
            return;
          }
        } catch (err) {
          console.error('Cart drawer open error:', err);
        }
      }

      // Fallback: click the header cart toggle so the theme opens it for us.
      const toggle = document.querySelector('.ajax-cart__toggle');
      if (toggle) toggle.click();
    }

    buttons.forEach((button) => {
      button.addEventListener('click', async function (event) {
        event.preventDefault();
        event.stopPropagation();

        if (button.getAttribute('aria-disabled') === 'true' || button.classList.contains('is-loading')) return;

        const variantId = button.getAttribute('data-variant-id');
        const quantity = Number(button.getAttribute('data-quantity') || 1);
        const sellingPlanId = button.getAttribute('data-selling-plan-id');

        if (!variantId) {
          console.error('Variant ID not found');
          return;
        }

        const originalText = button.textContent;
        button.classList.add('is-loading');
        button.textContent = 'Adding...';

        try {
          const item = { id: Number(variantId), quantity: quantity };
          if (sellingPlanId) item.selling_plan = Number(sellingPlanId);

          const addResponse = await fetch(window.Shopify && Shopify.routes ? Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ items: [item] })
          });

          if (!addResponse.ok) {
            throw new Error('Add to cart failed');
          }

          await openThemeCartDrawer();
        } catch (error) {
          console.error('Error adding to cart:', error);
        } finally {
          button.classList.remove('is-loading');
          button.textContent = originalText;
        }
      });
    });
  })();
</script>

  <script>
    (function () {
      const root = document.querySelector('[data-cw-filter-section="{{ section.id }}"]');
      if (!root) return;

      const sliders = Array.from(root.querySelectorAll('[data-cw-card-slider]'));

      sliders.forEach((slider) => {
        const slides = Array.from(slider.querySelectorAll('[data-cw-card-slide]'));
        const dots = Array.from(slider.querySelectorAll('[data-cw-card-dot]'));
        const prev = slider.querySelector('[data-cw-card-prev]');
        const next = slider.querySelector('[data-cw-card-next]');
        let activeIndex = 0;

        if (slides.length <= 1) {
          if (prev) prev.hidden = true;
          if (next) next.hidden = true;
          return;
        }

        function showSlide(index) {
          activeIndex = (index + slides.length) % slides.length;

          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle('is-active', slideIndex === activeIndex);
          });

          dots.forEach((dot, dotIndex) => {
            dot.classList.toggle('is-active', dotIndex === activeIndex);
          });
        }

        if (prev) {
          prev.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            showSlide(activeIndex - 1);
          });
        }

        if (next) {
          next.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            showSlide(activeIndex + 1);
          });
        }

        dots.forEach((dot, dotIndex) => {
          dot.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            showSlide(dotIndex);
          });
        });

        showSlide(0);
      });
    })();
  </script>



  <script>
    (function () {
      const root = document.querySelector('[data-cw-filter-section="{{ section.id }}"]');
      if (!root) return;

      function matchCardTitleHeights() {
        const cards = Array.from(root.querySelectorAll('[data-cw-product-card]:not([hidden])'));
        const titles = cards
          .map((card) => card.querySelector('.cw-collection-list-single-product-title'))
          .filter(Boolean);

        titles.forEach((title) => {
          title.style.height = 'auto';
        });

        if (!cards.length || !titles.length) return;

        if (window.innerWidth <= 768) {
          let maxHeight = 0;
          titles.forEach((title) => {
            maxHeight = Math.max(maxHeight, title.offsetHeight);
          });
          titles.forEach((title) => {
            title.style.height = maxHeight + 'px';
          });
          return;
        }

        const rows = new Map();
        cards.forEach((card) => {
          const title = card.querySelector('.cw-collection-list-single-product-title');
          if (!title) return;
          const top = Math.round(card.offsetTop);
          if (!rows.has(top)) rows.set(top, []);
          rows.get(top).push(title);
        });

        rows.forEach((rowTitles) => {
          let maxHeight = 0;
          rowTitles.forEach((title) => {
            maxHeight = Math.max(maxHeight, title.offsetHeight);
          });
          rowTitles.forEach((title) => {
            title.style.height = maxHeight + 'px';
          });
        });
      }

      document.addEventListener('DOMContentLoaded', matchCardTitleHeights);
      window.addEventListener('resize', function () {
        setTimeout(matchCardTitleHeights, 250);
      });
      root.addEventListener('click', function (event) {
        if (event.target.closest('[data-cw-filter-option]') || event.target.closest('[data-cw-filter-clear]')) {
          setTimeout(matchCardTitleHeights, 80);
        }
      });
    })();
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof Swiper === 'undefined') return;

      document.querySelectorAll('#shopify-section-{{ section.id }} .cw-product-card__image-wrapper.swiper').forEach(function (slider) {
        if (slider.classList.contains('swiper-initialized')) return;

        new Swiper(slider, {
          slidesPerView: 1,
          spaceBetween: 5,
          loop: false,
          pagination: {
            el: slider.querySelector('.cw-easthealing-pagination'),
            clickable: true
          },
          navigation: {
            nextEl: slider.querySelector('.cw-easthealing-swiper-button-next'),
            prevEl: slider.querySelector('.cw-easthealing-swiper-button-prev')
          }
        });
      });
    });
  </script>
