<div class="page-width">
    <div class="cc__image-badge-text">
        <div class="cc__image-badge-imagecontent">
            {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | img_url: 'master' }}" />
            {% else %}
            {{ 'image' | placeholder_svg_tag }}
            {% endif %}
            {% if section.settings.badge != blank %}
            <img class="cc__image-badge-icon" src="{{ section.settings.badge | img_url: 'master' }}" />
            {% endif %}
        </div>
        <div class="cc__image-badge-textcontent">
            {% if section.settings.preheading != blank %}
            <p class="cc__image-badge-preheading">{{ section.settings.preheading }}</p>
            {% endif %}
            {% if section.settings.title != blank %}
            <{{ section.settings.htags }} class="cc__image-badge-heading">{{ section.settings.title }}</{{ section.settings.htags }}>
            {% endif %}
            {% if section.settings.content %}
            <div class="cc__image-badge-content">
                {{ section.settings.content }}
            </div>
            {% endif %}
        </div>
    </div>
</div>
<style>
    #shopify-section-{{ section.id }}{
        background-color: {{ section.settings.bgcolor }};
        padding-top: {{ section.settings.mpadtop | append: 'px'}};
        padding-bottom: {{ section.settings.mpadbot | append: 'px'}};
        overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cc__image-badge-text{
        display: flex;
        flex-direction: column;
    }

    #shopify-section-{{ section.id }} .cc__image-badge-textcontent{
        padding: 20px 0px;
    }

    #shopify-section-{{ section.id }} .cc__image-badge-preheading{
        margin-bottom: 10px;
        font-weight: bold;
        font-size: {{ section.settings.mphsize | append: 'px' }};
        color: #695450;
    }

    #shopify-section-{{ section.id }} .cc__image-badge-heading{
        margin-bottom: 4px;
        font-size: {{ section.settings.mhsize | append: 'px' }};
        line-height: 1.5;
        color: #695450;
    }

    #shopify-section-{{ section.id }} .cc__image-badge-content{
        font-size: {{ section.settings.mcsize | append: 'px' }};
        color: #695450;
    }

    #shopify-section-{{ section.id }} img.cc__image-badge-icon {
        width: 85px;
        height: 110px;
        object-fit: cover;
        margin-top: -70px;
        margin-left: -10px;
    }

    @media screen and (min-width: 750px){
        #shopify-section-{{ section.id }} img.cc__image-badge-icon {
            width: 122px;
            height: 156px;
        }
        #shopify-section-{{ section.id }}{
            padding-top: {{ section.settings.dpadtop | append: 'px' }};
            padding-bottom: {{ section.settings.dpadbot | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .cc__image-badge-text{
            flex-direction: {{ section.settings.image_position  }};
        }

        #shopify-section-{{ section.id }} .cc__image-badge-textcontent{
            padding: 46px 30px;
        }

        #shopify-section-{{ section.id }} .cc__image-badge-preheading{
            font-size: {{ section.settings.dphsize | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .cc__image-badge-heading{
            font-size: {{ section.settings.dhsize | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .cc__image-badge-content{
            font-size: {{ section.settings.dcsize | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .cc__image-badge-imagecontent,
        #shopify-section-{{ section.id }} .cc__image-badge-textcontent{
            width: 50%;
        }

        #shopify-section-{{ section.id }} .cc__image-badge-textcontent{
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
    }

    @media screen and (min-width: 900px){
        #shopify-section-{{ section.id }} .cc__image-badge-textcontent{
            {% if section.settings.image_position == 'row' %}
            padding: 46px 30px 46px 90px;
            {% else %}
            padding: 46px 90px 46px 30px;
            {% endif %}
        }
    }
</style>
{% schema %}
    {
