                "options": [
                    {
                        "value": "h1",
                        "label": "H1"
                    },
                    {
                        "value": "h2",
                        "label": "H2"
                    },
                    {
                        "value": "h3",
                        "label": "H3"
                    },
                    {
                        "value": "h4",
                        "label": "H4"
                    },
                    {
                        "value": "h5",
                        "label": "H5"
                    },
                    {
                        "value": "h6",
                        "label": "H6"
                    }
                ]
            },
            {
                "type" :"number",
                "id": "dhsize",
                "label" : "Heading size (desktop)",
                "default": 48,
                "info" :"unit in px"
            },
            {
                "type" :"number",
                "id": "mhsize",
                "label" : "Heading size (mobile)",
                "default": 28,
                "info" :"unit in px"
