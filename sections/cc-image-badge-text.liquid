                "info" :"unit in px"
            },
            {
                "type" :"number",
                "id": "mcsize",
                "label" : "Content size (mobile)",
                "default": 16,
                "info" :"unit in px"
            },
            {
                "type": "header",
                "content": "Styles"
            },
            {
                "type" : "color",
                "id" : "tcolor",
                "label": "Text color",
                "default": "#695450"
            },
            {
                "type" : "color",
                "id" : "bgcolor",
                "label": "Background color",
                "default": "#F7F8F4"
            },
            {
                "type" : "number",
                "id" : "dpadtop",
                "label" : "Padding top(desktop)",
                "default": 70,
                "info" : "Unit in px"
            },
            {
                "type" : "number",
                "id" : "dpadbot",
                "label" : "Padding bottom(desktop)",
