<div class="cw-collection-list-wrapper cw-filtered-collections" data-cw-filter-section="{{ section.id }}" data-default-state="{{ section.settings.default_state | default: 'first' }}">
  <div class="container">
    {% if section.settings.title != blank %}
      <div class="cw-collection-list-title">
        {% if section.index == 1 %}
          <h1>{{ section.settings.title }}</h1>
        {% else %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}
      </div>
    {% endif %}
    {% if section.settings.sub_title != blank %}
      <div class="cw-collection-list-sub-title">
        <p>{{ section.settings.sub_title }}</p>
        {% if section.settings.vip_access != blank %}
        <br>
        <p>{{ section.settings.vip_access }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Filter Component -->
    <div class="cw-filter-shell" data-cw-filter-shell>
      <button type="button" class="cw-filter-toggle" data-cw-filter-toggle aria-expanded="false" aria-controls="cw-filter-panel-{{ section.id }}">
        <span>{{ section.settings.filter_label | default: 'Filter by concern' }}</span>
        <svg class="cw-filter-chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M4.375 7.188L10 12.812L15.625 7.188" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div id="cw-filter-panel-{{ section.id }}" class="cw-filter-panel" data-cw-filter-panel hidden>
        <div class="cw-filter-options" role="list">
          {% for block in section.blocks %}
            {% if block.settings.title != blank %}
              {% assign filter_handle = block.settings.title | downcase | handleize %}
              <button type="button" class="cw-filter-option" data-cw-filter-option data-filter-handle="{{ filter_handle }}" aria-pressed="false">
                <span class="cw-filter-radio" aria-hidden="true"><span></span></span>
                <span class="cw-filter-option-label">{{ block.settings.title }}</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>

