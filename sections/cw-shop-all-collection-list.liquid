<script>
  // DROPDOWN FILTER LOGIC
  (function () {
    const root = document.querySelector('[data-cw-filter-section="{{ section.id }}"]');
    if (!root) return;

    const toggle = root.querySelector('[data-cw-filter-toggle]');
    const panel = root.querySelector('[data-cw-filter-panel]');
    const options = Array.from(root.querySelectorAll('[data-cw-filter-option]'));
    const clear = root.querySelector('[data-cw-filter-clear]');
    const cards = Array.from(root.querySelectorAll('[data-cw-product-card]'));
    const empty = root.querySelector('[data-cw-filter-empty]');
    const defaultState = root.dataset.defaultState || 'first';

    function getSelectedHandles() {
      return options
        .filter((option) => option.classList.contains('is-active'))
        .map((option) => option.dataset.filterHandle)
        .filter(Boolean);
    }

    function setPanelState(isOpen) {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      panel.hidden = !isOpen;
    }

    function setOptionState(option, isActive) {
      option.classList.toggle('is-active', isActive);
      option.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    }

    function updateProducts(updateUrl) {
      const selectedHandles = getSelectedHandles();
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardFilters = (card.dataset.filterHandles || '').split(' ').filter(Boolean);
        const shouldShow = selectedHandles.length === 0 || selectedHandles.some((handle) => cardFilters.includes(handle));

        if(shouldShow) {
           card.removeAttribute("hidden");
           visibleCount += 1;
        } else {
           card.setAttribute("hidden", "");
        }
      });

      if (empty) {
        empty.hidden = visibleCount > 0;
      }

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (selectedHandles.length > 0) {
          url.searchParams.set('filter', selectedHandles.join(','));
        } else {
          url.searchParams.delete('filter');
        }
        window.history.pushState({ cwFilters: selectedHandles }, '', url.toString());
      }
    }

    function applyHandles(handles, updateUrl) {
      options.forEach((option) => {
        setOptionState(option, handles.includes(option.dataset.filterHandle));
      });
      updateProducts(updateUrl);
    }

    function getInitialHandles() {
      const url = new URL(window.location.href);
      const filterParam = url.searchParams.get('filter');

      if (filterParam) {
        return filterParam.split(',').map((item) => item.trim()).filter(Boolean);
      }

      const legacyIndex = window.location.href.indexOf('&');
      if (legacyIndex !== -1) {
        const legacyHandle = window.location.href.substring(legacyIndex + 1).split(/[?#]/)[0];
        if (legacyHandle) return [legacyHandle];
      }

      if (defaultState === 'first' && options[0]) {
        return [options[0].dataset.filterHandle];
      }

      return [];
    }

    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        setPanelState(toggle.getAttribute('aria-expanded') !== 'true');
      });
    }

    options.forEach((option) => {
      option.addEventListener('click', function () {
        setOptionState(option, !option.classList.contains('is-active'));
        updateProducts(true);
        // Retrigger height matching when filtering
        if(typeof collectionListMatchHeightTitle === 'function') {
           setTimeout(collectionListMatchHeightTitle, 100);
        }
      });
    });

    if (clear) {
      clear.addEventListener('click', function () {
        applyHandles([], true);
        if(typeof collectionListMatchHeightTitle === 'function') {
           setTimeout(collectionListMatchHeightTitle, 100);
        }
      });
    }

    window.addEventListener('popstate', function () {
      applyHandles(getInitialHandles(), false);
    });

    applyHandles(getInitialHandles(), false);
  })();
</script>

<script type="text/javascript">
  function collectionListMatchHeightTitle() {
    // UPDATED SELECTOR to target the visible columns in the single grid
    var columns = document.querySelectorAll(
      '.cw-collection-list-single-tab-content-column:not([hidden])'
    );
    var titles = document.querySelectorAll(
      '.cw-collection-list-single-tab-content-column:not([hidden]) .cw-collection-list-single-product-title'
    );
    titles.forEach((el) => (el.style.height = 'auto'));
    if (!columns.length || !titles.length) return;

    const isMobile = window.innerWidth <= 768;
    const columnsPerRow = isMobile ? columns.length : 3;

    if (isMobile) {
      let maxHeight = 0;
      titles.forEach((titleEl) => {
        maxHeight = Math.max(maxHeight, titleEl.offsetHeight);
      });
      titles.forEach((titleEl) => {
        titleEl.style.height = `${maxHeight}px`;
      });
    } else {
      for (let i = 0; i < columns.length; i += columnsPerRow) {
        const rowColumns = Array.from(columns).slice(i, i + columnsPerRow);
        let maxHeight = 0;

        rowColumns.forEach((column) => {
          const titleEl = column.querySelector('.cw-collection-list-single-product-title');
          if (titleEl) maxHeight = Math.max(maxHeight, titleEl.offsetHeight);
        });

        rowColumns.forEach((column) => {
          const titleEl = column.querySelector('.cw-collection-list-single-product-title');
          if (titleEl) titleEl.style.height = `${maxHeight}px`;
        });
      }
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    collectionListMatchHeightTitle();
    window.addEventListener('resize', () => {
      var titles = document.querySelectorAll('.cw-collection-list-single-product-title');
      titles.forEach((el) => (el.style.height = 'auto'));
      setTimeout(() => {
        collectionListMatchHeightTitle();
      }, 400);
    });

    // YOUR ORIGINAL ATC JS (UNTOUCHED)
    var buttons = document.querySelectorAll('.btn-primary');
    buttons.forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        var variantId = button.getAttribute('data-variant-id');
        var sellingId = button.getAttribute('data-selling-plan-id');
        if (variantId) {
          var data = {
            items: [
              {
                id: variantId,
                quantity: 1,
                selling_plan: sellingId
              },
            ],
          };
          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          })
            .then((response) => response.json())
            .then((cart) => {
              //window.location.href = '/cart';
              (async function() {
                // Helper to fix the "Empty" state manually
                function forceVisibleCart() {
                  const cartForm = document.querySelector('.cart-drawer.cart-drawer--empty');
                  const content = document.querySelector('.cart-drawer__content');
                  
                  if (cartForm) {
                    cartForm.classList.remove('cart-drawer--empty');
                  }
                  if (content) {
                    content.style.display = 'block';
                    content.style.height = 'auto';
                  }
                }
                // MAIN LOGIC
                if (window.theme && window.theme.sections) {
                  try {
                    const instances = await window.theme.sections.getInstances('cart-drawer');
                    const cartDrawer = instances[0];
                    if (cartDrawer) {
                      const cartData = await fetch('/cart.js').then(r => r.json());
                      
                      if (cartData.item_count > 0) {
                        forceVisibleCart();
                        await cartDrawer.refresh();
                        forceVisibleCart(); 
                      }
                      cartDrawer._openCartDrawer({
                        preventDefault: function() {}
                      });
                    } else {
                      document.querySelector('.ajax-cart__toggle')?.click();
                    }
                  } catch (err) {
                    console.error("Replo Cart Fix Error:", err);
                    document.querySelector('.ajax-cart__toggle')?.click();
                  }
                } else {
                  document.querySelector('.ajax-cart__toggle')?.click();
                }
              })();
            })
            .catch((error) => {
              console.error('Error adding to cart:', error);
            });
        } else {
          console.error('Variant ID not found');
        }
      });
    });
  });
</script>

