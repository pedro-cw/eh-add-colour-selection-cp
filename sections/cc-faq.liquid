<div class="page-width">
    {% if section.settings.title != blank %}
    <{{ section.settings.htags }} class="cc__faq-title">{{ section.settings.title }}</{{ section.settings.htags }}>
    {% endif %}
    {% if section.blocks.size > 0 %}
    <div class="cc__faq-container">
        {% for block in section.blocks %}
        <div class="cc__faq-qa-content">
            {% if block.settings.question != blank %}
            <h3><span class="cc__faq-span">{{ block.settings.question }}</span><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.8943 4.74341L12.258 1.10709C12.1273 0.954566 11.8978 0.936785 11.7453 1.06744C11.5927 1.19806 11.575 1.42762 11.7056 1.58015C11.7178 1.59437 11.731 1.60765 11.7453 1.6198L14.7597 4.63794L0.363618 4.63794C0.162809 4.63794 -6.68044e-07 4.80075 -7.0316e-07 5.00159C-7.38276e-07 5.20243 0.162809 5.3652 0.363618 5.3652L14.7597 5.36521L11.7453 8.37969C11.5927 8.51031 11.575 8.73987 11.7056 8.8924C11.8363 9.04492 12.0658 9.0627 12.2183 8.93205C12.2325 8.91986 12.2458 8.90661 12.258 8.8924L15.8943 5.25608C16.0352 5.11431 16.0352 4.88525 15.8943 4.74341Z" fill="#695450"/>
            </svg></h3>
            {% endif %}
            {% if block.settings.content != blank %}
            <div class="cc__faq-qa-answer">{{ block.settings.content }}</div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
<style>
    #shopify-section-{{ section.id }}{
        background-color: {{ section.settings.bgcolor }};
        padding-top: {{ section.settings.mpadtop | append: 'px'}};
        padding-bottom: {{ section.settings.mpadbot | append: 'px'}};
        overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cc__faq-title{
        font-size: {{ section.settings.mhsize | append: 'px' }};
        margin-bottom: 24px;
        text-align: center;
        color: {{ section.settings.tcolor }};
    }

    #shopify-section-{{ section.id }} .cc__faq-qa-content:not(:last-child){
        margin-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .cc__faq-qa-content h3{
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 14px;
        gap: 24px;
        padding: 15px 20px;
        text-transform: UPPERCASE;
        font-weight: 600;
        cursor: pointer;
        margin: 0;
        color: {{ section.settings.bgcolor }};
         background-color: {{ section.settings.tcolor }};
        font-family: {{ settings.type_base_font.family }}, {{ settings.type_base_font.fallback_families }};
    }

    #shopify-section-{{ section.id }} .cc__faq-qa-content h3 svg{
        transition: all 0.3s ease;
    }

    #shopify-section-{{ section.id }} .cc__faq-qa-answer{
        padding: 0px 20px;
        color: {{ section.settings.tcolor }};
        max-height: 0;
        visibility: hidden;
        font-size: 14px;
        transition: max-height 0.3s ease
    }

    #shopify-section-{{ section.id }} .cc__faq-qa-answer a{
        color: {{ section.settings.tcolor }};
    }

    #shopify-section-{{ section.id }} .cc_faqactive .cc__faq-qa-answer{
        padding: 10px 20px;
        max-height: unset;
        visibility: visible;
    }

    #shopify-section-{{ section.id }} .cc__faq-qa-content.cc_faqactive h3 svg {
        transform: rotate(90deg);
    }

    #shopify-section-{{ section.id }} .cc__faq-container{
        max-width: 586px;
        margin-left: auto;
        margin-right: auto;
    }

    #shopify-section-{{ section.id }} .cc__faq-span{
        width: calc(100% - 18px);
        display: inline-block;
    }

    @media screen and (min-width: 750px){
        #shopify-section-{{ section.id }}{
            padding-top: {{ section.settings.dpadtop | append: 'px' }};
            padding-bottom: {{ section.settings.dpadbot | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .cc__faq-title{
            font-size: {{ section.settings.dhsize | append: 'px' }};
            margin-bottom: 48px;
        }
    }
</style>

<script>
    let fq = document.querySelectorAll('.cc__faq-qa-content');

    if( fq.length > 0 ){
        fq.forEach(faq=>{
            faq.addEventListener('click', et=>{
                if(et.currentTarget.classList.contains('cc_faqactive')){
                    et.currentTarget.classList.remove('cc_faqactive');
                } else {
                    if(document.querySelector('.cc_faqactive')){
                        document.querySelector('.cc_faqactive').classList.remove('cc_faqactive');
                    }

                    et.currentTarget.classList.add('cc_faqactive');
                }
            });
        })
    }
</script>
