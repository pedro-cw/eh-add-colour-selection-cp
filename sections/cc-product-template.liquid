{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign current_variant_sale = false -%}
{% if current_variant.compare_at_price > current_variant.price %}
  {%- assign current_variant_sale = true -%}
{% endif %}
{% assign featured_media = current_variant.featured_media | default: product.featured_media %}

<div class="product-template" data-section-id="{{ section.id }}" data-section-type="product-template" data-variant-id="{{ current_variant.id }}" itemscope itemtype="http://schema.org/Product">
{% if product.metafields.loox.num_reviews %}
	<div itemprop="aggregateRating" itemscope itemtype="http://schema.org/AggregateRating">
		<meta itemprop="ratingValue" content="{{ product.metafields.loox.avg_rating }}"/>
		<meta itemprop="reviewCount" content="{{ product.metafields.loox.num_reviews }}"/>
	</div>
{% endif %}
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ featured_media | img_url: 'grande' }}">

  <div class="page-width product__template-contents-container">
    <div class="product__template-breadcrumbs">
        <a href="{{ routes.all_products_collection_url }}">SHOP</a>
        <div class="cc__product-template-divider">/</div>
        <p class="cc__currentproduct">{{ product.title }}</p>
    </div>
    <div class="product__template-container">
        <div class="product__template-media">
            {% comment %}
            ------------------------------------------------------------------------------
            Product Featured Media
            ------------------------------------------------------------------------------
            {% endcomment %}
            {% if product.media.size > 0 %}
            <div class="product__template-main-media">
                <div class="swiper productmainswiper">
                    <div class="swiper-wrapper">
                        {% for media in product.media %}
                            {% unless variant_media_ids contains media.id and section.settings.hide_variant_media %}
                            {% capture data_image %}
                                data-parent-fit="cover"
                            {% endcapture %}
                            <div class="swiper-slide" data-index="{{ forloop.index0 }}"  id="{{ section.id }}-{{ media.id }}">
                            {% include 'product-preview-image' with media, featured_media: false, gallery_type: 'submedia', data_image: data_image %}
                            </div>
                            {% endunless %}
                        {% endfor %}
                    </div>
                </div>
                <div thumbsSlider="" class="swiper productthumbswiper">
                    <div class="swiper-wrapper">
                        {% for media in product.media %}
                            {% unless variant_media_ids contains media.id and section.settings.hide_variant_media %}
                            {% capture data_image %}
                                data-parent-fit="cover"
                            {% endcapture %}
                            <div class="swiper-slide">
                            {% include 'product-preview-image' with media, featured_media: false, gallery_type: 'submedia', data_image: data_image %}
                            </div>
                            {% endunless %}
                        {% endfor %}
                    </div>

                    <div class="product-button-prev">
                      <svg width="26" height="14" viewBox="0 0 26 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.926495 7.39212L6.48786 12.9535C6.68764 13.1868 7.03873 13.214 7.27201 13.0142C7.50529 12.8144 7.53248 12.4633 7.33266 12.23C7.31402 12.2083 7.29375 12.188 7.27201 12.1694L2.66163 7.55343L24.6792 7.55343C24.9863 7.55343 25.2354 7.30443 25.2354 6.99726C25.2354 6.69009 24.9863 6.44114 24.6792 6.44114L2.66163 6.44113L7.27201 1.83076C7.50529 1.63098 7.53248 1.27989 7.33266 1.04661C7.13283 0.813332 6.78179 0.786138 6.54851 0.985962C6.52677 1.0046 6.50646 1.02486 6.48786 1.04661L0.926447 6.60803C0.710852 6.82487 0.710852 7.17519 0.926495 7.39212Z" fill="#977E57"/>
                </svg>
                    </div>
                    <div class="product-button-next">
                      <svg width="26" height="14" viewBox="0 0 26 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M25.0735 6.60788L19.5121 1.04646C19.3124 0.813181 18.9613 0.785987 18.728 0.98581C18.4947 1.18559 18.4675 1.53668 18.6673 1.76995C18.686 1.7917 18.7062 1.81201 18.728 1.8306L23.3384 6.44658L1.32077 6.44657C1.01365 6.44657 0.764647 6.69557 0.764647 7.00274C0.764647 7.30991 1.01365 7.55886 1.32077 7.55886L23.3384 7.55887L18.728 12.1692C18.4947 12.369 18.4675 12.7201 18.6673 12.9534C18.8672 13.1867 19.2182 13.2139 19.4515 13.014C19.4732 12.9954 19.4935 12.9751 19.5121 12.9534L25.0736 7.39197C25.2891 7.17514 25.2891 6.82481 25.0735 6.60788Z" fill="#977E57"/>
                </svg>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="product__template-main-media">
                <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title | append:' media' }}" />
            </div>
            {% endif %}

            {% if product.metafields.custom.icon_text != blank %}
            {% assign icontext = product.metafields.custom.icon_text.value %}
            <div class="cc__product-template-icontext cc__contentdesktop">
              {% for it in icontext %}
                {%  liquid
                  assign image = it.icon_image
                  assign title = it.title
                  assign short_text = it.short_content
                %}
                <div class="cc__product-icontext-list">
                  {% if image != blank %}
                  <img src="{{ image | img_url: 'master' }}" />
                  {% endif %}

                  {% if title != blank or short_text != blank %}
                  <div class="text-center cc__product-icontext-content-item">
                    {% if title != blank %}
                    <p class="cc__product-icontext-title">{{ title }}</p>
                    {% endif %}
                    {% if short_text != blank %}
                    <p class="cc__product-icontext-content">{{ short_text }}</p>
                    {% endif %}
                  </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.disclaimer != blank and section.settings.disclaimer_label != blank %}
          <div data-trigger="disclaimer-trigger" class="cc__product-template-disclaimer-trigger cc__triggerdesktop">{{ section.settings.disclaimer_label }}</div>
          {% endif %}

        </div>
        <div class="product__template-contents">
            {% render 'junip-product-summary', product: product %}

            <h1 class="product__template-title">{{ product.title }}</h1>
            <div class="product__price_container">
              <div class="cc__product_price-contents">
                <p class="product__price{% if current_variant_sale %} product__price--sale{% endif %}" data-product-price aria-live="polite">
                <span class="product__sale-price-label visually-hidden">{{ 'products.product.sale_price' | t }}</span>
                <span class="product__regular-price-label visually-hidden">{{ 'products.product.price' | t }}</span>
                <span 
                  data-wpd-product-handle="{{ product.handle }}"
                  data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                  data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                  data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                  data-wpd-product-id="{{ product.id }}"
                  class="product__current-price" data-regular-price>{{ current_variant.price | money }}</span>

                <span class="product__compare-price-label visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                <s class="data-wpd-hide product__compare-price" data-compare-price>{{ current_variant.compare_at_price | money }}</s>

                {% include 'product-unit-price', variant: current_variant %}
              </p>
              {% if product.metafields.custom.quantity != blank %}
                <p class="cc__productquantity-info">{{ product.metafields.custom.quantity }}</p>
              {% endif %}
                </div>
              <div class="cc__productprice-vat-info">
                <div class="cc__product-vat-content">Price includes VAT</div>
                {% if product.available %}
                <div class="product__price-stock-info">In Stock</div>
                {% else %}
                <div class="product__price-stock-info">Out of Stock</div>
                {% endif %}
              </div>
              {%- for block in section.blocks -%}
                {% render block %}
              {%- endfor -%}
            </div>
            
          {% if section.settings.show_clearpay_messaging %}
            <div style="margin-bottom: 12px;" class="cc__product-clear-pay">
              <p style="display: flex; align-items: center; gap: 6px; font-size: 13px;">
                <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" width="106" height="36" viewBox="0 0 106 36">
                  <path class="afterpay-logo-badge-background" fill="#b2fce4" d="m87.9659,35.9683l-69.9317,0a17.9342,17.9342 0 1 1 0,-35.8683l69.9317,0a17.9342,17.9342 0 1 1 0,35.8683z"></path>
                  <g class="afterpay-logo-badge-lockup">
                    <path d="m75.7442,13.8827l-5.2852,10.9026l-2.1897,0l1.9746,-4.073l-3.102,-6.8296l2.2483,0l1.9942,4.5748l2.1765,-4.5748l2.1832,0l0.0001,0z"></path>
                    <path d="m55.6334,17.7537a2.1505,2.1505 0 0 0 -2.105,-2.2157c-1.1599,0 -2.1048,0.932 -2.1048,2.2157c0,1.2708 0.9449,2.2157 2.1049,2.2157a2.1505,2.1505 0 0 0 2.105,-2.2157m-6.1324,7.0316l0,-10.9025l1.903,0l0,1.0035a3.076,3.076 0 0 1 2.4437,-1.147c2.0919,0 3.7341,1.7205 3.7341,3.9949s-1.6748,4.0078 -3.7797,4.0078a2.9977,2.9977 0 0 1 -2.3395,-1.0362l0,4.073l-1.9617,0l0,0.0065l0.0001,0z"></path>
                    <path d="m64.4506,17.7537c0,-1.3033 -0.945,-2.2157 -2.105,-2.2157c-1.1599,0 -2.1048,0.932 -2.1048,2.2157c0,1.2708 0.9449,2.2157 2.1049,2.2157c1.16,0 2.105,-0.9188 2.105,-2.2157m0.013,3.871l0,-1.0037a3.102,3.102 0 0 1 -2.4439,1.1274c-2.1244,0 -3.734,-1.7009 -3.734,-3.9948c0,-2.2743 1.6747,-4.0078 3.7797,-4.0078c0.9905,0 1.8247,0.4366 2.3981,1.1144l0,-0.9775l1.903,0l0,7.7419l-1.903,0l0.0001,0.0001z"></path>
                    <path d="m46.0668,14.6387s0.4822,-0.8993 1.6748,-0.8993c0.5083,0 0.8341,0.176 0.8341,0.176l0,1.9745s-0.7168,-0.4431 -1.375,-0.3519s-1.0753,0.6908 -1.0753,1.4989l0,4.5878l-1.968,0l0,-7.742l1.9029,0l0,0.756l0.0065,0z"></path>
                    <path d="m90.5242,13.4461l-2.2548,-1.2903l-2.2874,-1.3099a2.2744,2.2744 0 0 0 -3.4017,1.9681l0,0.2933c0,0.1629 0.0847,0.3128 0.228,0.391l1.0623,0.606a0.4431,0.4431 0 0 0 0.6582,-0.3845l0,-0.6973c0,-0.3454 0.3714,-0.5604 0.6712,-0.391l2.0854,1.1991l2.0788,1.1926a0.4497,0.4497 0 0 1 0,0.7755l-2.0788,1.1926l-2.0854,1.199a0.4497,0.4497 0 0 1 -0.6712,-0.391l0,-0.3454c0,-1.7464 -1.8899,-2.8413 -3.4018,-1.968l-2.2874,1.3098l-2.2548,1.2904a2.2809,2.2809 0 0 0 0,3.9426l2.2548,1.2903l2.2874,1.31a2.2744,2.2744 0 0 0 3.4018,-1.9682l0,-0.2932c0,-0.163 -0.0847,-0.3128 -0.2281,-0.391l-1.0622,-0.606a0.4431,0.4431 0 0 0 -0.6582,0.3844l0,0.6973c0,0.3454 -0.3715,0.5604 -0.6713,0.391l-2.0853,-1.199l-2.0789,-1.1927a0.4497,0.4497 0 0 1 0,-0.7755l2.0789,-1.1925l2.0853,-1.1991a0.4497,0.4497 0 0 1 0.6713,0.391l0,0.3454c0,1.7465 1.8898,2.8413 3.4017,1.968l2.2874,-1.3098l2.2548,-1.2903a2.2809,2.2809 0 0 0 0,-3.9427z"></path>
                    <path d="m22.2806,18.7377a3.8905,3.8905 0 0 1 -3.9296,3.0043a3.91,3.91 0 0 1 -4.0078,-3.9948a3.9492,3.9492 0 0 1 4.0404,-4.0078a3.897,3.897 0 0 1 3.884,2.9716l-2.0137,0a2.105,2.105 0 0 0 -1.8573,-1.16a2.1375,2.1375 0 0 0 -2.105,2.1962a2.1375,2.1375 0 0 0 2.105,2.1961c0.8211,0 1.5314,-0.4627 1.8703,-1.2056l2.0137,0z"></path>
                    <path d="m23.1864,21.6181l0,-10.922l1.9485,0l0,10.922l-1.9485,0z"></path>
                    <path d="m28.0675,18.262a1.9224,1.9224 0 0 0 1.9941,1.7921c0.8211,0 1.4532,-0.3845 1.8247,-1.0036l1.9941,0c-0.4627,1.6423 -1.9355,2.6915 -3.871,2.6915c-2.3395,0 -3.9752,-1.6423 -3.9752,-3.9753s1.7335,-4.0208 4.0209,-4.0208a3.871,3.871 0 0 1 3.9296,4.5161l-5.9172,0zm3.884,-1.2121c-0.1369,-1.0036 -0.958,-1.6096 -1.916,-1.6096s-1.7464,0.5865 -1.9485,1.6096l3.8645,0z"></path>
                    <path d="m40.9902,21.6181l0,-1.0035a3.089,3.089 0 0 1 -2.4438,1.1274c-2.118,0 -3.7276,-1.701 -3.7276,-3.9948c0,-2.2744 1.6683,-4.0078 3.7733,-4.0078c0.9905,0 1.8247,0.43 2.3981,1.1144l0,-0.9776l1.903,0l0,7.7354l-1.903,0l0,0.0066l0,-0.0001zm-0.0195,-3.8709c0,-1.2967 -0.945,-2.2156 -2.105,-2.2156c-1.16,0 -2.1049,0.9254 -2.1049,2.2157c0,1.2708 0.945,2.2157 2.105,2.2157c1.16,0 2.1049,-0.9124 2.1049,-2.2157l0,-0.0001z"></path>
                  </g>
                </svg> Pay in instalments with Clearpay</p>
            </div>
          {% endif %}
            {% if product.metafields.custom.bundle_title != blank %}
            <div class="cc__product-pay-bundle">
              <div class="cc__product-info-bundle-badge">
                <a href="#productbundle-{{ product.id }}"></a>
                {{ product.metafields.custom.bundle_title }}
                </div>
            </div>
            {% endif %}

            {% if product.metafields.custom.short_description != blank %}
            <div class="cc__product-short-description">
              {{ product.metafields.custom.short_description | metafield_tag }}
            </div>
            {% endif %}

            {% if product.metafields.custom.product_as_a_variant != blank %}
            {% assign productvariant = product.metafields.custom.product_as_a_variant.value %}
            <div class="cc__product-as-a-variant">
              <p class="cc__product-variants-label">Choose your colour</p>
              <div class="cc__product-as-variant-list">
              {% for paav in productvariant %}
                {%  liquid
                  assign title = paav.title
                  assign products = paav.product.value
                %}
              <a {% if product.handle == products.handle %}class="cc__productpaav_current"{% endif %} href="{{ products.url }}">{{ title }}</a>
              {% endfor %}
              </div>
            </div>
            {% endif %}

            <input class="cc__selected" type="hidden" value="{{ product.selected_or_first_available_variant.id }}" data-mediaid="{{ section.id }}-{{ product.selected_or_first_available_variant.featured_media.id }}" />
            {% unless product.has_only_default_variant %}
            

            <div class="cc__product-as-a-variant">
              {% comment %}
              <p class="cc__product-variants-label">Choose your colour</p>
              <div class="cc__product-as-variant-list">
              {% for paav in product.variants %}
              <div class="cc__productpaavselector {% if paav.available %}{% else%}disabled{% endif %} {% if product.selected_or_first_available_variant.id == paav.id %}cc__productpaav_current{% endif %}" {% if paav.featured_media != blank %}data-mediaid="{{ section.id}}-{{ paav.featured_media.id }}"{% endif %} data-variant="{{ paav.id }}">{{ paav.title }}</div>
              {% endfor %}
              </div>
            {% endcomment %}

              {% for option in product.options_with_values %}
                <div class="cc__product-variant-options cc__variants-{{ forloop.index0 }}">
                  {% if option.name contains 'Colour' or option.name contains 'Color' %}
                    <p class="cc__product-variants-label">Choose your colour</p>
                    <div class="cc__product-as-variant-list">
                    {% for options in option.values %}
                      <div class="cc__product-as-variant-list-input">
                      <input data-radio-input id="option-{{ forloop.index }}{{ option.name | handleize }}" type="radio" value="{{ options }}" {% if option.selected_value == options %}checked="checked"{% endif %} name="option-{{ option.name | handleize }}" />
                      <label class="cc__productpaavselector" for="option-{{ forloop.index }}{{ option.name | handleize }}">
                        {{ options }}
                      </label>
                      </div>
                      
                    {% endfor %}
                    </div>
                  {% else %}
                    <p class="cc__product-variants-label">{{ option.name }}</p>
                    <div class="cc__product-as-variant-list">
                    {% for options in option.values %}
                      <div class="cc__product-as-variant-list-input">
                      <input data-radio-input id="option-{{ forloop.index }}{{ option.name | handleize }}" type="radio" value="{{ options }}" {% if option.selected_value == options %}checked="checked"{% endif %} name="option-{{ option.name | handleize }}" />
                      <label class="cc__productpaavselector" for="option-{{ forloop.index }}{{ option.name | handleize }}">
                        {{ options }}
                      </label>
                      </div>
                  {% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endunless %}

            {% if product.metafields.custom.kits_include != blank %}
            {% assign kits = product.metafields.custom.kits_include.value %}
            <div class="cc__product-kit-includes">
              <p class="cc__product-variants-label">Includes</p>
              <div class="cc__product-kit-includes-list">
              {% for ki in kits %}
                {%  liquid
                assign image = ki.image
                assign title = ki.title
                %}
                <div class="cc__product-kit-includes-listitem">
                  {% if image != blank %}
                  <img src="{{ image | img_url: 'master' }}" alt="{{ title }}" />
                  {% endif %}

                  {% if title != blank %}
                  <p>{{ title }}</p>
                  {% endif %}
                </div>
              {% endfor %}
              </div>
            </div>
            {% endif %}
            {% if product.metafields.custom.below_kit_context != blank %}
            <div class="cc__product-kit-below-context">
              <p>{{ product.metafields.custom.below_kit_context }}</p>
            </div>
          {% endif %}
          {% if product.metafields.custom.call_to_action != blank %}
          <div class="cc__product-cta">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="10" cy="10" r="10" fill="#F3EEEA"/>
            <circle cx="8" cy="7" r="2" fill="#977E57"/>
            <circle cx="12" cy="13" r="2" fill="#977E57"/>
            </svg>
            {{ product.metafields.custom.call_to_action | metafield_tag }}
          </div>
          {% endif %}

          <div class="cc__product-form-container" itemprop="offers" itemscope itemtype="http://schema.org/Offer">
            <div class="product__form-wrapper">
              <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
              <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
              <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

              {% include 'cc-product-form' %}
              <div id='wcp_vd_table'></div>
            </div>
          </div>
          <div class="cc__product-number-views">
            <svg width="20" height="14" viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.42238 2.36456L0.351914 6.28756C0.128398 6.46049 0 6.72315 0 6.99999C0 7.27682 0.128398 7.53948 0.351953 7.71241C1.28469 8.43409 3.42246 10.0881 5.42238 11.6354C8.09863 13.706 11.9014 13.706 14.5776 11.6354C16.5775 10.0881 18.7153 8.43409 19.6481 7.71241C19.8716 7.53948 20 7.27682 20 6.99999C20 6.72315 19.8716 6.46049 19.648 6.28756C18.7153 5.56588 16.5775 3.9119 14.5776 2.36456C11.9014 0.294009 8.09863 0.294009 5.42238 2.36456ZM10.0004 2.75913C7.65035 2.75913 5.74238 4.66713 5.74238 7.01725C5.74238 9.36733 7.65035 11.2753 10.0004 11.2753C12.3505 11.2753 14.2584 9.36733 14.2584 7.01725C14.2584 4.66713 12.3505 2.75913 10.0004 2.75913Z" fill="#695450"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.0004 4.67322C8.70677 4.67322 7.65649 5.72353 7.65649 7.01724C7.65649 8.31091 8.70677 9.36123 10.0004 9.36123C11.2942 9.36123 12.3444 8.31091 12.3444 7.01724C12.3444 5.72353 11.2942 4.67322 10.0004 4.67322Z" fill="#695450"/>
            </svg>
            <p><span class="cc__product-views">14 people</span> are viewing this item right now.</p>
          </div>
          <div class="cc__product-accordion-content">
              {% if product.description != blank %}
              <div class="cc__product-accordion-lists">
                <div class="cc__product-accordion-header"><span class="cc__product-accordion-span">Product Information</span><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15.8943 4.74365L12.258 1.10734C12.1273 0.95481 11.8978 0.937029 11.7453 1.06768C11.5927 1.19831 11.575 1.42786 11.7056 1.58039C11.7178 1.59461 11.731 1.60789 11.7453 1.62005L14.7597 4.63818L0.363618 4.63818C0.162809 4.63818 -6.68044e-07 4.80099 -7.0316e-07 5.00183C-7.38276e-07 5.20267 0.162809 5.36545 0.363618 5.36545L14.7597 5.36545L11.7453 8.37993C11.5927 8.51055 11.575 8.74011 11.7056 8.89264C11.8363 9.04517 12.0658 9.06295 12.2183 8.93229C12.2325 8.92011 12.2458 8.90686 12.258 8.89264L15.8943 5.25633C16.0352 5.11455 16.0352 4.88549 15.8943 4.74365Z" fill="#695450"/>
                </svg></div>
                <div class="cc__product-accordion-contents">{{ product.description }}</div>
              </div>
              {% endif %}

