<script>
  let prod_accord = document.querySelectorAll('.cc__product-accordion-lists:not(.cc__product-review)');

  if( prod_accord.length > 0 ){
    prod_accord.forEach(pa=>{
      pa.addEventListener('click', et=>{
        if(et.currentTarget.classList.contains('cc__productaccordactive')){
          et.currentTarget.classList.remove('cc__productaccordactive');
        } else {
          if(document.querySelector('.cc__productaccordactive')){
            document.querySelector('.cc__productaccordactive').classList.remove('cc__productaccordactive');
          }
          et.currentTarget.classList.add('cc__productaccordactive');
        }
      });
    });
  }

  let disclaimertrigger = document.querySelectorAll('.cc__product-template-disclaimer-trigger');
  let disclaimerclose = document.querySelector('.cc__product-template-disclaimer-close');
  let disclaimeroverlay = document.querySelector('.cc__product-disclaimer-overlay');

  if(disclaimertrigger){
    disclaimertrigger.forEach(dt=>{
      dt.addEventListener('click', et=>{
        let target = et.currentTarget.dataset.trigger;

        document.getElementById(target).classList.add('cc__disclaimeropen');
      });
    })
  }


  if(disclaimerclose){
    disclaimerclose.addEventListener('click', et=>{
      let target = et.currentTarget.dataset.trigger;
      document.getElementById(target).classList.remove('cc__disclaimeropen');
    });
  }

  if(disclaimeroverlay){
    disclaimeroverlay.addEventListener('click', et=>{
      let target = et.currentTarget.dataset.trigger;
      document.getElementById(target).classList.remove('cc__disclaimeropen');
    });
  }



  document.addEventListener('DOMContentLoaded', function(){
    function randomIntFromInterval(min, max) { // min and max included
      return Math.floor(Math.random() * (max - min + 1) + min)
    }

    const rndInt = randomIntFromInterval(1, 30);
    document.querySelector('.cc__product-views').innerText = rndInt + ' people';
  });


</script>

