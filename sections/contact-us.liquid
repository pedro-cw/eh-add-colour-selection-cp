{%- comment -%} 
        Section: Contact Form
        Description: A responsive contact form matching the elegant UI design, built mobile-first. 
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.text_color | color_modify: 'alpha', 0.5 }};
    --button-bg: {{ section.settings.button_bg_color }};
    --button-text: {{ section.settings.button_text_color }};

    background: var(--bg-color);
    color: var(--text-color);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    font-family: var(--font-body-family, sans-serif);
  }

  /* Accessibility class fallback to ensure labels don't break the visual design */
  .contact-us .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    clip: rect(0 0 0 0);
    height: 1px;
    width: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
  }

  .contact-us__container {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .contact-us__header-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 0;
    margin-bottom: 30px;
    border-bottom: 1px solid #DAD4C5;
  }

  .contact-us__label {
    color: #695450;
    font-family: Montserrat;
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    line-height: 12px;
    /* 120% */
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .contact-us__title {
    color: #695450;
    text-align: center;
    font-family: Botanica;
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
    text-transform: lowercase;
    margin: 0 auto 30px;
    color: var(--text-color);
  }

  .contact-us__form {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-us__row {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 100%;
  }

  .contact-us__field {
    width: 100%;
    flex: 1;
  }

  .contact-us__input {
    width: 100% !important;
    padding: 16px !important;
    border: 1px solid var(--border-color) !important;
    background: #fff;
    color: #695450;
    font-family: 'Montserrat'
    , sans-serif;
    font-size: 16px !important;
    font-style: normal;
    font-weight: 500;
    line-height: 26px !important;
    /* 162.5% */
    opacity: 1;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.3s ease;
    margin: 0 !important;
  }

  .contact-us__input:focus {
    border-color: var(--text-color);
  }

  .contact-us__input::placeholder {
    color: #695450 !important;
    font-family: 'Montserrat'
    , sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: 26px !important;
    /* 162.5% */
    opacity: 1 !important;
    /* Ensures browsers don't wash out the color */
  }

  textarea.contact-us__input {
    min-height: 180px;
    resize: vertical;
  }

  .contact-us__submit-wrapper {
    text-align: center;
    width: 100%;
  }

  .contact-us__submit {
    background-color: var(--button-bg);
    padding: 18px 40px;
    border: none;

    color: #FFF;
    font-family: Montserrat;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 110%;
    /* 19.8px */
    letter-spacing: 0.9px;
    text-transform: uppercase;

    cursor: pointer;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    transition: opacity 0.3s ease;
    display: inline-block;
  }


  .contact-us__message--success {
    text-align: center;
    color: #695450;
    background-color: #f3eeea;
    padding: 15px;
    border: 1px solid #695450;
  }

  .contact-us__message--error {
    color: #c62828;
    margin-bottom: 20px;
    font-size: 14px;
    text-align: center;
  }

  /* Desktop Adjustments */
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .contact-us__header-top {
      margin-bottom: 80px;
    }


    .contact-us__title {
      font-size: 38px;
      margin-bottom: 50px;
      max-width: 750px;
    }

    .contact-us__form {

      gap: 24px;
    }

    .contact-us__row {
      flex-direction: row;
    }

    .contact-us__submit {
      max-width: 320px;
    }
  }
{%- endstyle -%}

<section class="contact-us">
  <div class="contact-us__container">

    <header class="contact-us__header-top">
      {%- if section.settings.label != blank -%}
        <span class="contact-us__label">{{ section.settings.label }}</span>
      {%- endif -%}
    </header>

    {%- if section.settings.title != blank -%}
      <h2 class="contact-us__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    {%- form 'contact'
      , id: 'ContactForm'
      , class: 'contact-us__form' -%}
      {%- if form.posted_successfully? -%}
        <div
          class="contact-us__message--success"
          tabindex="-1"
          autofocus>
          {{ section.settings.success_message | default: "Thanks for contacting us. We\'ll get back to you as soon as possible." }}
        </div>
      {%- elsif form.errors -%}
        <div class="contact-us__message--error">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="contact-us__row">
        <div class="contact-us__field">
          <label class="visually-hidden" for="ContactForm-first_name">{{ section.settings.first_name_placeholder }}</label>
          <input
            class="contact-us__input"
            autocomplete="given-name"
            type="text"
            id="ContactForm-first_name"
            name="contact[first_name]"
            value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
            placeholder="{{ section.settings.first_name_placeholder }}"
            required>
        </div>
        <div class="contact-us__field">
          <label class="visually-hidden" for="ContactForm-last_name">{{ section.settings.last_name_placeholder }}</label>
          <input
            class="contact-us__input"
            autocomplete="family-name"
            type="text"
            id="ContactForm-last_name"
            name="contact[last_name]"
            value="{% if form.last_name %}{{ form.last_name }}{% elsif customer %}{{ customer.last_name }}{% endif %}"
            placeholder="{{ section.settings.last_name_placeholder }}"
            required>
        </div>
      </div>

      <div class="contact-us__field">
        <label class="visually-hidden" for="ContactForm-email">{{ section.settings.email_placeholder }}</label>
        <input
          class="contact-us__input"
          autocomplete="email"
          type="email"
          id="ContactForm-email"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          placeholder="{{ section.settings.email_placeholder }}"
          required>
      </div>

      <div class="contact-us__field">
        <label class="visually-hidden" for="ContactForm-body">{{ section.settings.message_placeholder }}</label>
        <textarea
          class="contact-us__input"
          rows="8"
          id="ContactForm-body"
          name="contact[body]"
          placeholder="{{ section.settings.message_placeholder }}"
          required>
          {%- if form.body -%}
            {{- form.body -}}
          {%- endif -%}
        </textarea>
      </div>

      <div class="contact-us__submit-wrapper">
        <button type="submit" class="contact-us__submit">
          {{ section.settings.button_text }}
        </button>
      </div>
    {%- endform -%}

  </div>
</section>

{% schema %}
  {
    "name": "Contact Form Custom",
    "settings": [
      {
        "type": "header",
        "content": "Text Content"
      },
      {
        "type": "text",
        "id": "label",
        "label": "Top Label",
        "default": "Contact Us"
      },
      {
        "type": "textarea",
        "id": "title",
        "label": "Heading",
        "default": "Send us a message and our team will get back to you within 48 hours."
      },
      {
        "type": "textarea",
        "id": "success_message",
        "label": "Success Message",
        "default": "Thanks for contacting us. We'll get back to you as soon as possible."
      }, {
        "type": "header",
        "content": "Form Fields Placeholders"
      }, {
        "type": "text",
        "id": "first_name_placeholder",
        "label": "First Name Placeholder",
        "default": "First Name"
      }, {
        "type": "text",
        "id": "last_name_placeholder",
        "label": "Last Name Placeholder",
        "default": "Last Name"
      }, {
        "type": "text",
        "id": "email_placeholder",
        "label": "Email Placeholder",
        "default": "E-mail"
      }, {
        "type": "text",
        "id": "message_placeholder",
        "label": "Message Placeholder",
        "default": "Message"
      }, {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Send Message"
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color_background",
        "id": "bg_color",
        "label": "Background",
        "default": "linear-gradient(0deg, #F7F8F4 0%, #F7F8F4 100%), #F3EEEA"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text & Input Border Color",
        "default": "#6B5A52"
      }, {
        "type": "color",
        "id": "button_bg_color",
        "label": "Button Background Color",
        "default": "#6B5A52"
      }, {
        "type": "color",
        "id": "button_text_color",
        "label": "Button Text Color",
        "default": "#FFFFFF"
      }, {
        "type": "header",
        "content": "Section Padding (Desktop)"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 60
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 60
      }, {
        "type": "header",
        "content": "Section Padding (Mobile)"
      }, {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 40
      }, {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 40
      }
    ],
    "presets": [
      {
        "name": "Contact Form Custom",
        "category": "Forms"
      }
    ]
  }
{% endschema %}