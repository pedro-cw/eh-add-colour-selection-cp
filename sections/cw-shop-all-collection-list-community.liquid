<style>
    {% if section.settings.hide_instafeed != blank %}
        body.template-collection-cw-shop-all .shopify-section-group-group-prefooter
        {
            display: none;
        }
    {% endif %}
    #shopify-section-{{ section.id }} .cw-instafeed-wrapper
    {
        display: block;
        width: 100%;
        max-width: 100%;
        padding: 45px 0px;
        padding-bottom: 26px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-wrapper .container
    {
        display: block;
        width: 100%;
        max-width: 1276px;
        padding: 0px 15px;
        margin: 0px auto;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-title
    {
        margin-bottom: 15px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-title h2
    {
        font-family: 'Botanica', serif;
        font-weight: 400;
        font-size: 50px;
        line-height: 110%;
        letter-spacing: 2px;
        text-align: center;
        color: #977E57;
        padding: 0px;
        margin: 0px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-links
    {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        line-height: 1;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-links a,
    #shopify-section-{{ section.id }} .cw-instafeed-links a:hover,
    #shopify-section-{{ section.id }} .cw-instafeed-links a:focus
    {
        display: inline-flex;
        font-family: 'Montserrat';
        font-weight: 500;
        font-size: 20px;
        line-height: 110%;
        letter-spacing: 0px;
        text-transform: uppercase;
        color: #695450;
        outline: none;
        text-decoration: none;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-social-media
    {
        display: flex;
        align-items: center;
        gap: 10px;
        line-height: 1;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-social-media a,
    #shopify-section-{{ section.id }} .cw-instafeed-social-media a:hover,
    #shopify-section-{{ section.id }} .cw-instafeed-social-media a:focus
    {
        display: inline-flex;
        outline: none;
        text-decoration: none;
        width: 42px;
        line-height: 1;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-social-media a img
    {
        display: inline-block;
        vertical-align: top;
        width: 100%;
        max-width: 100%;
        height: auto;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-images
    {
        margin-top: 50px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-images.desktop-only
    {
        display: block;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-images.mobile-only
    {
        display: none;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-images-inner
    {
        display: flex;
        column-gap: 19px;
        align-items: center;
        flex-wrap: wrap;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-image
    {
        cursor: pointer;
        max-width: 278px;
        height: 342px;
        position: relative;
        flex: 1;
        margin-bottom: 19px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-image-big
    {
        max-width: 652px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-image img
    {
        display: inline-block;
        width: 100%;
        max-width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        position: absolute;
        top: 0px;
        left: 0px;
        right: 0px;
        bottom: 0px;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-image img.hover-img
    {
        display: none;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-image:hover img
    {
        display: none;
    }
    #shopify-section-{{ section.id }} .cw-instafeed-image:hover img.hover-img
    {
        display: block;
    }
    @media only screen and (max-width: 767px)
