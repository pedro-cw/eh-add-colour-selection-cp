{%-liquid
    assign collection = collections[section.settings.collection]
    assign limit = section.settings.productlimit
-%}

<div class="cc__featured-collection-outer-container">
  <div class="page-width">
    {% if section.settings.layout == 'slider' %}
      <div
        id="fc{{ section.id }}"
        class="swiper swipes"
        data-swiper="fc{{ section.id }}">
        <div class="cc__featured-collection-header{% if section.settings.heading != blank %} cc__withheading{% endif %}">
          {% if section.settings.heading != blank %}
          <div class="cc__featured-collection-heading">
            <{{ section.settings.htags }} class="cc__featured-collection-inner-heading">{{ section.settings.heading }}</{{ section.settings.htags }}>
          </div>
          {% endif %}
          <div class="cc__fc-navigation">
            <div class="sp-button-prev-fc{{ section.id }} fcswipes-button">
              <svg
                width="26"
                height="14"
                viewBox="0 0 26 14"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M0.926495 7.39212L6.48786 12.9535C6.68764 13.1868 7.03873 13.214 7.27201 13.0142C7.50529 12.8144 7.53248 12.4633 7.33266 12.23C7.31402 12.2083 7.29375 12.188 7.27201 12.1694L2.66163 7.55343L24.6792 7.55343C24.9863 7.55343 25.2354 7.30443 25.2354 6.99726C25.2354 6.69009 24.9863 6.44114 24.6792 6.44114L2.66163 6.44113L7.27201 1.83076C7.50529 1.63098 7.53248 1.27989 7.33266 1.04661C7.13283 0.813332 6.78179 0.786138 6.54851 0.985962C6.52677 1.0046 6.50646 1.02486 6.48786 1.04661L0.926447 6.60803C0.710852 6.82487 0.710852 7.17519 0.926495 7.39212Z" fill="#fff" />
              </svg>
            </div>
            <div class="sp-button-next-fc{{ section.id }} fcswipes-button">
              <svg
                width="26"
                height="14"
                viewBox="0 0 26 14"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M25.0735 6.60788L19.5121 1.04646C19.3124 0.813181 18.9613 0.785987 18.728 0.98581C18.4947 1.18559 18.4675 1.53668 18.6673 1.76995C18.686 1.7917 18.7062 1.81201 18.728 1.8306L23.3384 6.44658L1.32077 6.44657C1.01365 6.44657 0.764647 6.69557 0.764647 7.00274C0.764647 7.30991 1.01365 7.55886 1.32077 7.55886L23.3384 7.55887L18.728 12.1692C18.4947 12.369 18.4675 12.7201 18.6673 12.9534C18.8672 13.1867 19.2182 13.2139 19.4515 13.014C19.4732 12.9954 19.4935 12.9751 19.5121 12.9534L25.0736 7.39197C25.2891 7.17514 25.2891 6.82481 25.0735 6.60788Z" fill="#fff" />
              </svg>
            </div>
          </div>
        </div>

        <div class="swiper-wrapper">
          {% if collection == blank %}
            {% for placeholder in (1..6) %}
              <div class="swiper-slide">
                <div class="cc__inner-product-details">
                  <div class="cc__product-featured-image">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                  <div class="cc__product-details">
                    <h3>Example Product Title</h3>
                    <div class="cc__fc_product-price">
                      <p class="cc__product-price">{{ 1999 | money }}</p>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% for product in collection.products limit: limit %}
              {%- capture wlm_check -%}{%- render 'wlm-product' with product , wlm_is_render:'yes' -%}{%- endcapture -%}{%- if wlm_check == blank -%}{%continue%}{%- endif -%}
              {% liquid
                        assign current_variant = product.selected_or_first_available_variant
                    %}
              <div class="swiper-slide">
                <div class="cc__inner-product-details">
                  <div class="cc__inner-product-details-content">
                    <a href="{{ product.url }}"></a>
                    <div class="cc__product-featured-image">
                      <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title | append: ' image' }}" />
                    </div>
                    <div class="cc__product-details">
                      <h3>{{ product.title }}</h3>
                      <div class="cc__fc_product-price">
                        {% if product.price_varies %}
                          <p
                            class="cc__product-price"
                            data-wpd-product-handle="{{ product.handle }}"
                            data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                            data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                            data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                            data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                            data-wpd-product-id="{{ product.id }}">
                            <span class="cc__product-price-varies-info">From</span>
                            {{ product.price | money }}
                          </p>
                        {% else %}
                          {% if product.compare_at_price > product.price %}
                            <p class="cc__product-price">
                              <span class="cc__product-orig-price data-wpd-hide">{{ product.compare_at_price | money }}</span>
                              <span
                                class="cc__product-sale-price"
                                data-wpd-product-handle="{{ product.handle }}"
                                data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                                data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                                data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                                data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                                data-wpd-product-id="{{ product.id }}">{{ product.price | money }}</span>
                            </p>
                          {% else %}
                            <p
                              class="cc__product-price"
                              data-wpd-product-handle="{{ product.handle }}"
                              data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                              data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                              data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                              data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                              data-wpd-product-id="{{ product.id }}">{{ product.price | money }}</p>
                          {% endif %}
                        {% endif %}
                        {% if product.metafields.custom.quantity != blank %}
                          |
                          <p class="cc__productquantity-info">{{ product.metafields.custom.quantity }}</p>
                        {% endif %}


                      </div>
                    </div>
                  </div>
                  {% if product.available %}
                    {% if product.variants.size > 1 %}
                      <a class="btn btn--to-secondary btn--full btn__multiplevariants" href="{{ product.url }}">Shop Now</a>
                    {% else %}
                      <div
                        data-section-type="featured-collection"
                        data-section-id="{{ section.id }}{{ block.id }}"
                        data-variant-id="{{ current_variant.id }}">
                        <div
                          class="product__form-container"
                          itemprop="offers"
                          itemscope
                          itemtype="http://schema.org/Offer">
                          <div class="product__form-wrapper">
                            <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
                            <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                            <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

                            {% include 'cc-product-form' %}
                            <script type="application/json" data-product-json>
                              {{ product | json }}
                            </script>

                          </div>
                        </div>
                      </div>
                    {% endif %}
                  {% else %}
                    <button class="btn btn--to-secondary btn--full" disabled>{{ 'products.product.sold_out' | t }}</button>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% else %}
      <div clas="cc__featured-collection-grid">
        {% if section.settings.heading != blank %}
          <div class="cc__featured-collection-header{% if section.settings.heading != blank %} cc__withheading{% endif %}">
            <div class="cc__featured-collection-heading">
              <{{ section.settings.htags }} class="cc__featured-collection-inner-heading">{{ section.settings.heading }}</{{ section.settings.htags }}>
            </div>
          </div>
        {% endif %}
        <div class="cc__featured-collection-grid-lists">
          {% if collection == blank %}
            {% for placeholder in (1..6) %}
              <div class="cc__featured-collection-grid-items">
                <div class="cc__inner-product-details">
                  <div class="cc__product-featured-image">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                  <div class="cc__product-details">
                    <h3>Example Product Title</h3>
                    <div class="cc__fc_product-price">
                      <p class="cc__product-price">{{ 1999 | money }}</p>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% for product in collection.products limit: limit %}
              {%- capture wlm_check -%}{%- render 'wlm-product' with product , wlm_is_render:'yes' -%}{%- endcapture -%}{%- if wlm_check == blank -%}{%continue%}{%- endif -%}
              {% liquid
                        assign current_variant = product.selected_or_first_available_variant
                    %}
              <div class="cc__featured-collection-grid-items">
                <div class="cc__inner-product-details">
                  <div class="cc__inner-product-details-content">
                    <a href="{{ product.url }}"></a>
                    <div class="cc__product-featured-image">
                      <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title | append: ' image' }}" />
                    </div>
                    <div class="cc__product-details">
                      <h3>{{ product.title }}</h3>
                      <div class="cc__fc_product-price">
                        {% if product.price_varies %}
                          <p
                            class="cc__product-price"
                            data-wpd-product-handle="{{ product.handle }}"
                            data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                            data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                            data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                            data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                            data-wpd-product-id="{{ product.id }}">
                            <span class="cc__product-price-varies-info">From</span>
                            {{ product.price | money }}
                          </p>
                        {% else %}
                          {% if product.compare_at_price > product.price %}
                            <p class="cc__product-price">
                              <span class="cc__product-orig-price data-wpd-hide">{{ product.compare_at_price | money }}</span>
                              <span
                                class="cc__product-sale-price"
                                data-wpd-product-handle="{{ product.handle }}"
                                data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                                data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                                data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                                data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                                data-wpd-product-id="{{ product.id }}">{{ product.price | money }}</span>
                            </p>
                          {% else %}
                            <p
                              class="cc__product-price"
                              data-wpd-product-handle="{{ product.handle }}"
                              data-wpd-variant-id="{{ product.selected_or_first_available_variant.id }}"
                              data-wpd-variant-price="{{ product.selected_or_first_available_variant.price }}"
                              data-wpd-variant-compare-at-price="{{ product.selected_or_first_available_variant.compare_at_price }}"
                              data-wpd-product-collection-ids="{% assign wpdProductCollectionIds = product.collections | map:'id' %}{{ wpdProductCollectionIds | join:',' }}"
                              data-wpd-product-id="{{ product.id }}">{{ product.price | money }}</p>
                          {% endif %}
                        {% endif %}
                        {% if product.metafields.custom.quantity != blank %}
                          |
                          <p class="cc__productquantity-info">{{ product.metafields.custom.quantity }}</p>
                        {% endif %}


                      </div>
                    </div>
                  </div>
                  {% if product.available %}
                    {% if product.variants.size > 1 %}
                      <a class="btn btn--to-secondary btn--full btn__multiplevariants" href="{{ product.url }}">Shop Now</a>
                    {% else %}
                      <div
                        data-section-type="featured-collection"
                        data-section-id="{{ section.id }}{{ block.id }}"
                        data-variant-id="{{ current_variant.id }}">
                        <div
                          class="product__form-container"
                          itemprop="offers"
                          itemscope
                          itemtype="http://schema.org/Offer">
                          <div class="product__form-wrapper">
                            <meta itemprop="price" content="{{ current_variant.price | divided_by: 100.00 }}">
                            <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
                            <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

                            {% include 'cc-product-form' %}
                            <script type="application/json" data-product-json>
                              {{ product | json }}
                            </script>

                          </div>
                        </div>
                      </div>
                    {% endif %}
                  {% else %}
                    <button class="btn btn--to-secondary btn--full" disabled>{{ 'products.product.sold_out' | t }}</button>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

    {% endif %}
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.mpadtop | append: 'px' }}
    ;
    padding-bottom: {{ section.settings.mpadbot | append: 'px' }}
    ;
    background-color: {{ section.settings.bgcolor }}
    ;
  }

  #shopify-section-{{ section.id }} .cc__featured-collection-header {
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .cc__featured-collection-header.cc__withheading {
    display: flex;
    gap: 16px;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .cc__inner-product-details-content {
    position: relative;
  }

  #shopify-section-{{ section.id }} .cc__inner-product-details .cc__inner-product-details-content a {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: inline-block;
    z-index: 5;
  }



  #shopify-section-{{ section.id }} .cc__featured-collection-header .cc__featured-collection-heading .cc__featured-collection-inner-heading {
    margin: 0;
    font-size: {{ section.settings.mhsize | append: 'px' }};
    color: {{ section.settings.tcolor }};
    text-align: center;
  }


  #shopify-section-{{ section.id }} .cc__featured-collection-header:not(.cc__withheading) .cc__fc-navigation {
    margin-left: auto;
  }


  #shopify-section-{{ section.id }} .cc__fc-navigation {
    width: auto;
    display: none;
    align-items: center;
    gap: 16px;
    justify-content: space-between;
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .fcswipes-button {
    background-color: {{ section.settings.arrowcolor }};
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 100%;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .swiper-button-disabled {
    opacity: 50%;
  }


  #shopify-section-{{ section.id }} .swiper-slide {
    width: 70%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .cc__product-featured-image {
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .cc__product-featured-image svg {
    aspect-ratio: 1 / 1;
    background-color: #f3f3f3;
    display: block;
  }

  #shopify-section-{{ section.id }} .cc__product-featured-image img {
    aspect-ratio: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .cc__product-details h3 {
    margin-bottom: 14px;
    font-size: clamp(1.125rem, 0.804vw + 0.964rem, 1.688rem);
    line-height: 1.2;
    font-weight: 400;
    color: {{ section.settings.tcolor }}
    ;
  }

  #shopify-section-{{ section.id }} .cc__product-price {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.tcolor }}
    ;
  }

  #shopify-section-{{ section.id }} .cc__product-orig-price {
    text-decoration: line-through;
    opacity: 0.75;
  }

  #shopify-section-{{ section.id }} .cc__fc_product-price {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .cc__fc_product-price p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cc__productquantity-info, #shopify-section-{{ section.id }} .cc__product-price-varies-info {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    color: {{ section.settings.tcolor }}
    ;
  }


  #shopify-section-{{ section.id }} .product__form-container {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .btn {
    font-size: 14px;
    text-transform: UPPERCASE;
    background-color: #695450;
    border: 2px solid #695450;
    transition: all 0.3s ease;
    line-height: 1.2;
   padding: 10px;
    font-weight: 600;
    margin-top: 16px;
  }



  #shopify-section-{{ section.id }} .btn:after {
    outline: unset !important;
  }

  #shopify-section-{{ section.id }} .btn:hover {
    background-color: #977e57;
    border: 2px solid #977e57;
  }


  #shopify-section-{{ section.id }} .cc__inner-product-details {
    height: 100%;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    -ms-flex-direction: column;
    flex-direction: column;
    -webkit-box-pack: justify;
    -ms-flex-pack: justify;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .product__notification:empty {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cc__featured-collection-grid-lists {
    display: grid;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.dpadtop | append: 'px' }};
      padding-bottom: {{ section.settings.dpadbot | append: 'px' }};
    }

    #shopify-section-{{ section.id }} .cc__featured-collection-header {
      margin-bottom: 38px;
    }

    #shopify-section-{{ section.id }} .cc__featured-collection-header.cc__withheading .cc__featured-collection-heading {
      width: calc(100% - 200px);
    }

    #shopify-section-{{ section.id }} .cc__featured-collection-header .cc__featured-collection-heading .cc__featured-collection-inner-heading {
      font-size: {{ section.settings.dhsize | append: 'px' }};
      text-align: left;
    }

    #shopify-section-{{ section.id }} .swiper-slide {
      width: 50%;
    }

    #shopify-section-{{ section.id }} .cc__product-details h3 {
      font-size: clamp(1.125rem, 0.804vw + 0.964rem, 1.688rem);
    }

    #shopify-section-{{ section.id }} .cc__featured-collection-header.cc__withheading {
      display: flex;
      align-items: center;
      gap: 16px;
      justify-content: space-between;
      flex-direction: row;
    }

    #shopify-section-{{ section.id }} .cc__fc-navigation {
      width: 178px;
      display: flex;
    }
    #shopify-section-{{ section.id }} .cc__featured-collection-grid-lists {
      gap: 40px 30px;
      grid-template-columns: repeat(2, 1fr);
    }
    #shopify-section-{{ section.id }} .btn {
      padding: 10px 30px;
      font-size: 16px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .swiper-slide {
      width: calc(33.33% - 12px);
    }
  }
</style>
{% schema %}
  {
    "name": "MS Featured Collection",
    "settings": [
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "default": "slider",
        "options": [
          {
            "value": "slider",
            "label": "Slider"
          }, {
            "value": "grid",
            "label": "Grid"
          }
        ]
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "productlimit",
        "label": "Product to show",
        "default": 10,
        "min": 1,
        "max": 50
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Our Products"
      }, 
      {
          "type": "select",
          "id": "htags",
          "label": "Heading Tag",
          "default": "h2",
          "options": [
              {
                  "value": "h1",
                  "label": "H1"
              },
              {
                  "value": "h2",
                  "label": "H2"
              },
              {
                  "value": "h3",
                  "label": "H3"
              },
              {
                  "value": "h4",
                  "label": "H4"
              },
              {
                  "value": "h5",
                  "label": "H5"
              },
              {
                  "value": "h6",
                  "label": "H6"
              }
          ]
      },
      {
        "type": "number",
        "id": "dhsize",
        "label": "Heading size (desktop)",
        "default": 64,
        "info": "Unit in px"
      }, {
        "type": "number",
        "id": "mhsize",
        "label": "Heading size (mobile)",
        "default": 32,
        "info": "Unit in px"
      }, {
        "type": "header",
        "content": "Styles"
      }, {
        "type": "color",
        "id": "bgcolor",
        "label": "Background color",
        "default": "#F7F8F4"
      }, {
        "type": "color",
        "id": "tcolor",
        "label": "Text color",
        "default": "#695450"
      }, {
        "type": "color",
        "id": "arrowcolor",
        "label": "Arrow color",
        "default": "#695450"
      }, {
        "type": "number",
        "id": "dpadtop",
        "label": "Padding top(desktop)",
        "default": 70,
        "info": "Unit in px"
      }, {
        "type": "number",
        "id": "dpadbot",
        "label": "Padding bottom(desktop)",
        "default": 70,
        "info": "Unit in px"
      }, {
        "type": "number",
        "id": "mpadtop",
        "label": "Padding top(mobile)",
        "default": 35,
        "info": "Unit in px"
      }, {
        "type": "number",
        "id": "mpadbot",
        "label": "Padding bottom(mobile)",
        "default": 35,
        "info": "Unit in px"
      }
    ],
    "presets": [
      {
        "name": "MS Featured Collection"
      }
    ]
  }
{% endschema %}