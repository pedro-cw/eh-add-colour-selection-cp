
<div class="ms__blogs-banner">
    <div class="page-width">
    {% if section.settings.mainimage != blank %}
    <img class="ms__blog-featured-image" src="{{ section.settings.mainimage | img_url: 'master' }}" alt="{{ section.settings.mainimage.alt | default: article.title }}" />
    {% else %}
    <div class="ms__blog-featured-image">
        {{ 'image' | placeholder_svg_tag }}
    </div>
    {% endif %}
    {% if blog.title != blank or blog.metafields.custom.short_description != blank %}
    <div class="ms__blogs-banner-contents">

            <div class="ms__blogs-banner-contents-item">
               
                <div class="ms__blogs-inner-banner">
                    <h1>{{ section.settings.heading | default: blog.title }}</h1>
                    {% if blog.metafields.custom.short_description != blank %}
                    <div class="ms__blogs-banner-contents-rte">
                        {{ blog.metafields.custom.short_description | metafield_tag }}
                    </div>
                    {% endif %}
                </div>
            </div>
       
    </div>

    {% endif %}
    </div>
</div>

<div class="ms__blog_gridlist">
    <div class="page-width">
        <div class="ms__blog_grid-list-items">
        {% for article in blog.articles %}
            {% liquid
                assign article_read_time = article.content | strip_html | split: ' ' | size | times: 1.0 | divided_by: 250 | ceil 
            %}
            <div class="ms__blog-gridlist-item">
                <div class="ms__blog-gridlist-inner">
                    <a href="{{ article.url }}"></a>
                    {% if article.image != blank %}
                    <div class="ms__blog-grid-list-featuredimage">
                        <img src="{{ article.image | img_url: 'master' }}" alt="{{ article.title | append: ' image' }}" />
                    </div>
                    {% endif %}
                    <div class="ms__blog-gridlist-contents">
                        <div class="ms__blog-gridlist-meta">
                            <div class="ms__blog-gridlist-estimatedread">{{ article_read_time }} min read</div>
                            <div class="ms__blog-gridlist-date">{{ article.published_at | date: '%m/%d/%Y' }}</div>
                        </div>
                        <h2>{{ article.title }}</h2>
                        <p class="ms__blog-readmore">Read More <svg width="29" height="11" viewBox="0 0 29 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M28.3309 6.09115H0.669335C0.340296 6.09115 0.0744629 5.82532 0.0744629 5.49628C0.0744629 5.16724 0.340296 4.90141 0.669335 4.90141H26.8939L23.2838 1.29128C23.0514 1.05891 23.0514 0.681538 23.2838 0.449166C23.5161 0.216794 23.8935 0.216794 24.1259 0.449166L28.7529 5.07615C28.9239 5.24718 28.9741 5.50186 28.8811 5.72494C28.7882 5.94615 28.5707 6.09115 28.3309 6.09115Z" fill="currentColor"/>
                        <path d="M23.6984 10.7237C23.546 10.7237 23.3935 10.6661 23.2783 10.549C23.0459 10.3166 23.0459 9.93923 23.2783 9.70686L27.9108 5.0743C28.1432 4.84192 28.5206 4.84192 28.753 5.0743C28.9853 5.30667 28.9853 5.68404 28.753 5.91641L24.1204 10.549C24.0033 10.6661 23.8508 10.7237 23.6984 10.7237Z" fill="currentColor"/>
                        </svg>
                        </p>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>
<style>
    #shopify-section-{{ section.id }} {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ms__blogs-banner{
    padding-top: {{ section.settings.mpadtop | append: 'px'}};
    padding-bottom: {{ section.settings.mpadbot | append: 'px'}};
    {% if section.settings.bg_image != blank %}
        background-image: url({{ section.settings.bg_image | img_url: 'master' }});
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .page-width{
    position: relative;
  }
    #shopify-section-{{ section.id }} .ms__blogs-banner-contents h1{
        margin: 0;
        font-size: {{ section.settings.mhsize | append: 'px' }};
    }

    #shopify-section-{{ section.id }} .ms__blogs-inner-banner{
        flex-direction: column;
        display: flex;
        gap: 16px;
    }

    #shopify-section-{{ section.id }} .ms__blog-featured-image{
        width: 100%;
        height: 400px;
        display: block;
        object-fit: cover;
        object-position: center;
    }

    #shopify-section-{{ section.id }} .ms__blog-featured-image svg{
        width: 100%;
        height: 100%;
        object-fit: cover;
        background-color: #f3f3f3;
    }

    #shopify-section-{{ section.id }} .ms__blogs-banner-contents p:only-child,
    #shopify-section-{{ section.id }} .ms__blogs-banner-contents p:last-child{
        margin: 0;
    }

    #shopify-section-{{ section.id }} .ms__blogs-banner {
        position: relative;
    }

    #shopify-section-{{ section.id }} .ms__blogs-banner-contents{
        width: 100%;
    }

    #shopify-section-{{ section.id }} .ms__blogs-banner-contents-item{
        max-width: 100%;
        padding: 30px 25px;
        background-image: url({{ 'contentcollectionbackground.jpg' | asset_url }});
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        position: relative;
    }

    

    #shopify-section-{{ section.id }} .ms__blog_grid-list-items{
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 40px;
    }

    #shopify-section-{{ section.id }} .ms__blog_gridlist{
        padding: 30px 0 50px;
        background-color: {{ section.settings.gridbg }};
    }

    #shopify-section-{{ section.id }} .ms__blog-grid-list-featuredimage{
        width: 100%;
        height: 300px;
    }

    #shopify-section-{{ section.id }} .ms__blog-grid-list-featuredimage img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    #shopify-section-{{ section.id }} .ms__blog-gridlist-contents {
        padding: 40px 16px;
        background-color: {{ section.settings.gridcontentbg }};
        color: {{ section.settings.gridcontent }};
    }

    #shopify-section-{{ section.id }} .ms__blog-gridlist-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 14px;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        color: inherit;
    }

    #shopify-section-{{ section.id }} .ms__blog-gridlist-contents h2{
        font-size: 20px;
        max-height: 58px;
        font-family: {{ settings.type_base_font.family }}, {{ settings.type_base_font.fallback_families }};
        line-height: 1.1;
        color: inherit;
        text-transform: none;
        min-height: 58px;
    }

    #shopify-section-{{ section.id }} .ms__blog-gridlist-inner{
        position: relative;
    }

    #shopify-section-{{ section.id }} .ms__blog-gridlist-inner a,
    #shopify-section-{{ section.id }} .ms__blogs-banner-contents-item a{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    #shopify-section-{{ section.id }} .ms__blog-readmore {
      text-transform: UPPERCASE;
      margin-top: 33px;
      color: inherit;
      display: flex;
      align-items: center;
      gap: 26px;
      position: relative;
      background: linear-gradient(to right, currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: center bottom;
      background-size: 0 1px;
      transition: all 0.3s ease;
      width: fit-content;
    }

    #shopify-section-{{ section.id }} .ms__blog-gridlist-inner:hover .ms__blog-readmore {
      background-size: 100% 1px;
    }

    @media screen and (min-width: 750px){
        #shopify-section-{{ section.id }} {
            overflow: hidden;
        }
        #shopify-section-{{ section.id }} .ms__blogs-banner{
            padding-top: {{ section.settings.dpadtop | append: 'px'}};
            padding-bottom: {{ section.settings.dpadbot | append: 'px'}};
        }
        #shopify-section-{{ section.id }} .ms__blogs-banner-contents h1{
            font-size: {{ section.settings.dhsize | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .ms__blog-featured-image {
        height: 615px;
        max-width: 65%;
        }

        #shopify-section-{{ section.id }} .ms__blogs-banner-contents{
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            right: 20px;
            bottom: unset;
        }

        #shopify-section-{{ section.id }} .ms__blogs-banner-contents-item{
            max-width: 514px;
            padding: 72px 50px;
            margin-left: auto;
        }

        #shopify-section-{{ section.id }} .ms__blog_grid-list-items{
            grid-template-columns: repeat(2, 1fr);
            gap: 40px 20px;
        }

        #shopify-section-{{ section.id }} .ms__blog_gridlist{
            padding: 60px 0 100px;
        }

        #shopify-section-{{ section.id }} .ms__blog-grid-list-featuredimage{
            width: 100%;
            height: 334px;
        }

        #shopify-section-{{ section.id }} .ms__blog-gridlist-meta {
            margin-bottom: 26px;
        }

        #shopify-section-{{ section.id }} .ms__blog-gridlist-contents h2{
            font-size: 24px;
        }
    }
</style>
{% schema %}
    {
        "name": "MS Blog",
        "settings": [
            {
                "type": "image_picker",
                "id": "mainimage",
                "label": "Main Image"
            },
            {
                "type": "header",
                "content": "Styles"
            },
            {
                "type": "image_picker",
                "id": "bg_image",
                "label": "Background"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "info": "If this is empty, it will we use the default blog title"
            },
            {
                "type": "number",
                "id": "dhsize",
                "label": "Heading size (desktop)",
                "default": 48,
                "info": "Unit in px. This is for the featured blog posts"
            },
            {
                "type": "number",
                "id": "mhsize",
                "label": "Heading size (mobile)",
                "default": 32,
                "info": "Unit in px. This is for the featured blog posts"
            },
            {
                "type": "header",
                "content": "Main Banner"
            },
            {
                "type": "number",
                "id": "dpadtop",
                "label": "Padding top(desktop)",
                "default": 46,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "dpadbot",
                "label": "Padding bottom(desktop)",
                "default": 46,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "mpadtop",
                "label": "Padding top(mobile)",
                "default": 30,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "mpadbot",
                "label": "Padding bottom(mobile)",
                "default": 30,
                "info": "Unit in px"
            },
            {
                "type": "header",
                "content": "Grid List"
            },
            {
                "type" : "color",
                "id": "gridbg",
                "label": "Background color",
                "default": "#F7F8F4"
            },
            {
                "type": "color",
                "id": "gridcontent",
                "label": "Content color",
                "default": "#695450"
            },
            {
                "type": "color",
                "id": "gridcontentbg",
                "label": "Content background",
                "default": "#fff"
            }
        ]
    }
{% endschema %}