        "default": "#695450"
      }
    ],
    "blocks": [
      {
        "type": "collection",
        "name": "Category",
        "settings": [
          {
            "type": "text",
            "id": "filter-title",
            "label": "Category Name"
          }, {
            "type": "product_list",
            "id": "pdp_list",
            "label": "Products"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Build Your Bundle"
      }
    ]
  }
{% endschema %}