<style>
  /* --- RESET & VARIABLES --- */
  .bundle-section-wrapper {
    background-color: {{ st.bgcolor }};
    padding: 60px 130px;
    font-family: var(--font-body-family);
    color: {{ st.tcolor }};
  }

  .bundle-sectoin-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* --- HEADER --- */
  .bundle-header {
    margin-bottom: 70px;
  }
  .bundle-title {
    color: #695450;
    font-family: Botanica;
    font-size: 48px;
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 24px;
  }
  .bundle-subtitle {
    color: #977E57;
    font-family: Montserrat;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: capitalize;
  }

  /* --- TABS --- */
  .bundle-tabs-wrapper {
    margin-bottom: 28px;
  }
  .bundle-tabs-scroll {
    display: flex;
    justify-content: flex-start;
    margin: 0 auto;
    gap: 15px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .bundle-tabs-scroll::-webkit-scrollbar {
    display: none;
  }

  .bundle-tab {
    border: 1px solid #977E57;
    background: #977E57;
    color: #fff;
    padding: 10px 20px;
    cursor: pointer;
    transition: all 0.3s;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 600;
    line-height: 14px;
    /* 116.667% */
    letter-spacing: 1px;
    text-transform: capitalize;
    white-space: nowrap;
  }
  .bundle-tab.active,
  .bundle-tab:hover {
    background: #695450;
  }

  /* --- LAYOUT --- */
  .bundle-main-layout {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }
  .bundle-products-area {
    flex: 1;
    width: 100%;
  }
  .bundle-sidebar-wrapper {
    width: 400px;
    flex-shrink: 0;
    position: sticky;
    top: 20px;
    z-index: 10;
  }

  /* --- GRID PRODUCTS --- */
  .bundle-product-group {
    display: none;
    animation: fadeIn 0.4s ease;
  }
  .bundle-product-group.active {
    display: block;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .bundle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* --- CARD --- */
  .product-card {
    border: 0.3px solid #977E57;
    background: #FFF;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.3s ease;
    position: relative;
  }

  .card-link-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .card-actions {
    position: relative;
    z-index: 2;
  }
  .card-image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    background: #f9f9f9;
    margin-bottom: 15px;
    overflow: hidden;
  }
  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s;
  }
  .img-hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .product-card:hover .img-hover {
    opacity: 1;
  }

  .card-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    margin-bottom: 16px;
  }
  .card-info h3 {
    flex: 1;
    min-height: 42px;
    max-height: 42px;
    color: #000;
    font-family: Botanica;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 1px;
  }
  .card-description {
    color: #000;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 400;
    text-transform: capitalize;
    max-width: 217px;
  }
  .card-price {
    color: #695450;
    font-family: Montserrat;
    font-size: 16px;
    font-weight: 700;
    line-height: 19.2px;
    /* 120% */
    letter-spacing: 1px;
    text-transform: capitalize;
    margin-bottom: 6px;
  }
  .btn-add,
  .btn-added {
    width: 100%;
    padding: 10px;
    border: none;
    cursor: pointer;
    transition: 0.2s;
    color: #F3EEEA;
    text-align: center;
    font-family: Montserrat;
    font-size: 16px;
    font-weight: 600;
    line-height: 19.2px;
    /* 120% */
    letter-spacing: 1px;
    text-transform: capitalize;
  }
  .btn-add {
    background: #695450;
  }
  .btn-add:hover {
    background: #503d3a;
  }
  .btn-added {
    background: #F3EEEA;
    color: #695450;
    cursor: default;
  }

  /* --- SIDEBAR --- */
  .progress-container {
    display: flex;
    text-align: center;
    background: #fff;
    padding: 16px;
    margin-bottom: 10px;
    flex-direction: column;
    gap: 13px;
  }
  .progress-status {
    color: #695450;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: capitalize;
    margin-bottom: 0;
  }
  .progress-bar-bg {
    height: 6px;
    background: #F3EEEA;
    border-radius: 500px;
    position: relative;
    margin: 4px 0;
  }
  .progress-bar-fill {
    height: 100%;
    background: #695450;
    border-radius: 3px;
    width: 0;
    transition: width 0.5s;
  }
  .progress-marker {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: 0.3s;
  }
  .progress-marker .icon-check {
    display: none;
  }
  .progress-marker.reached .icon-lock {
    display: none;
  }
  .progress-marker.reached .icon-check {
    display: block;
  }
  .data-count-3 {
    left: 25%;
  }
  .data-count-4 {
    left: 66%;
  }
  .data-count-6 {
    left: 98%;
  }
  .progress-labels {
    display: flex;
    justify-content: space-between;
    color: #888;
    margin-left: -20px;
  }
  .progress-labels span {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #695450;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 600;
    line-height: normal;
    text-transform: capitalize;
    width: 33%;
  }
  .progress-labels strong {
    color: #977E57;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
    text-transform: capitalize;
    white-space: nowrap;
  }
  .progress-labels span.tier-active strong {
    color: #5A9757;
    font-weight: 600;
  }
  .discount-active-msg {
    display: flex !important;
    justify-content: center;
    gap: 5px;
    color: #5A9757;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: capitalize;
    margin-top: 0;
    animation: fadeIn 0.5s ease;
  }

  .checkout-summary {
    background: #fff;
    padding: 16px;
  }
  .sidebar-list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .sidebar-list-header .title,
  .sidebar-list-header .count {
    display: flex;
    align-items: center;
    color: #695450;
    font-family: Botanica;
    font-size: 20px;
    font-weight: 400;
  }
  .sidebar-items-scroll {
    display: flex;
    flex-direction: column;
    gap: 17px;
    overflow-y: auto;
    margin-bottom: 17px;
    border-bottom: 1px solid #F3EEEA;
    padding-bottom: 17px;
  }
  .empty-state-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: fadeIn 0.5s ease;
  }
  .empty-icon {
    margin-top: 40px !important;
    margin-bottom: 16px !important;
  }
  .empty-icon svg {
    width: 57px;
    height: 57px;
  }
  .empty-title {
    color: #695450;
    font-family: Botanica;
    font-size: 20px;
    font-weight: 400;
    margin: 0 0 8px;
  }
  .empty-subtitle {
    color: #695450;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 300;
  }
  .bundle-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    animation: fadeIn 0.3s;
  }
  .item-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .item-img {
    width: 48px;
    height: 48px;
    object-fit: cover;
  }
  .item-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .item-title {
    color: #695450;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 600;
    line-height: normal;
    letter-spacing: 1px;
    text-transform: capitalize;
  }
  .item-price {
    color: #695450;
    font-family: Montserrat;
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: 1px;
    text-transform: capitalize;
  }
  .item-remove {
    cursor: pointer;
    color: #bbb;
    padding: 5px;
    font-size: 16px;
  }
  .item-remove:hover {
    color: #d00;
  }

  .sidebar-totals {
    display: flex;
    flex-direction: column;
    gap: 17px;
  }
  .sidebar-totals .row {
    display: flex;
    justify-content: space-between;
    line-height: normal;
  }
  .subtotal-row,
  .saved,
  .shipping-row,
  .discount-row {
    color: #000;
    font-family: Montserrat;
    font-size: 14px;
    font-weight: 500;
  }
  .discount-row,
  .shipping-row {
    color: #5A9757;
  }
  .line-through {
    text-decoration: line-through;
  }
  .divider {
    height: 1px;
    background: #F3EEEA;
    margin: 0;
  }
  .final,
  #final-price {
    color: #695450;
    font-family: Montserrat;
    font-size: 16px;
    font-weight: 500;
  }
  #final-price {
    color: #5A9757;
    text-align: right;
  }
  .btn-checkout {
    width: 100%;
    background: #695450;
    color: #fff;
    padding: 15px;
    border: none;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 13px;
    letter-spacing: 1px;
    margin-top: 20px;
    cursor: pointer;
    transition: 0.3s;
  }
  .btn-checkout:disabled {
    background: #dcdcdc;
    cursor: not-allowed;
  }
  .btn-checkout:hover:not(:disabled) {
    background: #503d3a;
  }
  .checkout-summary.is-empty {
    border: none;
    box-shadow: none;
  }
  .checkout-summary.is-empty .sidebar-totals,
  .checkout-summary.is-empty .btn-checkout,
  .checkout-summary.is-empty .count {
    display: none !important;
  }
  .checkout-summary.is-empty .sidebar-items-scroll {
    border-bottom: none;
    margin-bottom: 0;
  }

  /* --- MOBILE STICKY STYLES --- */
  .mobile-sticky-wrapper {
    display: none;
  } /* Default Hidden on Desktop */

  @media (max-width: 991px) {
    .bundle-main-layout {
      flex-direction: column;
    }
    .desktop-only-sidebar {
      display: none;
    }
    .bundle-section-wrapper {
      padding: 30px 20px;
    }
    .bundle-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .bundle-products-area {
      padding-bottom: 100px;
    }

    /* Show Mobile Bar */
    .mobile-sticky-wrapper {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
    }

    /* BARRA FIXA */
    .mobile-sticky-bar {
      background: #FFF;
      padding: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      cursor: pointer;
      z-index: 1002;
      position: relative;
      height: 67px;
    }

    .mb-left-group {
      display: flex;
      align-items: center;
    }

    .mb-bag-icon {
      position: relative;
      display: flex;
      align-items: center;
    }
    .mb-count-badge {
      position: absolute;
      transform: translate(-50%, -40%);
      font-size: 10px;
      font-weight: 700;
      color: #695450;
    }
    .mb-bag-icon.has-items .mb-count-badge {
      color: #fff;
    }

    .mb-chevron svg {
      transition: transform 0.3s ease;
    }
    .mobile-sticky-wrapper.open .mb-chevron svg {
      transform: rotate(180deg);
    }

    .mb-text-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .mb-main-text {
      color: #695450;
      font-family: Montserrat;
      font-size: 12px;
      font-style: normal;
      font-weight: 600;
      line-height: normal;
      letter-spacing: 1px;
      text-transform: capitalize;
      max-width: 150px;
    }
    .mb-sub-text {
      color: #695450;
      font-family: Montserrat;
      font-size: 12px;
      font-style: normal;
      font-weight: 400;
      line-height: normal;
      letter-spacing: 1px;
      text-transform: capitalize;
    }

    .mb-checkout-btn {
      background: #695450;
      padding: 18px 16px;
      border: none;
      color: #FFF;
      font-family: Montserrat;
      font-size: 16px;
      font-style: normal;
      font-weight: 600;
      line-height: 11px;
      /* 0% */
      cursor: pointer;
    }

    .mb-checkout-btn:disabled {
      background: #D9D9D9;
    }

    /* DRAWER CONTENT (Gaveta) */
    .mobile-drawer-content {
      position: absolute;
      bottom: 100%;
      left: 0;
      width: 100%;
      background: #fff;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease-in-out
      , box-shadow 0.3s;
      box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.05);
      z-index: 1001;
    }
    .mobile-sticky-wrapper.open .mobile-drawer-content {
      max-height: 500px;
      border-radius: 8px 8px 0 0;
    }

    .mobile-drawer-inner {
      padding: 10px;


    }

    /* Progress Bar Mobile Adjustments */
    .mobile-progress {
      padding: 16px;
    }
    .mobile-labels span {
      font-size: 10px;
      text-align: center;
    }

    /* Horizontal Product List */
    .mobile-products-horizontal {
      display: flex;
      gap: 12px;
      padding-bottom: 5px;
      border-top: 1px solid #F3EEEA;
      padding-top: 15px;
      overflow-x: auto;
    }

    .mobile-products-horizontal::-webkit-scrollbar {
      display: none;
    }


    /* Empty State in Mobile Drawer */
    #mobile-products-list.is-empty {
      display: block;
      border: none;
      padding: 15px;
      /* Remove flex to center content */
    }
    #mobile-products-list.is-empty .empty-state-container {
      margin: 0 auto;
    }
    #mobile-products-list.is-empty .empty-icon {
      margin-top: 10px !important;
      /* Less space on mobile */
    }

    .mobile-prod-thumb {
      position: relative;
      flex-shrink: 0;
      width: 48px;
      height: 48px;
    }

    .mobile-prod-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .mobile-remove-btn {
      position: absolute;
      top: -6px;
      right: -6px;
      background: #B83939;

      color: #FFF;
      text-align: center;
      font-family: Montserrat;
      font-size: 8px;
      font-style: normal;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: capitalize;

      width: 15px;
      height: 15px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
  }
  @media (max-width: 600px) {

    .bundle-header {
      margin-bottom: 24px;
    }
    .bundle-tabs-scroll {
      justify-content: flex-start;
    }
    .bundle-title {
      font-size: 36px;
    }

    .bundle-subtitle {
      font-size: 16px;
    }

    .card-info h3 {
      max-height: unset;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    
    // --- CONSTANTS ---
    const currency = '{{ cart.currency.symbol }}';
    const emptyStateHTML = `
      <div class="empty-state-container">
        <div class="empty-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="57" height="57" viewBox="0 0 57 57" fill="none">
            <path d="M41.6534 15.7967H36.2202C35.8771 11.5175 32.2966 8.14288 27.9301 8.14288C23.5637 8.14288 19.9832 11.5175 19.6401 15.7967H14.2069C12.6599 15.7967 11.3999 17.0567 11.3999 18.6037V46.0501C11.3999 47.5971 12.6599 48.8572 14.2069 48.8572H41.6534C43.2003 48.8572 44.4604 47.5971 44.4604 46.0501V18.6037C44.4604 17.0567 43.2003 15.7967 41.6534 15.7967ZM27.9301 10.0142C31.2611 10.0142 34.012 12.553 34.3426 15.7967H21.5114C21.8483 12.553 24.5991 10.0142 27.9301 10.0142ZM42.589 46.0501C42.589 46.5679 42.1711 46.9858 41.6534 46.9858H14.2069C13.6892 46.9858 13.2712 46.5679 13.2712 46.0501V18.6037C13.2712 18.086 13.6892 17.668 14.2069 17.668H41.6534C42.1711 17.668 42.589 18.086 42.589 18.6037V46.0501Z" fill="#977E57"/>
            <path d="M20.5451 43.257C21.0629 43.257 21.4808 42.839 21.4808 42.3213C21.4808 38.7657 24.3751 35.8714 27.9307 35.8714C31.4863 35.8714 34.3806 38.7657 34.3806 42.3213C34.3806 42.839 34.7985 43.257 35.3163 43.257C35.834 43.257 36.252 42.839 36.252 42.3213C36.252 37.7302 32.5217 34 27.9307 34C23.3397 34 19.6094 37.7302 19.6094 42.3213C19.6094 42.839 20.0274 43.257 20.5451 43.257Z" fill="#977E57"/>
          </svg>
        </div>
        <h4 class="empty-title">your wellness routine awaits</h4>
        <p class="empty-subtitle">Start adding items to build your bundle</p>
      </div>
    `;
  
    // --- STATE ---
    let bundleItems = [];
  
    // --- DOM ELEMENTS (Desktop) ---
    const summaryContainer = document.querySelector('.checkout-summary');
    const listHeader = document.querySelector('.sidebar-list-header');
    const listEl = document.getElementById('bundle-list');
    const countEl = document.getElementById('bundle-count');
    const subtotalEl = document.getElementById('subtotal-price');
    const finalEl = document.getElementById('final-price');
    
    const totalsContainer = document.querySelector('.sidebar-totals');
    const discountRow = document.querySelector('.discount-row');
    const savedRow = document.querySelector('.saved');
    const discountEl = document.getElementById('discount-price');
    const savedEl = document.getElementById('saved-price');
    const percentEl = document.getElementById('discount-percent');
    
    const checkoutBtn = document.getElementById('btn-checkout');
    const shippingRow = document.querySelector('.shipping-row');
    const shippingPriceEl = document.getElementById('shipping-price');
    
    // Progress Desktop
    const progressText = document.getElementById('progress-text');
    const progressFill = document.querySelector('.progress-bar-fill');
    const activeMsg = document.getElementById('discount-active-msg');
  
    // --- DOM ELEMENTS (Mobile) ---
    const mobileWrapper = document.querySelector('.mobile-sticky-wrapper');
    const mobileToggleBar = document.getElementById('mobile-toggle-bar');
    const mbCount = document.getElementById('mb-count');
    const mbMainText = document.getElementById('mb-main-text');
    const mbSubText = document.getElementById('mb-sub-text');
    const mbCheckoutBtn = document.getElementById('mb-btn-checkout');
    const mbList = document.getElementById('mobile-products-list');
    
    // Progress Mobile
    const progressBarContainer = document.querySelector('.mobile-progress');
    const progressTextMobile = document.getElementById('progress-text-mobile');
    const progressFillMobile = document.getElementById('progress-fill-mobile');
    const activeMsgMobile = document.getElementById('discount-active-msg-mobile');
  
    // --- FUNCTIONS ---
    function formatMoney(cents) { return currency + (cents / 100).toFixed(2); }
  
    function updateUI() {
      // 0. Calculations
      const count = bundleItems.length;
      const subtotal = bundleItems.reduce((acc, i) => acc + i.price, 0);
      
      let discountRate = 0;
      if(count >= 6) discountRate = 0.20;
      else if(count >= 4) discountRate = 0.15;
      else if(count >= 3) discountRate = 0.10;
  
      const discountAmount = subtotal * discountRate;
      const total = subtotal - discountAmount;
  
      // -----------------------------
      // 1. DESKTOP UI UPDATES
      // -----------------------------
      listEl.innerHTML = '';
      
      if (count === 0) {
        summaryContainer.classList.add('is-empty');
        totalsContainer.style.display = 'none';
        checkoutBtn.style.display = 'none';
        mbCheckoutBtn.disabled = true;
        progressBarContainer.style.display = 'none';
  
        listEl.innerHTML = emptyStateHTML; 
      } else {
        summaryContainer.classList.remove('is-empty');
        progressBarContainer.style.display = 'flex';
        totalsContainer.style.display = 'flex';
        checkoutBtn.style.display = 'block';
        checkoutBtn.disabled = false;
        mbCheckoutBtn.disabled = false;
        listHeader.style.display = 'flex';
  
        bundleItems.forEach(item => {
          const div = document.createElement('div');
          div.className = 'bundle-list-item';
          div.innerHTML = `<div class="item-left"><img src="${item.image}" class="item-img"><div class="item-info"><span class="item-title">${item.title}</span><span class="item-price">${formatMoney(item.price)}</span></div></div><div class="item-remove" onclick="window.removeItem(${item.id})"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 9L9 15M9 9L15 15M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="#695450" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>`;
          listEl.appendChild(div);
        });
      }
  
      // Update Buttons on Cards
      document.querySelectorAll('.product-card').forEach(card => {
        const id = parseInt(card.dataset.id);
        const btnAdd = card.querySelector('.js-add');
        const btnAdded = card.querySelector('.js-remove');
        if (bundleItems.some(i => i.id === id)) {
          btnAdd.style.display = 'none';
          btnAdded.style.display = 'block';
        } else {
          btnAdd.style.display = 'block';
          btnAdded.style.display = 'none';
        }
      });
  
      // Update Totals (Shared Logic)
      countEl.innerText = count + (count === 1 ? ' item' : ' items');
      subtotalEl.innerText = formatMoney(subtotal);
      finalEl.innerText = formatMoney(total);
  
      if (discountRate > 0) {
        discountRow.style.display = 'flex';
        savedRow.style.display = 'flex';
        discountEl.innerText = '-' + formatMoney(discountAmount);
        savedEl.innerText = formatMoney(discountAmount);
        percentEl.innerText = discountRate * 100;
        subtotalEl.classList.add('line-through');
      } else {
        discountRow.style.display = 'none';
        savedRow.style.display = 'none';
        subtotalEl.classList.remove('line-through');
      }
  
      if (count >= 6) {
        shippingRow.style.display = 'flex';
        shippingPriceEl.innerText = 'Free';
        shippingPriceEl.style.color = '#4b8b5a';
      } else {
        shippingRow.style.display = 'none';
      }
  
      // -----------------------------
      // 2. MOBILE UI UPDATES
      // -----------------------------
      
      // Update Bag Badge
      mbCount.innerText = count;
      const bagIcon = document.querySelector('.mb-bag-icon');
      const badge = document.querySelector('.mb-bag-icon span');
      
      if(count > 0) {
        bagIcon.classList.add('has-items');
        mbCount.style.color = 'white';
        // Add green circle styling
        badge.style.background = '#5A9757';
        badge.style.width = '16px';
        badge.style.height = '16px';
        badge.style.borderRadius = '50%';
        badge.style.display = 'flex';
        badge.style.alignItems = 'center';
        badge.style.justifyContent = 'center';
        badge.style.position = 'absolute';
        badge.style.top = '-3px';
        badge.style.right = '-1px';
        badge.style.transform = 'none';
        badge.style.display = 'flex';
      } else {
        badge.style = "";
        bagIcon.classList.remove('has-items');
        badge.style.display = 'none';
  
      }
  
      // Update Mobile Horizontal List OR Empty State
      mbList.innerHTML = '';
      if(count > 0) {
         mbList.classList.remove('is-empty');
         bundleItems.forEach(item => {
           const div = document.createElement('div');
           div.className = 'mobile-prod-thumb';
           div.innerHTML = `<img src="${item.image}"><div class="mobile-remove-btn" onclick="event.stopPropagation(); window.removeItem(${item.id})">-</div>`;
           mbList.appendChild(div);
         });
      } else {
         // Show empty state in mobile drawer
         mbList.classList.add('is-empty');
         mbList.innerHTML = emptyStateHTML;
      }
  
      // Update Mobile Sticky Text
      mbSubText.innerText = count > 0 ? formatMoney(total) + " Total" : "";
      
      // Update Mobile Sticky Main Text
      // Update Mobile Sticky Main Text
      if(count >= 6) {
        mbMainText.innerText = "Maximum Savings Unlocked!";
      } else if (count >= 4) {
        mbMainText.innerText = `Add ${6 - count} More For 20%`;
      } else if (count >= 3) {
        mbMainText.innerText = `Add 1 More For 15%`;
      } else if (count > 0) {
        mbMainText.innerText = `Add ${3 - count} More To Unlock 10% Savings`;
      } else {
        mbMainText.innerText = "Add 3 Items To Unlock 10% Savings";
      }
      mbMainText.style.color = "#695450";
  
      // -----------------------------
      // 3. PROGRESS LOGIC (Dual Update)
      // -----------------------------
      updateProgress(count, progressText, progressFill, activeMsg); // Desktop
      updateProgress(count, progressTextMobile, progressFillMobile, activeMsgMobile); // Mobile
    }
  
    // --- FUNÇÃO CORRIGIDA AQUI ---
   function updateProgress(count, textEl, fillEl, msgEl) {
      let width = 0;
      if(count >= 6) width = 100;
      else if(count === 5) width = 83; // Passo intermediário visual
      else if(count === 4) width = 66;
      else if(count === 3) width = 33;
      else if(count === 2) width = 22;
      else if(count === 1) width = 11;
      
      fillEl.style.width = width + '%';
  
      const container = fillEl.closest('.progress-container');
  
      if (container) {
        container.querySelectorAll('.progress-marker').forEach(marker => {
          const req = parseInt(marker.dataset.count);
          if (count >= req) marker.classList.add('reached');
          else marker.classList.remove('reached');
        });
  
        const labelSpans = container.querySelectorAll('.progress-labels span');
        labelSpans.forEach(span => span.classList.remove('tier-active'));
        
        if (count >= 3 && labelSpans[0]) labelSpans[0].classList.add('tier-active');
        if (count >= 4 && labelSpans[1]) labelSpans[1].classList.add('tier-active');
        if (count >= 6 && labelSpans[2]) labelSpans[2].classList.add('tier-active');
      }
  
      // Update Text & Messages
      if(count >= 6) {
        textEl.innerText = "Maximum Savings Unlocked!";
        msgEl.innerHTML = '20% Discount Applied & <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M14 8.90104L13.9993 8.90039L11.6796 6.00065L11.679 6H9.99996V10.5117C10.3539 10.1944 10.8205 10 11.3333 10C12.2039 10 12.9427 10.5569 13.2174 11.3333H14V8.90104ZM4.66663 11.3333C4.29844 11.3333 3.99996 11.6318 3.99996 12C3.99996 12.3682 4.29844 12.6667 4.66663 12.6667C5.03482 12.6667 5.33329 12.3682 5.33329 12C5.33329 11.6318 5.03482 11.3333 4.66663 11.3333ZM11.3333 11.3333C10.9651 11.3333 10.6666 11.6318 10.6666 12C10.6666 12.3682 10.9651 12.6667 11.3333 12.6667C11.7015 12.6667 12 12.3682 12 12C12 11.6318 11.7015 11.3333 11.3333 11.3333ZM8.66663 4C8.66663 3.82319 8.59634 3.65367 8.47131 3.52865C8.36189 3.41922 8.21838 3.35172 8.06571 3.33659L7.99996 3.33333H2.66663C2.48981 3.33333 2.3203 3.40362 2.19527 3.52865C2.07025 3.65367 1.99996 3.82319 1.99996 4V11.3333H2.78251C3.05725 10.5569 3.79606 10 4.66663 10C5.53719 10 6.276 10.5569 6.55074 11.3333H8.66663V4ZM9.99996 4.66667H11.6809C11.8807 4.66696 12.0778 4.71212 12.2578 4.79883C12.4375 4.88545 12.5954 5.01155 12.72 5.16732L15.0397 8.06706L15.1067 8.1582C15.2533 8.37659 15.3328 8.63438 15.3333 8.89909V11.3333C15.3333 11.687 15.1927 12.026 14.9427 12.276C14.6926 12.5261 14.3536 12.6667 14 12.6667H13.2174C12.9427 13.4431 12.2039 14 11.3333 14C10.4627 14 9.72392 13.4431 9.44918 12.6667H6.55074C6.276 13.4431 5.53719 14 4.66663 14C3.79606 14 3.05725 13.4431 2.78251 12.6667H1.99996C1.64634 12.6667 1.3073 12.5261 1.05725 12.276C0.807202 12.026 0.666626 11.687 0.666626 11.3333V4C0.666626 3.46957 0.877491 2.96101 1.25256 2.58594C1.62764 2.21086 2.13619 2 2.66663 2H7.99996C8.53039 2 9.03895 2.21086 9.41402 2.58594C9.78909 2.96101 9.99996 3.46957 9.99996 4V4.66667Z" fill="#5A9757"/></svg> Free Shipping';
        msgEl.style.display = 'block';
      } 
      else if(count >= 4) {
        textEl.innerText = `15% Unlocked! Add ${6 - count} More For 20%`;
        msgEl.innerText = "15% Discount Applied";
        msgEl.style.display = 'block';
      } 
      else if(count >= 3) {
        textEl.innerText = "10% Unlocked! Add 1 More For 15%";
        msgEl.innerText = "10% Discount Applied";
        msgEl.style.display = 'block';
      } 
      else if(count > 0) {
        textEl.innerText = `Add ${3 - count} More to Unlock 10% Off`;
        msgEl.style.display = 'none';
      } 
      else {
        textEl.innerText = "Add 3 Items To Unlock 10% Savings";
        msgEl.style.display = 'none';
      }
    }
  
    // --- EVENTS ---
    
    // Toggle Mobile Drawer
    mobileToggleBar.addEventListener('click', function(e) {
      if(e.target === mbCheckoutBtn) return;
      mobileWrapper.classList.toggle('open');
    });
  
    // Global Remove
    window.removeItem = function(id) {
      bundleItems = bundleItems.filter(i => i.id !== id);
      updateUI();
    }
  
    // Add Buttons
    document.querySelectorAll('.js-add').forEach(btn => {
      btn.addEventListener('click', function() {
        bundleItems.push({
          id: parseInt(this.dataset.id),
          title: this.dataset.title,
          price: parseInt(this.dataset.price),
          image: this.dataset.image
        });
        updateUI();
        if(window.innerWidth < 991 && !mobileWrapper.classList.contains('open')) {
           mobileWrapper.classList.add('open');
        }
      });
    });
  
    // Remove Buttons
    document.querySelectorAll('.js-remove').forEach(btn => {
      btn.addEventListener('click', function() {
        window.removeItem(parseInt(this.dataset.id));
      });
    });
  
    // Tabs
    const tabs = document.querySelectorAll('.bundle-tab');
    const groups = document.querySelectorAll('.bundle-product-group');
    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        const targetId = this.dataset.target;
        groups.forEach(g => {
          if(g.id === targetId) g.classList.add('active');
          else g.classList.remove('active');
        });
      });
    });
  
    // Checkout Action
    function handleCheckout() {
      const btn = this;
      const items = bundleItems.map(i => ({ id: i.id, quantity: 1 }));
      fetch(window.Shopify.routes.root + 'cart/clear.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      }) 
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(() => window.location.href = '/checkout')
      .catch(e => { console.error(e); btn.innerText = 'Error'; });
    }
  
    checkoutBtn.addEventListener('click', handleCheckout);
    mbCheckoutBtn.addEventListener('click', handleCheckout);
  
    // Initialize
    updateUI();
  });
</script>

