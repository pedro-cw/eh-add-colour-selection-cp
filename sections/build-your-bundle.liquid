{% liquid
  assign st = section.settings
  assign cols = section.blocks
%}

<div class="bundle-section-wrapper" id="bundle-builder-{{ section.id }}">
  <div class="bundle-sectoin-container">

    <header class="bundle-header">
      {% if st.collection-title != blank %}
        <h2 class="bundle-title">{{ st.collection-title }}</h2>
      {% endif %}
      {% if st.subtitle != blank %}
        <p class="bundle-subtitle">{{ st.subtitle }}</p>
      {% endif %}
    </header>

    <div class="bundle-tabs-wrapper">
      <div class="bundle-tabs-scroll">
        {% for ct in cols %}
          {% assign title = ct.settings.filter-title %}
          <button class="bundle-tab {% if forloop.first %}active{% endif %}" data-target="group-{{ forloop.index0 }}">
            {{ title }}
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="bundle-main-layout">

      <div class="bundle-products-area">
        {% for ct in cols %}
          {% assign colitem = ct.settings.pdp_list %}

          <div id="group-{{ forloop.index0 }}" class="bundle-product-group {% if forloop.first %}active{% endif %}">
            <div class="bundle-grid">
              {% liquid
                # Base identifiers
                assign kit_handle = "24k-gold-plated-ear-seed-kit"
                assign ring_handle = "gold-acupressure-ring"
                assign tweezers_handle = "gold-acu-seeds-tweezers"

                # Create empty buckets for our 5 groups
                assign group_1_kit_gs = ""
                assign group_2_middle = ""
                assign group_3_ring = ""
                assign group_4_kit_others = ""
                assign group_5_tweezers = ""
              %}

              {% for product in colitem %}
                {% for variant in product.variants %}

                  {% comment %} --- 1. AVAILABILITY CHECK --- {% endcomment %}
                  {% unless variant.available %}
                    {% continue %}{% endunless %}

                  {% assign components_available = true %}
                  {% if product.metafields.custom.includes %}
                    {% for component in product.metafields.custom.includes.value %}
                      {% unless component.available %}
                        {% assign components_available = false %}
                        {% break %}
                      {% endunless %}
                    {% endfor %}
                  {% endif %}
                  {% unless components_available %}
                    {% continue %}{% endunless %}

                  {% comment %} --- 2. GENERATE CARD HTML ONCE --- {% endcomment %}
                  {% capture card_html %}
                    {% liquid
                      include 'logic-bundle-images'
                      
                      # Consolidated title logic to match your original rules
                      assign display_title = product.title
                      unless variant.title contains 'Default' or product.handle == ring_handle or product.handle == tweezers_handle
                        assign display_title = display_title | append: ' - ' | append: variant.title
                      endunless
                    %}
                    <div class="product-card" data-id="{{ variant.id }}">
                      <a href="{{product.url}}" class="card-link-overlay"></a>
                      <div class="card-image-wrapper">
                        <img src="{{ main_image }}" alt="{{ display_title }}" class="img-main" loading="lazy">
                        <img src="{{ hover_image }}" alt="{{ display_title }}" class="img-hover" loading="lazy">
                      </div>
                      <div class="card-info">
                        <h3 class="card-title">{{ display_title }}</h3>
                        <p class="card-description">{{ product.metafields.custom.collection_description }}</p>
                      </div>
                      <p class="card-price">{{ variant.price | money }}</p>
                      <div class="card-actions">
                        <button type="button" class="btn-add js-add" data-id="{{ variant.id }}" data-title="{{ display_title }}" data-price="{{ variant.price }}" data-image="{{ main_image }}">
                          +Add
                        </button>
                        <button type="button" class="btn-added js-remove" data-id="{{ variant.id }}" style="display:none;">
                          Added
                        </button>
                      </div>
                    </div>
                  {% endcapture %}

                  {% comment %} --- 3. SORT INTO BUCKETS --- {% endcomment %}
                  {% liquid
                    if product.handle == kit_handle
                      if variant.title == 'GOLD' or variant.title == 'SILVER'
                        assign group_1_kit_gs = group_1_kit_gs | append: card_html
                      else
                        assign group_4_kit_others = group_4_kit_others | append: card_html
                      endif
                    elsif product.handle == ring_handle
                      assign group_3_ring = group_3_ring | append: card_html
                    elsif product.handle == tweezers_handle
                      assign group_5_tweezers = group_5_tweezers | append: card_html
                    else
                      assign group_2_middle = group_2_middle | append: card_html
                    endif
                  %}

                {% endfor %}
            {% endfor %}

              {% comment %} --- 4. RENDER IN THE EXACT ORDER --- {% endcomment %}
              {{ group_1_kit_gs }}
              {{ group_2_middle }}
              {{ group_3_ring }}
              {{ group_4_kit_others }}
              {{ group_5_tweezers }}
            </div>
          </div>
        {% endfor %}
      </div>

