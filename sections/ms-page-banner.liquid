<div class="ms__inner-page-banner">
  <div class="page-width">
    <div class="ms__inner-page-banner-grid">
      <div class="ms__inner-page-banner-column">
        {% if section.settings.title %}
          <{{ section.settings.htags }} class="ms__inner-page-banner-heading ms__mobile">{{ section.settings.title }}</{{ section.settings.htags }}>
        {% endif %}
        {% if section.settings.image != blank %}
          <img
            class="ms__inner-page-banner-image"
            src="{{ section.settings.image | img_url: 'master' }}"
            alt="{{ section.settings.image.alt }}" />
        {% else %}
          <div class="ms__inner-page-banner-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      <div class="ms__inner-page-banner-column">
        {% if section.settings.title %}
          <{{ section.settings.htags }} class="ms__inner-page-banner-heading ms__desktop">{{ section.settings.title }}</{{ section.settings.htags }}>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="ms__inner-page-banner-contents-rte">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }} {
    padding: 46px 0;
    background-image: url('{{ section.settings.bgimage | img_url: 'master' }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .ms__inner-page-banner-heading {
    font-size: {{ section.settings.mhsize | append: 'px' }};
    line-height: 1.2;
    color: {{ section.settings.hcolor }};
  }

  #shopify-section-{{ section.id }} .ms__inner-page-banner-grid {
    display: grid;
    grid-template-columns: 100%;
    position: relative;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .ms__inner-page-banner-placeholder {
    background-color: #f3f3f3;
  }

  #shopify-section-{{ section.id }} .ms__inner-page-banner-placeholder svg, #shopify-section-{{ section.id }} .ms__inner-page-banner-image {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .ms__inner-page-banner-contents-rte {
    padding: 32px 25px;
    background-image: url('{{ section.settings.contentbg | img_url: 'master' }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    color: {{ section.settings.ccolor }};
    font-size: {{ section.settings.mcsize | append: 'px' }};
  }

  #shopify-section-{{ section.id }} .ms__desktop {
    display: none;
  }

  #shopify-section-{{ section.id }} .ms__mobile {
    display: block;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .ms__inner-page-banner-heading {
      font-size: {{ section.settings.dhsize | append: 'px' }};
    }

    #shopify-section-{{ section.id }} .ms__inner-page-banner-grid {
      grid-template-columns: 65% 33%;
    }

    #shopify-section-{{ section.id }} .ms__inner-page-banner-contents-rte {
      font-size{{ section.settings.dcsize | append: 'px' }};
      position: absolute;
      right: 0;
      max-width: 75vw;
    }

    #shopify-section-{{ section.id }} .ms__desktop {
      display: block;
    }

    #shopify-section-{{ section.id }} .ms__mobile {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .ms__inner-page-banner-heading {
      text-align: right;
    }
    #shopify-section-{{ section.id }} .ms__inner-page-banner-contents-rte {
      max-width: 514px;
      padding: 63px 50px;
      top: unset;
    }



  }
</style>
{% schema %}
  {
    "name": "MS Page banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Title"
      },
      {
          "type": "select",
          "id": "htags",
          "label": "Heading Tag",
          "default": "h2",
          "options": [
              {
                  "value": "h1",
                  "label": "H1"
              },
              {
                  "value": "h2",
                  "label": "H2"
              },
              {
                  "value": "h3",
                  "label": "H3"
              },
              {
                  "value": "h4",
                  "label": "H4"
              },
              {
                  "value": "h5",
                  "label": "H5"
              },
              {
                  "value": "h6",
                  "label": "H6"
              }
          ]
      },
      {
        "type": "number",
        "id": "dhsize",
        "label": "Heading size (desktop)",
        "default": 64,
        "info": "Unit in px"
      },
      {
        "type": "number",
        "id": "mhsize",
        "label": "Heading size (mobile)",
        "default": 32,
        "info": "Unit in px"
      }, 
      {
        "type": "richtext",
        "id": "content",
        "label": "Content",
        "default": "<p>This are changeable content, please update this with the content you need.</p>"
      }, 
      {
        "type": "number",
        "id": "dcsize",
        "label": "Content size (desktop)",
        "default": 16,
        "info": "Unit in px"
      }, 
      {
        "type": "number",
        "id": "mcsize",
        "label": "Content size (mobile)",
        "default": 16,
        "info": "Unit in px"
      }, 
      {
        "type": "header",
        "content": "Styles"
      }, 
      {
        "type": "color",
        "id": "hcolor",
        "label": "Heading",
        "default": "#695450"
      }, 
      {
        "type": "color",
        "id": "ccolor",
        "label": "Content",
        "default": "#695450"
      }, 
      {
        "type": "image_picker",
        "id": "bgimage",
        "label": "Background"
      }, 
      {
        "type": "image_picker",
        "id": "contentbg",
        "label": "Content"
      }
    ],
    "presets": [
      {
        "name": "MS Page banner"
      }
    ]
  }
{% endschema %}