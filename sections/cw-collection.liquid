{% liquid
  assign st = section.settings
  assign bundle_collection = st.collection
  assign products_limit = st.products_limit
%}

<!-- Swiper.js Dependencies -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<section class="cw-collection-grid" data-cw-section-id="{{ section.id }}">
  <div class="cw-collection-grid__inner">
    {% if st.title != blank %}
      <h1 class="cw-collection-grid__title">{{ st.title }}</h1>
    {% endif %}

    {% if st.text != blank %}
      <div class="cw-collection-grid__text">
        {{ st.text }}
      </div>
    {% endif %}

    {% if bundle_collection != blank and bundle_collection.products_count > 0 %}
      {% render 'cw-product-card-styles' %}
      <div class="cw-collection-grid__items">
        {% for product in bundle_collection.products limit: products_limit %}
          {% liquid
            assign current_variant = product.selected_or_first_available_variant
            assign current_price = current_variant.price
            assign compare_price = current_variant.compare_at_price
            assign product_title_downcase = product.title | downcase
            assign is_womens_kit = false
            assign forced_description = blank

            if product_title_downcase contains 'women'
              assign is_womens_kit = true
              assign forced_description = 'For life after 40, menstrual discomfort and more'
            elsif product_title_downcase contains 'calm'
              assign forced_description = 'For busy minds and overwhelm'
            elsif product_title_downcase contains 'tension'
              assign forced_description = 'For everyday tension and physical discomfort'
            elsif product_title_downcase contains 'sleep'
              assign forced_description = 'For restful sleep'
            endif
          %}

          {%- capture card_description -%}
            {% if forced_description != blank %}
              {{ forced_description }}
            {% elsif product.metafields.custom.bundle_card_description != blank %}
              {{ product.metafields.custom.bundle_card_description | metafield_tag }}
            {% elsif product.metafields.custom.card_description != blank %}
              {{ product.metafields.custom.card_description | metafield_tag }}
            {% elsif product.metafields.custom.short_description != blank %}
              {{ product.metafields.custom.short_description | metafield_tag }}
            {% elsif product.description != blank %}
              {{ product.description | strip_html | truncate: 88 }}
            {% endif %}
          {%- endcapture -%}

          {% render 'cw-product-card',
            product: product,
            description: card_description | strip,
            style_label_text: st.style_label_text,
            add_to_cart_label: st.add_to_cart_label,
            view_label: st.view_label
          %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cw-collection-grid__empty">Select a collection with products.</div>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .cw-collection-grid {
    background: {{ st.background_color }};
    padding: 37px 0 62px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cw-collection-grid__inner {
    width: min(100% - 36px, 1170px);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .cw-collection-grid__title {
    margin: 0;
    color: {{ st.title_color }};
    font-family: Botanica, serif;
    font-size: 50px;
    font-weight: 400;
    line-height: 55px;
    letter-spacing: 1px;
  }

  #shopify-section-{{ section.id }} .cw-collection-grid__text {
    max-width: 801px;
    margin-top: 28px;
    color: {{ st.text_color }};
    font-family: Montserrat, sans-serif;
    font-size: 23px;
    font-weight: 400;
    line-height: 25.3px;
    letter-spacing: 0.46px;
  }

  #shopify-section-{{ section.id }} .cw-collection-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 46px;
    margin-top: 59px;
  }

  #shopify-section-{{ section.id }} .cw-collection-grid__empty {
    margin-top: 59px;
    color: {{ st.title_color }};
    font-family: Montserrat, sans-serif;
    font-size: 16px;
  }

  .btn-primary{font-size: 14px !important;}

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .cw-collection-grid__inner {
      width: min(100% - 36px, 762px);
    }

    #shopify-section-{{ section.id }} .cw-collection-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cw-collection-grid {
      padding: 26px 0 38px;
    }

    #shopify-section-{{ section.id }} .cw-collection-grid__inner {
      width: min(100% - 36px, 354px);
    }

    #shopify-section-{{ section.id }} .cw-collection-grid__title {
      font-size: 32px;
      line-height: 35.2px;
      letter-spacing: 0.64px;
    }

    #shopify-section-{{ section.id }} .cw-collection-grid__text {
      max-width: 339px;
      margin-top: 20px;
      font-size: 14px;
      line-height: 15.4px;
      letter-spacing: 0.28px;
    }

    #shopify-section-{{ section.id }} .cw-collection-grid__items {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 20px;
      margin-top: 20px;
    }
  }

  @media screen and (max-width: 374px) {
    #shopify-section-{{ section.id }} .cw-collection-grid__inner {
      width: calc(100% - 32px);
    }
  }
</style>

{% render 'cw-product-card-scripts', section_id: section.id %}

{% schema %}
{
  "name": "CW Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Bundle and Save"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover thoughtfully curated wellness bundles built around your goals—while saving more than purchasing items individually."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "Rated 4.9/5"
    },
    {
      "type": "text",
      "id": "style_label_text",
      "label": "Variant selector label",
      "default": "choose your style"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add To Cart"
    },
    {
      "type": "text",
      "id": "view_label",
      "label": "View label",
      "default": "View"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F2EEEA"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title and card text",
      "default": "#695450"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Intro text",
      "default": "#937F5C"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border and accent",
      "default": "#977E57"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#695450"
    }
  ],
  "presets": [
    {
      "name": "CW Collection Grid"
    }
  ]
}
{% endschema %}