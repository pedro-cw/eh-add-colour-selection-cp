        {% if section.settings.title != blank %}
        <{{ section.settings.htags }} class="cc__instafeed-heading">{{ section.settings.title }}</{{ section.settings.htags }}>
        {% endif %}
        <div class="cc__instafeedsocial">
            <div class="cc__instafeedsociallinks">
                {% if settings.social_instagram_link != blank %}
