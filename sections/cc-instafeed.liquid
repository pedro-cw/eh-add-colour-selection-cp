                    </svg>
                </a>
                {% endif %}
            </div>
            {% if section.settings.insta_handle != blank %}
            <a class="cc__instagramhandle" href="https://www.instagram.com/{{ section.settings.insta_handle | remove: '@' | escape }}" target="_blank">{{ section.settings.insta_handle }}</a>
            {% endif %}
        </div>
    </div>
    <div id="insta-feed"></div>
</div>
<style>
     #shopify-section-{{ section.id }}{
        background-color: {{ section.settings.bgcolor }};
        padding-top: {{ section.settings.mpadtop | append: 'px'}};
        padding-bottom: {{ section.settings.mpadbot | append: 'px'}};
        overflow: hidden;
    }

    #shopify-section-{{ section.id }} .cc__instafeedsociallinks{
        display: flex;
        align-items: center;
        gap: 24px;
    }

    #shopify-section-{{ section.id }} .cc__instagramhandle{
        font-size: 14px;
        font-weight: bold;
        text-transform: UPPERCASE;
        color: {{ section.settings.tcolor }};
        text-decoration: none;
    }

    #shopify-section-{{ section.id }} .cc__instafeed-header{
        margin-bottom: 30px;
    }

    #shopify-section-{{ section.id }} .cc__instafeed-heading{
        margin: 0;
        margin-bottom: 16px;
         font-size: {{ section.settings.mhsize | append: 'px' }};
         color: {{ section.settings.tcolor }};
     }

    @media screen and (min-width: 750px){
        #shopify-section-{{ section.id }}{
            padding-top: {{ section.settings.dpadtop | append: 'px' }};
            padding-bottom: {{ section.settings.dpadbot | append: 'px' }};
        }

        #shopify-section-{{ section.id }} .cc__instafeed-heading{
            font-size: {{ section.settings.dhsize | append: 'px' }};
            margin: 0;
        }

        #shopify-section-{{ section.id }} .cc__instafeed-header {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            justify-content: space-between;
        }

        #shopify-section-{{ section.id }} .cc__instafeedsocial {
            margin-bottom: 19px;
            text-align: right;
        }

    }
</style>
{% schema %}
    {
        "name" : "MS Instafeed",
        "settings": [
            {
                "type" : "text",
                "id" : "title",
                "label" : "Title",
                "default": "Follow us on Social Media"
            },
            {
                "type": "select",
                "id": "htags",
                "label": "Heading Tag",
                "default": "h2",
                "options": [
                    {
                        "value": "h1",
                        "label": "H1"
                    },
                    {
                        "value": "h2",
                        "label": "H2"
                    },
                    {
                        "value": "h3",
                        "label": "H3"
                    },
                    {
                        "value": "h4",
                        "label": "H4"
                    },
                    {
                        "value": "h5",
                        "label": "H5"
                    },
                    {
                        "value": "h6",
                        "label": "H6"
                    }
                ]
            },
            {
                "type": "text",
                "id": "insta_handle",
                "label": "Handle",
                "default": "@instahandle"
            },
            {
                "type" : "header",
                "content" : "Styles"
            },
            {
                "type" : "color",
                "id" : "tcolor",
                "label": "Text color",
                "default": "#695450"
            },
            {
                "type" : "color",
                "id" : "bgcolor",
                "label": "Background color",
                "default": "#F7F8F4"
            },
            {
                "type" : "number",
                "id" : "dhsize",
                "label" : "Heading size (desktop)",
                "default": 96,
                "info" : "Unit in px"
            },
            {
                "type" : "number",
                "id" : "mhsize",
                "label" : "Heading size (desktop)",
                "default": 45,
                "info" : "Unit in px"
            },
            {
                "type" : "number",
                "id" : "dpadtop",
                "label" : "Padding top(desktop)",
                "default": 70,
                "info" : "Unit in px"
            },
            {
                "type" : "number",
                "id" : "dpadbot",
                "label" : "Padding bottom(desktop)",
                "default": 70,
                "info" : "Unit in px"
            },
            {
                "type" : "number",
                "id" : "mpadtop",
                "label" : "Padding top(mobile)",
                "default": 35,
                "info" : "Unit in px"
            },
            {
                "type" : "number",
                "id" : "mpadbot",
                "label" : "Padding bottom(mobile)",
                "default": 35,
                "info" : "Unit in px"
            }
        ],
        "presets": [
            {
                "name" : "MS Instafeed"
            }
        ]
    }
{% endschema %}