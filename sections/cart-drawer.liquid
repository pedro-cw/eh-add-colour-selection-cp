  <script>
    (function () {
      if (window.__CW_CART_QTY_V1__) return;
      window.__CW_CART_QTY_V1__ = true;

      function qs(sel, root) { return (root || document).querySelector(sel); }
      function qsa(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

      function openCartDrawer() {
    document.dispatchEvent(new Event("cart:refresh"));
    document.dispatchEvent(new Event("cart:updated"));
    document.dispatchEvent(new Event("monk:cart:open"));

    var drawer = qs("cart-drawer") || qs("#CartDrawer") || qs(".cart-drawer");
    if (drawer && typeof drawer.open === "function") {
      drawer.open();
      return;
    }
    var el = qs("#CartDrawer");
    if (!el) return;
    el.classList.add("active", "is-open");
    el.setAttribute("open", "true");
    document.documentElement.classList.add("overflow-hidden");
    document.body.classList.add("overflow-hidden");
      }

      function fetchSections(ids) {
    var url = window.location.pathname + "?sections=" + encodeURIComponent(ids.join(","));
    return fetch(url, { credentials: "same-origin" }).then(function (r) { return r.json(); });
      }

      function innerFrom(html, selector) {
    var doc = new DOMParser().parseFromString(html, "text/html");
    var node = doc.querySelector(selector);
    return node ? node.innerHTML : null;
      }

      function replaceInner(sectionHTML, selector, mountSelector) {
    var mount = qs(mountSelector || selector);
    if (!mount) return;
    var fresh = innerFrom(sectionHTML, selector);
    if (fresh == null) return;
    mount.innerHTML = fresh;
      }

      function refreshCartUI() {
    return fetchSections(["cart-drawer", "header"]).then(function (data) {
      if (data && data["cart-drawer"]) replaceInner(data["cart-drawer"], "#CartDrawer", "#CartDrawer");
      if (data && data["header"]) replaceInner(data["header"], ".site-header__cart", ".site-header__cart");
    });
      }

      function changeLineQuantity(line, quantity) {
    return fetch("/cart/change.js", {
      method: "POST",
      headers: { "Accept": "application/json", "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ line: Number(line), quantity: Number(quantity) })
    }).then(function (r) {
      if (!r.ok) throw new Error("change failed");
      return r.json();
    });
      }

      function extractVariantId(btn) {
    if (!btn) return null;
    if (btn.dataset && btn.dataset.variantId) return btn.dataset.variantId;
    var attr = btn.getAttribute && btn.getAttribute("data-variant-id");
    if (attr) return attr;

    var form = btn.closest && btn.closest("form");
    if (form) {
      var idInput = form.querySelector && form.querySelector('[name="id"]');
      if (idInput && idInput.value) return idInput.value;
    }

    var wrap = btn.closest && btn.closest("[data-variant-id]");
    if (wrap) return wrap.getAttribute("data-variant-id");

    return null;
      }

      function addToCart(variantId) {
    return fetch("/cart/add.js", {
      method: "POST",
      headers: { "Accept": "application/json", "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ id: Number(variantId), quantity: 1 })
    }).then(function (r) {
      if (!r.ok) throw new Error("add failed");
      return r.json();
    });
      }

      function ensureQtyUI(root) {
    var scope = root || document;
    var items = qsa(".cart-drawer__item[data-cart-item]", scope);
    if (!items.length) return;

    items.forEach(function (item) {
      var input = qs('input[type="number"].cart-drawer__item-quantity', item);
      if (!input) return;

      var line = item.getAttribute("data-cart-item-line-number");
      if (!line) return;

      var existing = qs('.custom-qty[data-line="' + line + '"]', item);
      var start = parseInt(input.value, 10);
      if (!start || start < 1) start = parseInt(input.getAttribute("value"), 10) || 1;

      if (existing) {
        var v = qs(".custom-qty__value", existing);
        if (v) v.textContent = String(start);
        return;
      }

      var wrapper = document.createElement("div");
      wrapper.className = "custom-qty";
      wrapper.setAttribute("data-line", String(line));

      var minus = document.createElement("button");
      minus.type = "button";
      minus.setAttribute("data-qty-action", "minus");
      minus.textContent = "−";

      var value = document.createElement("span");
      value.className = "custom-qty__value";
      value.textContent = String(start);

      var plus = document.createElement("button");
      plus.type = "button";
      plus.setAttribute("data-qty-action", "plus");
      plus.textContent = "+";

      wrapper.appendChild(minus);
      wrapper.appendChild(value);
      wrapper.appendChild(plus);

      input.parentNode.appendChild(wrapper);
    });
      }

      var enhanceQueued = 0;
      function queueEnhance() {
    if (enhanceQueued) return;
    enhanceQueued = 1;
    requestAnimationFrame(function () {
      enhanceQueued = 0;
      ensureQtyUI(document);
    });
      }

      function lockForLine(line, locked) {
    var item = qs('.cart-drawer__item[data-cart-item-line-number="' + line + '"]');
    if (item) item.dataset.qtyReqLock = locked ? "1" : "0";
    var wrap = item ? qs('.custom-qty[data-line="' + line + '"]', item) : null;
    if (!wrap) return;
    qsa("button", wrap).forEach(function (b) { b.disabled = !!locked; });
      }

      function setLineUI(line, qty) {
    var item = qs('.cart-drawer__item[data-cart-item-line-number="' + line + '"]');
    if (!item) return;

    var input = qs('input[type="number"].cart-drawer__item-quantity', item);
    if (input) {
      input.value = String(qty);
      input.setAttribute("value", String(qty));
    }
    var v = qs('.custom-qty[data-line="' + line + '"] .custom-qty__value', item);
    if (v) v.textContent = String(qty);
      }

      document.addEventListener("click", function (e) {
    var qtyBtn = e.target.closest && e.target.closest(".custom-qty button[data-qty-action]");
    if (qtyBtn) {
      e.preventDefault();
      e.stopPropagation();

      var wrap = qtyBtn.closest(".custom-qty");
      var line = wrap && wrap.getAttribute("data-line");
      if (!line) return;

      var item = qtyBtn.closest(".cart-drawer__item[data-cart-item]");
      if (!item) return;
      if (item.dataset.qtyReqLock === "1") return;

      var valueEl = qs(".custom-qty__value", wrap);
      var current = parseInt(valueEl ? valueEl.textContent : "0", 10);
      if (!current || current < 1) {
        var input = qs('input[type="number"].cart-drawer__item-quantity', item);
        current = parseInt(input && input.value, 10) || 1;
      }

      var action = qtyBtn.getAttribute("data-qty-action");
      var next = action === "plus" ? current + 1 : current - 1;
      if (next < 1) next = 1;

      lockForLine(line, true);
      setLineUI(line, next);

      changeLineQuantity(line, next)
        .then(function () { return refreshCartUI(); })
        .then(function () {
          queueEnhance();
          openCartDrawer();
        })
        .catch(function () {
          return refreshCartUI().then(function () {
            queueEnhance();
            openCartDrawer();
          });
        })
        .finally(function () {
          setTimeout(function () { lockForLine(line, false); }, 150);
        });

      return;
    }

    var container = e.target.closest && e.target.closest("#mr-div-embedded-cp-any-drawer");
    if (!container) return;

    var btn = e.target.closest && e.target.closest("button, input[type='submit'], [data-add-to-cart], .add-to-cart, .btn");
    if (!btn) return;

    var variantId = extractVariantId(btn);
    if (!variantId) return;

    e.preventDefault();
    e.stopImmediatePropagation();

    addToCart(variantId)
      .then(function () { return refreshCartUI(); })
      .then(function () {
        queueEnhance();
        openCartDrawer();
      })
      .catch(function () {
        refreshCartUI().finally(function () {
          queueEnhance();
          openCartDrawer();
        });
      });
      }, true);

      function observeDrawer() {
    var drawer = qs("#CartDrawer");
    if (!drawer) return;

    var obs = new MutationObserver(function () { queueEnhance(); });
    obs.observe(drawer, { childList: true, subtree: true });
      }

      queueEnhance();
      observeDrawer();
    })();
  </script>

  <style>
    .custom-qty .custom-qty__input {
      width: 32px;
      height: 32px;
      border: 0;
      outline: 0;
      padding: 0;
      margin: 0;
      text-align: center;
      font-size: 14px;
      background: transparent;
      appearance: textfield;
      -moz-appearance: textfield;
    }
    .custom-qty .custom-qty__input::-webkit-outer-spin-button,
    .custom-qty .custom-qty__input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    .custom-qty.is-loading {
      opacity: .75;
      pointer-events: none;
    }
    .custom-qty.is-loading .custom-qty__input {
      pointer-events: none;
    }
  </style>

  <script>
    (function () {
      if (window.__CW_CART_QTY_TYPE_V1__) return;
      window.__CW_CART_QTY_TYPE_V1__ = true;

      function qs(sel, root) { return (root || document).querySelector(sel); }
      function qsa(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

      function openCartDrawer() {
    document.dispatchEvent(new Event("cart:refresh"));
    document.dispatchEvent(new Event("cart:updated"));
    document.dispatchEvent(new Event("monk:cart:open"));

    var drawer = qs("cart-drawer") || qs("#CartDrawer") || qs(".cart-drawer");
    if (drawer && typeof drawer.open === "function") {
      drawer.open();
      return;
    }
    var el = qs("#CartDrawer");
    if (!el) return;
    el.classList.add("active", "is-open");
    el.setAttribute("open", "true");
    document.documentElement.classList.add("overflow-hidden");
    document.body.classList.add("overflow-hidden");
      }

      function changeLineQuantity(line, quantity) {
    return fetch("/cart/change.js", {
      method: "POST",
      headers: { "Accept": "application/json", "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ line: Number(line), quantity: Number(quantity) })
    }).then(function (r) {
      if (!r.ok) throw new Error("change failed");
      return r.json();
    });
      }

      function setLoading(wrap, on) {
    if (!wrap) return;
    if (on) wrap.classList.add("is-loading");
    else wrap.classList.remove("is-loading");
    qsa("button", wrap).forEach(function (b) { b.disabled = !!on; });
    var inp = qs(".custom-qty__input", wrap);
    if (inp) inp.disabled = !!on;
      }

      function getLineFromWrap(wrap) {
    if (!wrap) return null;
    var line = wrap.getAttribute("data-line");
    if (line) return line;
    var item = wrap.closest(".cart-drawer__item[data-cart-item]");
    if (item) return item.getAttribute("data-cart-item-line-number");
    return null;
      }

      function normalizeQty(v) {
    var n = parseInt(String(v || "").replace(/[^\d]/g, ""), 10);
    if (!n || n < 1) n = 1;
    return n;
      }

      function syncInputFromNative(wrap) {
    var item = wrap.closest(".cart-drawer__item[data-cart-item]");
    var nativeInput = item ? qs('input[type="number"].cart-drawer__item-quantity', item) : null;
    var inp = qs(".custom-qty__input", wrap);
    if (!inp) return;

    var val = nativeInput ? nativeInput.value : "";
    if (!val) val = inp.value;
    inp.value = String(normalizeQty(val));
      }

      function commitQty(wrap, qty) {
    var line = getLineFromWrap(wrap);
    if (!line) return;

    var item = wrap.closest(".cart-drawer__item[data-cart-item]");
    if (item && item.dataset && item.dataset.qtyReqLock === "1") return;
    if (item && item.dataset) item.dataset.qtyReqLock = "1";

    var next = normalizeQty(qty);

    var itemNative = item ? qs('input[type="number"].cart-drawer__item-quantity', item) : null;
    if (itemNative) {
      itemNative.value = String(next);
      itemNative.setAttribute("value", String(next));
    }

    var inp = qs(".custom-qty__input", wrap);
    if (inp) inp.value = String(next);

    setLoading(wrap, true);

    changeLineQuantity(line, next)
      .then(function () {
        document.dispatchEvent(new Event("cart:refresh"));
        document.dispatchEvent(new Event("cart:updated"));
        openCartDrawer();
      })
      .catch(function () {
        document.dispatchEvent(new Event("cart:refresh"));
        document.dispatchEvent(new Event("cart:updated"));
        openCartDrawer();
      })
      .finally(function () {
        setTimeout(function () {
          if (item && item.dataset) item.dataset.qtyReqLock = "0";
          setLoading(wrap, false);
          syncInputFromNative(wrap);
        }, 150);
      });
      }

      function enhanceTyping(root) {
    var scope = root || document;
    var wraps = qsa(".custom-qty", scope);
    if (!wraps.length) return;

    wraps.forEach(function (wrap) {
      if (wrap.dataset && wrap.dataset.typeEnhanced === "1") {
        syncInputFromNative(wrap);
        return;
      }

      var valueEl = qs(".custom-qty__value", wrap);
      var inp = qs(".custom-qty__input", wrap);

      if (!inp) {
        inp = document.createElement("input");
        inp.type = "number";
        inp.min = "1";
        inp.inputMode = "numeric";
        inp.autocomplete = "off";
        inp.className = "custom-qty__input";
      }

      var start = valueEl ? valueEl.textContent : inp.value;
      inp.value = String(normalizeQty(start));

      if (valueEl && valueEl.parentNode) {
        valueEl.parentNode.replaceChild(inp, valueEl);
      } else {
        var plus = qs('button[data-qty-action="plus"], .custom-qty__btn--plus', wrap);
        if (plus && plus.parentNode) plus.parentNode.insertBefore(inp, plus);
        else wrap.appendChild(inp);
      }

      var t = null;

      function schedule() {
        if (t) clearTimeout(t);
        t = setTimeout(function () {
          commitQty(wrap, inp.value);
        }, 550);
      }

      inp.addEventListener("input", function () {
        schedule();
      });

      inp.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
          e.preventDefault();
          if (t) clearTimeout(t);
          commitQty(wrap, inp.value);
        }
      });

      inp.addEventListener("blur", function () {
        if (t) clearTimeout(t);
        commitQty(wrap, inp.value);
      });

      if (wrap.dataset) wrap.dataset.typeEnhanced = "1";

      syncInputFromNative(wrap);
    });
      }

      function observe() {
    var drawer = qs("#CartDrawer") || document.body;
    var obs = new MutationObserver(function () {
      enhanceTyping(drawer);
    });
    obs.observe(drawer, { childList: true, subtree: true });
      }

      enhanceTyping(document);
      observe();
    })();
  </script>

{% endif %}

