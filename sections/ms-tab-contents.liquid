        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title",
                "default": "Tab Contents"
            },
            {
                "type": "select",
                "id": "htags",
                "label": "Heading Tag",
                "default": "h2",
                "options": [
                    {
                        "value": "h1",
                        "label": "H1"
                    },
                    {
                        "value": "h2",
                        "label": "H2"
                    },
                    {
                        "value": "h3",
                        "label": "H3"
                    },
                    {
                        "value": "h4",
                        "label": "H4"
                    },
                    {
                        "value": "h5",
                        "label": "H5"
                    },
                    {
                        "value": "h6",
                        "label": "H6"
                    }
                ]
            },
            {
                "type": "number",
                "id": "dhsize",
                "label": "Heading size (desktop)",
                "default": 96,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "mhsize",
                "label": "Heading size (mobile)",
                "default": 48,
                "info": "Unit in px"
            },
            {
                "type": "header",
                "content": "Styles"
            },
            {
                "type": "color",
                "id": "bgcolor",
                "label": "Background ",
                "default": "transparent"
            }, 
            {
                "type": "color",
                "id": "textcolor",
                "label": "Text/Active Tab",
                "default": "#000"
            }, 
            {
                "type": "number",
                "id": "dpadtop",
                "label": "Padding top(desktop)",
                "default": 100,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "dpadbot",
                "label": "Padding bottom(desktop)",
                "default": 100,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "mpadtop",
                "label": "Padding top(mobile)",
                "default": 50,
                "info": "Unit in px"
            }, 
            {
                "type": "number",
                "id": "mpadbot",
                "label": "Padding bottom(mobile)",
                "default": 50,
                "info": "Unit in px"
            }
        ],
        "blocks": [
            {
                "type": "tabitems",
                "name": "Tab items",
                "settings": [
                    {
                        "type": "text",
                        "id": "tabtitle",
                        "label": "Title",
                        "default": "Tab title"
                    },
                    {
                        "type": "richtext",
                        "id": "tabcontent",
                        "label": "Contents",
                        "default": "<p>Please update this contents with your content.</p>"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "MS Tab Contents",
                "blocks": [
                    {
                        "type": "tabitems"
                    },
                    {
                        "type": "tabitems"
                    },
                    {
                        "type": "tabitems"
                    }
                ]
            }
        ]
    }
{% endschema %}