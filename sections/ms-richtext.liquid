<div class="page-width ms__pagebreadcrumbs">
  <div class="ms__page-title">
    <h3>{{ section.settings.uppertitle | default: page.title }}</h3>
  </div>

</div>
{% if section.settings.section_title != blank or section.settings.text != blank %}
<div
  class="rich-text rich-text--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="rich-text">
  <div class="page-width">
    <div class="text-center">
      {% if section.settings.image != blank %}
      <img class="ms__richtext-image" src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.image.alt }}" />
      {% endif %}
      {% if section.settings.section_title != blank %}
        <{{ section.settings.htags }} class="rich-text__heading" data-animate>
          {{ section.settings.section_title | escape }}
        </{{ section.settings.htags }}>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="rich-text__body-text rte-setting">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bgcolor }};
  }

  #shopify-section-{{ section.id }} .rich-text {
    padding-top: {{ section.settings.mpadtop | append: 'px' }};
    padding-bottom: {{ section.settings.mpadbot | append: 'px' }};
  }

  {% if section.settings.hide_pagebreadcrumbs %}
  #shopify-section-{{ section.id }} .ms__pagebreadcrumbs{
    display: none;
  }
    {% endif %}

  #shopify-section-{{ section.id }} .ms__pagebreadcrumbs{
    padding-bottom: {{ section.settings.mspacebot | append: 'px' }};
  }

  #shopify-section-{{ section.id }} .rich-text__heading {
    font-size: {{ section.settings.mhsize | append: 'px' }};
    color: {{ section.settings.textcolor }};
    max-width: {{ section.settings.heading_width | append: 'px' }};
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .rich-text__heading:before {
    display: none;
  }

  #shopify-section-{{ section.id }} .rich-text__body-text {
    font-size: {{ section.settings.mcsize | append: 'px' }};
    color: {{ section.settings.textcolor }};
    max-width: {{ section.settings.contents_width | append: 'px' }};
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ section.id }} .ms__page-title {
    padding: 10px 0;
    border-bottom: 1px solid rgba({{ section.settings.upperborder.red }}, {{ section.settings.upperborder.green }}, {{ section.settings.upperborder.blue }}, {{ section.settings.upperborderopacity | times: 0.01  }});
    text-transform: UPPERCASE;
  }

  #shopify-section-{{ section.id }} .ms__page-title h3 {
    font-size: 10px;
    font-weight: bold;
    color: {{ section.settings.uppertitlecolor }};
    letter-spacing: 2px;
    margin: 0;
    font-family: var(--font-stack-body);
    text-transform: UPPERCASE;
  }

  #shopify-section-{{ section.id }} .ms__richtext-image{
    display: block;
    width: 200px;
    height: 200px;
    object-fit: contain;
    margin: 0 auto 30px;
  }

  @media screen and (min-width: 750px) {

    #shopify-section-{{ section.id }} .rich-text {
      padding-top: {{ section.settings.dpadtop | append: 'px' }};
      padding-bottom: {{ section.settings.dpadbot | append: 'px' }};
    }

    #shopify-section-{{ section.id }} .rich-text__heading {
      font-size: {{ section.settings.dhsize | append: 'px' }};
    }

    #shopify-section-{{ section.id }} .rich-text__body-text {
      font-size: {{ section.settings.dcsize | append: 'px' }};
    }

    #shopify-section-{{ section.id }} .ms__pagebreadcrumbs{
      padding-bottom: {{ section.settings.dspacebot | append: 'px' }};
    }
  }
</style>

